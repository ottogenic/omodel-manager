def _label(labels_str, key):
    # docker ps Labels field is "k1=v1,k2=v2"
    for part in (labels_str or "").split(","):
        if part.startswith(key + "="):
            return part[len(key) + 1:]
    return None


def _fmt_tokens(n):
    """262144 -> '256K', 1048576 -> '1M'."""
    try:
        n = int(n)
    except (TypeError, ValueError):
        return "?"
    if n % (1024 * 1024) == 0:
        return f"{n // (1024 * 1024)}M"
    if n % 1024 == 0:
        return f"{n // 1024}K"
    return str(n)


def _fmt_tokps(v):
    """Recorded decode speed (single user @ ~100k context) for the `list` table.
    A profile's `tok_s` is filled in from the benchmark (see the add-a-model skill);
    unmeasured profiles show '—'."""
    try:
        return str(int(round(float(v))))
    except (TypeError, ValueError):
        return "—"


def cmd_models(args):
    kind = getattr(args, "kind", None)
    models = profile_inventory(kind)
    if not models:
        print(f"No {kind + ' ' if kind else ''}model profiles defined.")
        return
    rows = []
    for key, entry in models.items():
        selected = entry["variants"].get(kind) if kind else entry["variants"][entry["kinds"][0]]
        rows.append((key, ",".join(entry["kinds"]), selected.get("served_model", "?"),
                     _fmt_tokens(selected.get("context")), str(selected.get("users", 1)),
                     _fmt_tokps(selected.get("tok_s")), selected.get("status", "?")))
    headers = ("PROFILE", "KINDS", "MODEL", "CONTEXT", "USERS", "Tk/s", "STATUS")
    w = [max(len(str(c)) for c in col) for col in zip(headers, *rows)]
    print(f"{kind.title() + ' ' if kind else ''}model profiles:\n")
    print("  " + "  ".join(h.ljust(w[i]) for i, h in enumerate(headers)))
    print("  " + "  ".join("-" * w[i] for i in range(len(headers))))
    for r in rows:
        print("  " + "  ".join(str(r[i]).ljust(w[i]) for i in range(len(headers))))
    compatible = [device for device in device_inventory(kind).values()
                  if any(device["kind"] in row["kinds"] for row in models.values())]
    if compatible:
        device = compatible[0]
        sample = next(key for key, row in models.items() if device["kind"] in row["kinds"])
        _suggest([("Plan a deployment", f"{_cli_name()} plan {device['name']} {sample}"),
                  ("Launch it", f"{_cli_name()} launch {device['name']} {sample}")])


