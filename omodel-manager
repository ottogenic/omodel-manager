        assert weight.shape[0] == groups * rank
        weight_fp = weight.to(torch.bfloat16) * _expand_block_scales(
            weight_scale, weight.shape
        ).to(torch.bfloat16)
        weight_bmm = weight_fp.view(groups, rank, weight.shape[1]).transpose(1, 2)
        weight_bmm = weight_bmm.contiguous()
        wo_a._sm12x_weight_bmm = weight_bmm
    o_fp = o_fp8.to(torch.bfloat16) * _expand_block_scales(o_scale, o_fp8.shape).to(
        torch.bfloat16
    )
    result = torch.bmm(o_fp.permute(1, 0, 2), weight_bmm).permute(1, 0, 2)
    out.copy_(result)


'''
