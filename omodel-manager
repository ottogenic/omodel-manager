        target = (", ".join(str(value) for value in device.get("members", [])
                            if value is not None) if device["kind"] == "cluster"
                  else device.get("target") or "local")
        rows.append((name, device["kind"], target))
    headers = ("DEVICE", "KIND", "TARGET/MEMBERS")
    widths = [max(len(str(cell)) for cell in column) for column in zip(headers, *rows)]
    print(f"{kind.title() + ' ' if kind else ''}devices:\n")
    print("  " + "  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)))
    print("  " + "  ".join("-" * widths[i] for i in range(len(headers))))
    for row in rows:
        print("  " + "  ".join(str(row[i]).ljust(widths[i]) for i in range(len(headers))))
    if getattr(args, "suggest", True):
        sample = rows[0][0]
        _suggest([("See compatible models", f"{_cli_name()} launch {sample}"),
                  ("List all model profiles", f"{_cli_name()} models")])


def _compatible_profiles(device):
    return profile_inventory(device["kind"])


def _device_member_targets(device):
    targets = device.get("member_targets")
    if targets is not None:
        return targets
    members = device.get("members")
    if members is None:
        members = [device.get("head"), device.get("worker")]
    return [None if value in (None, "local", "localhost") else resolve_host(value)
            for value in members]


def _current_deployment(device):
    """Infer current state from the addressed runtime, never caller-local intent."""
    if device["kind"] == "cluster":
        target = (_device_member_targets(device) or [None])[0]
        cluster_name = device.get("target") or device["name"]
        rows = list_managed(remote=target, include_stopped=True)
        matches = [] if rows is None else [row for row in rows
                   if (_label(row.get("Labels", ""), LABEL_CLUSTER) or "").casefold()
                   == str(cluster_name).casefold()]
    elif device["kind"] == "card":
        target = device.get("target")
        rows = list_managed(remote=target)
        matches = [] if rows is None else [row for row in rows
                   if (_label(row.get("Labels", ""), LABEL_DEVICE) or "").casefold() == "b70"]
    else:
        target = device.get("target")
        rows = list_managed(remote=target, include_stopped=True)
        matches = [] if rows is None else rows
    for row in matches:
        profile = _label(row.get("Labels", ""), LABEL_MODEL)
        if profile:
            return {"device": device["name"], "kind": device["kind"], "profile": profile}
    if device["kind"] == "node":
        pulling = _pulling_keys(target)
        if len(pulling) == 1:
            return {"device": device["name"], "kind": device["kind"], "profile": pulling[0]}
    return None


def _require_current_deployment(device):
    deployment = _current_deployment(device)
    if not deployment:
        print(f"ERROR: no current deployment is known for device '{device['name']}'. "
              f"Run `{_cli_name()} ps` to inspect runtime state or "
              f"`{_cli_name()} launch {device['name']}` to choose a model.", file=sys.stderr)
        sys.exit(1)
    return deployment


def _ensure_device_available(device):
    targets = ([device.get("target")] if device["kind"] in ("card", "node")
               else _device_member_targets(device))
    for target in targets:
        rows = list_managed(remote=target, include_stopped=device["kind"] != "card")
        if rows is None:
            print(f"ERROR: cannot verify that device '{device['name']}' is available.",
                  file=sys.stderr)
            sys.exit(1)
        pulling = _pulling_keys(target)
        if rows or pulling:
            occupied = [_label(row.get("Labels", ""), LABEL_MODEL) or row.get("Names", "?")
                        for row in rows] + pulling
            print(f"ERROR: device '{device['name']}' is already reserved by "
                  f"{', '.join(occupied)}. Stop it with "
                  f"`{_cli_name()} stop {device['name']}` first.", file=sys.stderr)
            sys.exit(1)


def _call_internal(func, args):
    global _SUPPRESS_INTERNAL_SUGGESTIONS
    previous = _SUPPRESS_INTERNAL_SUGGESTIONS
    _SUPPRESS_INTERNAL_SUGGESTIONS = True
    try:
        return func(args)
    finally:
        _SUPPRESS_INTERNAL_SUGGESTIONS = previous


def _card_helper_command():
    if (os.path.abspath(CARD_HELPER) == os.path.abspath(DEFAULT_CARD_HELPER)
            or CARD_HELPER.endswith(".py")):
        return [sys.executable, CARD_HELPER]
    return [CARD_HELPER]


def _load_card_helper():
    spec = importlib.util.spec_from_file_location("otools_card_deploy", CARD_HELPER)
    helper = importlib.util.module_from_spec(spec)
    helper_dir = os.path.dirname(CARD_HELPER)
    sys.path.insert(0, helper_dir)
    try:
        spec.loader.exec_module(helper)
    finally:
        sys.path.remove(helper_dir)
    return helper


def _stage_remote_manager(target):
    """Copy the manager bundle needed to run the qualified card lifecycle remotely."""
    source_root = os.path.dirname(os.path.abspath(__file__))
    remote_root = f"{remote_home(target)}/.local/share/otools/omodel-manager"
    mkdir = run_remote(target, "mkdir -p " + shlex.quote(remote_root), batch=True)
    if mkdir.returncode != 0:
        print(f"ERROR: could not prepare manager runtime on {target}.", file=sys.stderr)
        sys.exit(mkdir.returncode)
    sources = [os.path.join(source_root, "omodel-manager"),
               os.path.join(source_root, "configs"),
               os.path.join(source_root, "utils")]
    result = subprocess.run(["scp"] + ssh_opts() + ["-r", *sources,
                            f"{target}:{remote_root}/"], text=True)
    if result.returncode != 0:
        print(f"ERROR: could not stage manager runtime on {target}.", file=sys.stderr)
        sys.exit(result.returncode)
    return f"{remote_root}/omodel-manager"


def _remote_card_manager(target):
    """Return the manager source mounted by a running remote card, if available."""
    proxy_mount = "{{range .Mounts}}{{if eq .Destination \"/proxy.py\"}}{{.Source}}{{end}}{{end}}"
    result = docker(["inspect", "--format", proxy_mount, "b70-vllm-loopback"], capture=True)
    source = (result.stdout or "").strip() if result.returncode == 0 else ""
    suffix = "/utils/card/tcp_proxy.py"
    if not source.endswith(suffix):
        return None
    script = source[:-len(suffix)] + "/omodel-manager"
    check = run_remote(target, "test -f " + shlex.quote(script), capture=True, batch=True)
    return script if check.returncode == 0 else None


def dispatch_card(action, device, profile=None, role=None, follow=False, yes=False,
                  dry_run=False):
    """Dispatch card lifecycle to the checked-in helper or an explicit override."""
    global REMOTE
    target = device.get("target")
    REMOTE = target
    helper_device = "b70"
    if target:
        if os.path.abspath(CARD_HELPER) != os.path.abspath(DEFAULT_CARD_HELPER):
            print("ERROR: remote card lifecycle requires the checked-in card helper.",
                  file=sys.stderr)
            sys.exit(1)
        remote_script = (_remote_card_manager(target) if action in ("health", "logs", "stop")
                         else None) or _stage_remote_manager(target)
        remote_argv = ["python3", remote_script, action, helper_device]
        if action in ("launch", "plan") and profile:
            remote_argv.append(profile["key"] if isinstance(profile, dict) else profile)
        if role:
            remote_argv.append(role)
        if follow:
            remote_argv.append("-f")
        if yes:
            remote_argv.append("-y")
        result = run_remote(target, shlex.join(remote_argv), batch=True, tty=follow)
        if result.returncode != 0:
            sys.exit(result.returncode)
        return True
    REMOTE = None
    argv = _card_helper_command() + [action, helper_device]
    if profile:
        argv.append(profile["key"] if isinstance(profile, dict) else profile)
    if role:
        argv += ["--role", role]
    if follow:
        argv.append("-f")
    if yes:
        argv.append("-y")
    helper_available = (os.path.isfile(CARD_HELPER) if os.path.dirname(CARD_HELPER)
                        else shutil.which(CARD_HELPER))
    if not helper_available:
        print(f"ERROR: card helper '{CARD_HELPER}' is unavailable. Restore the checked-in "
              "helper or set $OMODEL_MANAGER_CARD_HELPER to an executable.", file=sys.stderr)
        sys.exit(1)
    if os.path.abspath(CARD_HELPER) == os.path.abspath(DEFAULT_CARD_HELPER):
        helper = _load_card_helper()
        helper.DOCKER_RUNNER = docker
        result = helper.main(argv[2:])
        if result:
            sys.exit(result)
    else:
        result = subprocess.run(argv)
        if result.returncode != 0:
            sys.exit(result.returncode)
    return True


def _facade_suggestions(device, profile=None, stopped=False):
    p, name = _cli_name(), device["name"]
    if stopped:
        _suggest([("Choose another compatible model", f"{p} launch {name}"),
                  ("Inspect all devices", f"{p} devices")])
    elif profile:
        _suggest([("Check readiness", f"{p} health {name}"),
                  ("Follow logs", f"{p} logs {name} -f"),
                  ("Stop this deployment", f"{p} stop {name}")])
    else:
        _suggest([("See compatible models", f"{p} launch {name}")])


def _dispatch_facade_launch(device, profile, args, dry_run):
    global REMOTE
    kind = device["kind"]
    if kind == "card":
        return dispatch_card("plan" if dry_run else "launch", device, profile,
                             dry_run=dry_run)
    if kind == "cluster":
        unsupported = [flag for attr, flag in (("foreground", "--foreground"),
                       ("force", "--force"), ("no_fetch", "--no-fetch"),
                       ("refresh", "--refresh"), ("wait", "--wait"))
                       if getattr(args, attr, False)]
        if unsupported:
            print("ERROR: these options apply only to node profiles: " + ", ".join(unsupported),
                  file=sys.stderr)
            sys.exit(1)
        return _call_internal(cmd_cluster_launch, argparse.Namespace(
            name=device.get("target") or device["name"], profile=profile["key"],
            dry_run=dry_run, startup_timeout=1800,
            cluster_config=device,
            keep=CLUSTER_PROFILES[profile["key"]]["backend"] == "vllm-mp"))
    REMOTE = device.get("target")
    return _call_internal(cmd_launch, argparse.Namespace(
        key=profile["key"], host=None, remote=REMOTE, local=REMOTE is None,
        dry_run=dry_run, foreground=False, keep=True, force=False,
        no_fetch=False, refresh=False, wait=False, node_only=True,
        device=device["name"]))


def _resolve_facade_operands(args):
    device = resolve_device(args.device)
    profiles = _compatible_profiles(device)
    if not args.model:
        print(f"Compatible profiles for {device['name']} ({device['kind']}):")
        for key in profiles:
            print(f"  {key}")
        if profiles:
            sample = next(iter(profiles))
            _suggest([("Plan this deployment", f"{_cli_name()} plan {device['name']} {sample}"),
                      ("Launch it", f"{_cli_name()} launch {device['name']} {sample}")])
        return device, None
    profile = profiles.get(args.model)
    if not profile:
        exact = ", ".join(profiles) or "(none)"
        print(f"ERROR: model '{args.model}' is not compatible with {device['kind']} device "
              f"'{device['name']}'. Compatible profiles: {exact}.", file=sys.stderr)
        sys.exit(1)
    return device, profile


def cmd_device_launch(args):
    if not args.device:
        cmd_devices(argparse.Namespace(kind=None, suggest=False))
        devices = device_inventory()
        if devices:
            _suggest([("Choose a model for a device",
                       f"{_cli_name()} launch {next(iter(devices))}")])
        return
    device, profile = _resolve_facade_operands(args)
    if not profile:
        return
    _ensure_device_available(device)
    _dispatch_facade_launch(device, profile, args, dry_run=False)
    _facade_suggestions(device, profile)


def cmd_plan(args):
    device, profile = _resolve_facade_operands(args)
    if not profile:
        return
    _dispatch_facade_launch(device, profile, args, dry_run=True)
    selected = (CLUSTER_PROFILES.get(profile["key"])
                if device["kind"] == "cluster" else None)
    if (selected is not None
            and not (selected.get("image_signature") or selected.get("image_signatures"))):
        _suggest([("Build and inspect the candidate image",
                   f"{_cli_name()} cluster prepare {device['name']} {profile['key']} --build")])
    else:
        _suggest([("Launch this plan",
                   f"{_cli_name()} launch {device['name']} {profile['key']}")])


def _node_lifecycle_args(device, deployment, **values):
    global REMOTE
    REMOTE = device.get("target")
    base = {"target": deployment.get("profile"), "remote": REMOTE or "local-facade",
            "all": False, "tail": 200, "follow": False, "yes": False}
    base.update(values)
    return argparse.Namespace(**base)


def cmd_device_logs(args):
    device = resolve_device(args.device)
    deployment = _require_current_deployment(device)
    role = args.role or "head"
    if device["kind"] != "cluster" and args.role:
        print("ERROR: ROLE is only valid for cluster devices.", file=sys.stderr)
        sys.exit(1)
    try:
        if device["kind"] == "cluster":
            _call_internal(cmd_cluster_logs, argparse.Namespace(
                name=device.get("target") or device["name"], profile=deployment["profile"],
                role=role, follow=args.follow, tail=200, cluster_config=device))
        elif device["kind"] == "card":
            dispatch_card("logs", device, deployment["profile"], follow=args.follow)
        else:
            _call_internal(cmd_logs, _node_lifecycle_args(
                device, deployment, follow=args.follow, tail=200))
    except SystemExit as e:
        if e.code not in (None, 0):
            raise
    _facade_suggestions(device, {"key": deployment["profile"]})


def cmd_device_stop(args):
    device = resolve_device(args.device)
    deployment = _require_current_deployment(device)
    if device["kind"] == "cluster":
        stopped = _call_internal(cmd_cluster_stop, argparse.Namespace(
            name=device.get("target") or device["name"], yes=args.yes,
            cluster_config=device))
    elif device["kind"] == "card":
        if not args.yes:
            reply = input(
                f"Stop the deployment on card '{device['name']}'? [y/N] "
            ).strip().lower()
            if reply not in ("y", "yes"):
                print("Aborted.")
                return
        stopped = dispatch_card("stop", device, deployment["profile"], yes=True)
    else:
        stopped = _call_internal(cmd_stop, _node_lifecycle_args(
            device, deployment, yes=args.yes))
    if stopped is False:
        return
    _facade_suggestions(device, stopped=True)


def cmd_device_health(args):
    device = resolve_device(args.device)
    deployment = _require_current_deployment(device)
    if device["kind"] == "cluster":
        _call_internal(cmd_cluster_health, argparse.Namespace(
            name=device.get("target") or device["name"], profile=deployment["profile"],
            cluster_config=device))
    elif device["kind"] == "card":
        dispatch_card("health", device, deployment["profile"])
    else:
        _call_internal(cmd_health, _node_lifecycle_args(device, deployment))
    _facade_suggestions(device, {"key": deployment["profile"]})


def format_run(argv, target=None):
    """Human-readable, multi-line rendering of a `docker run` argv for dry-run/echo.
    Masks secret env values (tokens/keys). For DISPLAY only -- never executed."""
    secret = ("TOKEN", "SECRET", "PASSWORD", "KEY")

    def disp(t):
        if "=" in t and not t.startswith("-"):
            k, _, v = t.partition("=")
            if v and any(h in k.upper() for h in secret):
                return f"{k}={v[:3]}...(masked)"
        return t

    # Group tokens: each option starts a line, taking one following value if present;
    # bare positionals (e.g. the image) get their own line.
    lines, cur, i = [], ["docker", argv[0]], 1
    while i < len(argv):
        t = argv[i]
        if t.startswith("-"):
            lines.append(cur)
            cur = [t]
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                cur.append(argv[i + 1])
                i += 2
                continue
            i += 1
        else:
            lines.append(cur)
            cur = [t]
            i += 1
    lines.append(cur)
    rendered = " \\\n    ".join(" ".join(shlex.quote(disp(x)) for x in ln) for ln in lines)
    if target:
        return f"# on {target} over SSH ({' '.join(ssh_opts())})\n{rendered}"
    return rendered


def push_assets_remote(target, key, mounts, dry=False):
    """scp locally-cached assets to the remote box; return remote host:container mounts."""
    if not mounts:
        return mounts
    rdir = f"{remote_home(target)}/.otools/assets/{re.sub(r'[^a-zA-Z0-9_.-]', '-', key)}"
    if not dry:
        run_remote(target, f"mkdir -p {shlex.quote(rdir)}", batch=True)
    out = []
    for m in mounts:
        local, _, container = m.partition(":")
        rpath = f"{rdir}/{os.path.basename(local)}"
        if not dry:
            res = subprocess.run(["scp"] + ssh_opts() + [local, f"{target}:{rpath}"], text=True)
            if res.returncode != 0:
                print(f"ERROR: scp asset -> {target}:{rpath} failed.", file=sys.stderr)
                sys.exit(1)
        print(f"  asset: -> {target}:{rpath}")
        out.append(f"{rpath}:{container}")
    return out


def _image_present(image):
    """True if the image is already cached on the active docker host (no pull)."""
    return docker(["image", "inspect", image], capture=True).returncode == 0


def _launch_log_path(key):
    return f"~/.config/otools/launch-{key}.log"


# vLLM's memory query can miss reclaimable page cache, so a warm cache can cause a
# false OOM at load (vLLM #35313). Every launch drops the cache right before
# `docker run`. `install` sets up a
# scoped NOPASSWD sudoers rule so `sudo -n` runs it unattended. `sudo -n` never
# prompts: if the rule is missing it fails fast and we warn (best-effort, never aborts
# the launch) instead of hanging on a password prompt.
DROP_CACHES_HELPER = "/usr/local/sbin/otools-drop-caches"
DROP_CACHES_SUDOERS = "/etc/sudoers.d/otools-drop-caches"
DROP_CACHES_CMD = "sudo -n " + DROP_CACHES_HELPER


def _drop_caches_install_cmd():
    """Remote shell (run once under interactive sudo by `install --fix`) that drops in
    the scoped drop-caches helper script + a NOPASSWD sudoers rule for the connecting
    user, then validates the rule with visudo. printf|tee avoids heredoc quoting."""
    script = "printf '#!/bin/sh\\nsync\\necho 3 > /proc/sys/vm/drop_caches\\n'"
    rule = ("printf '%s ALL=(root) NOPASSWD: " + DROP_CACHES_HELPER + "\\n' \"$(id -un)\"")
    return (
        f"{script} | sudo tee {DROP_CACHES_HELPER} >/dev/null "
        f"&& sudo chmod 0755 {DROP_CACHES_HELPER} "
        f"&& {rule} | sudo tee {DROP_CACHES_SUDOERS} >/dev/null "
        f"&& sudo chmod 0440 {DROP_CACHES_SUDOERS} "
        f"&& sudo visudo -cf {DROP_CACHES_SUDOERS}"
    )


def _drop_caches(target, dry=False):
    """Free the OS page cache on the target (local or remote) right before a launch."""
    where = f" on {target}" if target else " locally"
    if dry:
        print(f"    (would drop page cache{where}: {DROP_CACHES_CMD})")
        return
    print(f"Dropping page cache{where} (UMA launch guard, vLLM #35313) ...")
    if target:
        rc = run_remote(target, DROP_CACHES_CMD, batch=True).returncode
    else:
        rc = subprocess.run(["sh", "-c", DROP_CACHES_CMD]).returncode
    if rc != 0:
        print(f"  warning: drop-caches skipped (no NOPASSWD rule on {target or 'this host'}? "
              f"run `install {target or ''} --fix`); continuing.", file=sys.stderr)


def _launch_bg_command(key, image, run_argv):
    """Shell command that pulls the image, drops the page cache, starts the container
    detached, and writes a status marker to ~/.config/otools/launch-<key>.log, then
    backgrounds itself so the dispatcher returns at once. Runs on whichever host docker
    uses (local shell or the remote over SSH). The cache drop happens after the pull and
    right before `docker run`, grouped `|| true` so it can never fail the launch."""
    run_str = "docker " + " ".join(shlex.quote(a) for a in run_argv)
    cancel = '"$HOME/.config/otools/launch-%s.cancel"' % key
    pid = '"$HOME/.config/otools/launch-%s.pid"' % key
    steps = [
        "docker pull %s" % shlex.quote(image),
        "test ! -e %s" % cancel,
        "{ %s || true; }" % DROP_CACHES_CMD,
        "test ! -e %s" % cancel,
        run_str,
    ]
    inner = "%s && echo OTOOLS_LAUNCH_OK || echo OTOOLS_LAUNCH_FAILED" % " && ".join(steps)
    log = '"$HOME/.config/otools/launch-%s.log"' % key
    return ('mkdir -p "$HOME/.config/otools"; '
            "rm -f %s %s; nohup setsid sh -c %s > %s 2>&1 & echo $! > %s"
            % (cancel, pid, shlex.quote(inner), log, pid))


def _cancel_background_launch(key, target=None):
    """Prevent an in-flight cold pull from starting its container."""
    pid = '"$HOME/.config/otools/launch-%s.pid"' % key
    log = '"$HOME/.config/otools/launch-%s.log"' % key
    cancel = '"$HOME/.config/otools/launch-%s.cancel"' % key
    command = (f"if test -f {pid} && ! grep -qE "
               f"'OTOOLS_LAUNCH_OK|OTOOLS_LAUNCH_FAILED' {log} 2>/dev/null; "
               f"then : > {cancel}; launch_pid=$(cat {pid}); "
               f"case $launch_pid in (*[!0-9]*|'') ;; (*) "
               f"kill -TERM -- -$launch_pid 2>/dev/null || kill -TERM $launch_pid 2>/dev/null; "
               f"count=0; while kill -0 -- -$launch_pid 2>/dev/null "
               f"&& test $count -lt 50; do sleep 0.1; count=$((count + 1)); done; "
               f"if kill -0 -- -$launch_pid 2>/dev/null; then "
               f"kill -KILL -- -$launch_pid 2>/dev/null; count=0; "
               f"while kill -0 -- -$launch_pid 2>/dev/null && test $count -lt 50; "
               f"do sleep 0.1; count=$((count + 1)); done; fi; "
               f"if ! kill -0 -- -$launch_pid 2>/dev/null; then echo cancelled; fi;; esac; fi")
    if target:
        result = run_remote(target, command, capture=True, batch=True)
    else:
        result = subprocess.run(["sh", "-c", command], text=True, capture_output=True)
    return result.returncode == 0 and result.stdout.strip() == "cancelled"


def _launch_status(body):
    """Classify a background-launch log: 'none' | 'ok' | 'failed' | 'running'."""
    if not body or not body.strip():
        return "none"
    if "OTOOLS_LAUNCH_OK" in body:
        return "ok"
    if "OTOOLS_LAUNCH_FAILED" in body:
        return "failed"
    return "running"


def cmd_launch(args):
    if args.key in CLUSTER_PROFILES and not getattr(args, "node_only", False):
        cluster_name = getattr(args, "host", None) or getattr(args, "remote", None)
        if not cluster_name:
            print(f"ERROR: cluster profile '{args.key}' requires a registered cluster: "
                  f"`{_cli_name()} launch {args.key} <cluster>`.", file=sys.stderr)
            sys.exit(1)
        if args.local:
            print("ERROR: --local cannot be used with a two-node cluster profile.",
                  file=sys.stderr)
            sys.exit(1)
        single_host_options = [flag for attr, flag in (
            ("foreground", "--foreground"), ("force", "--force"),
            ("no_fetch", "--no-fetch"), ("refresh", "--refresh"), ("wait", "--wait"),
        ) if getattr(args, attr, False)]
        if args.keep and CLUSTER_PROFILES[args.key]["backend"] != "vllm-mp":
            single_host_options.append("--keep")
        if single_host_options:
            print("ERROR: these options apply only to single-host profiles: "
                  + ", ".join(single_host_options), file=sys.stderr)
            sys.exit(1)
        cluster_args = argparse.Namespace(name=cluster_name, profile=args.key,
                                          dry_run=args.dry_run, startup_timeout=1800,
                                          keep=args.keep)
        cmd_cluster_launch(cluster_args)
        return
    cfg = load_config()
    merged = merge_model(cfg, args.key)
    # Host resolution: explicit host (positional / --host) > --local > per-model
    # `remote` > config defaults.remote (already in REMOTE) > local.
    global REMOTE
    if args.local:
        if args.remote:
            print(f"ERROR: --local contradicts the explicit host '{args.remote}' -- pick one.",
                  file=sys.stderr)
            sys.exit(1)
        REMOTE = None                      # override defaults.remote / per-model remote
    elif not args.remote and merged.get("remote"):
        REMOTE = resolve_host(merged["remote"])
    # Local launch is the default -- but when hosts are registered, say so out loud
    # so a forgotten host is a visible one-liner, not a silent local pull.
    if not REMOTE and not args.local:
        registered = load_hosts()
        if registered:
            names = ", ".join(a for a, _ in registered)
            print(f"Launching locally. (Registered hosts: {names} -- use "
                  f"`{_cli_name()} launch {args.key} <host>` to target one.)")
    need_docker()
    # Download/verify declared assets locally, then (if remote) push them to the box.
    asset_mounts = resolve_assets(args.key, merged, do_fetch=not args.no_fetch,
                                  refresh=args.refresh, dry=args.dry_run)
    if REMOTE and asset_mounts:
        asset_mounts = push_assets_remote(REMOTE, args.key, asset_mounts, dry=args.dry_run)
    merged["volumes"] = list(merged.get("volumes", [])) + asset_mounts
    name, argv, warnings = build_run_argv(args.key, merged, foreground=args.foreground,
                                          target=REMOTE, keep=args.keep)

    # Refuse to clobber an existing container (running OR stopped) or double-bind a port.
    if not args.dry_run:
        rflag = f" --host {_host_label(REMOTE)}" if REMOTE else ""
        allc = docker(["ps", "-a", "--format", "{{.Names}}"], capture=True)
        if allc.returncode == 0 and name in allc.stdout.split():
            print(f"ERROR: container '{name}' already exists (running or stopped). "
                  f"Remove it first:\n  {_cli_name()} stop {args.key}{rflag}", file=sys.stderr)
            sys.exit(1)
        for r in list_managed(include_all=True) or []:
            if not args.force and _label(r.get("Labels", ""), LABEL_PORT) == str(merged["port"]):
                print(f"ERROR: port {merged['port']} already used by '{r.get('Names')}'. "
                      f"Use --force to launch anyway.", file=sys.stderr)
                sys.exit(1)

    for w in warnings:
        print(f"  warning: {w}")

    where = f" on {REMOTE} (over SSH)" if REMOTE else " locally"
    if args.dry_run:
        print(f"--- DRY RUN: would launch '{args.key}'{where} ---")
        _drop_caches(REMOTE, dry=True)
        print(format_run(argv, REMOTE))
        return
    image = merged["image"]
    cached = _image_present(image)
    if not cached and not args.wait and not args.foreground:
        # Non-blocking launch: an uncached image pull can take minutes and time out
        # an agent's tool call. Pull + run in the background and return immediately.
        bg = _launch_bg_command(args.key, image, argv)
        loc = f"on {REMOTE}" if REMOTE else "locally"
        print(f"Image '{image}' is not cached {loc}; pulling in the background and starting "
              f"'{args.key}' when it's ready (container '{name}', port {merged['port']}).")
        if REMOTE:
            dispatched = run_remote(REMOTE, bg, batch=True)
        else:
            dispatched = subprocess.run(["sh", "-c", bg])
        if dispatched.returncode != 0:
            print(f"ERROR: could not dispatch background launch for '{args.key}'{where}.",
                  file=sys.stderr)
            sys.exit(dispatched.returncode)
        p = _cli_name()
        _suggest([
            ("Check pull/launch progress", f"{p} pull-status {args.key}{_rsuf()}"),
            ("Watch container logs once it starts", f"{p} logs {args.key}{_rsuf()} -f"),
            ("Check readiness", f"{p} health {args.key}{_rsuf()}"),
            ("(Next time) pull inline and block", f"{p} launch {args.key}{_rsuf()} --wait"),
        ])
        return
    if not cached:
        # Blocking launch (--wait/--foreground) with an uncached image: pull inline.
        print(f"Image '{image}' is not cached{where}; pulling (can take several minutes) ...")
        if docker(["pull", image]).returncode != 0:
            print(f"ERROR: failed to pull '{image}'.", file=sys.stderr)
            sys.exit(1)

    _drop_caches(REMOTE)
    print(f"Launching '{args.key}' as container '{name}' on port {merged['port']}{where} ...")
    print(format_run(argv, REMOTE))
    res = docker(argv, tty=args.foreground)
    if res.returncode != 0:
        sys.exit(res.returncode)
    if not args.foreground:
        p = _cli_name()
        # Settle: a cached image launches in <1s -- faster than docker registers the
        # container -- so an immediate health/ps check can race and read a wrong state
        # (this is what makes agents loop). Pause a few seconds so the next check is
        # consistent, and catch a container that crashed instantly on startup.
        time.sleep(5)
        running = docker(["ps", "--format", "{{.Names}}"], capture=True)
        if running.returncode == 0 and name not in running.stdout.split():
            log_target = getattr(args, "device", args.key)
            print(f"\nWARNING: '{name}' is NOT running ~5s after launch -- it likely crashed on "
                  f"startup. Read the log:\n  {p} logs {log_target}", file=sys.stderr)
            return
        print(f"\nStarted '{args.key}' (container '{name}'). The vLLM server inside is now "
              f"INITIALIZING -- weights + torch.compile + warmup take a few minutes.")
        print("Until it finishes, `health` reports STARTING and the port refuses connections --"
              " that is NORMAL, not an error. Poll `health` until it says READY:")
        _suggest([
            ("Poll readiness (~every 15s until READY)", f"{p} health {args.key}{_rsuf()}"),
            ("Watch startup logs (Ctrl-C to stop)", f"{p} logs {args.key}{_rsuf()} -f"),
            ("Stop this model", f"{p} stop {args.key}{_rsuf()}"),
        ])


def cmd_pull(args):
    """Pre-pull a profile's image so a later `launch` starts instantly."""
    cfg = load_config()
    merged = merge_model(cfg, args.key)
    global REMOTE
    if not args.remote and merged.get("remote"):
        REMOTE = resolve_host(merged["remote"])
    need_docker()
    image = merged["image"]
    where = f" on {REMOTE}" if REMOTE else " locally"
    if _image_present(image):
        print(f"Image '{image}' is already cached{where}.")
        return
    print(f"Pulling '{image}'{where} ...")
    sys.exit(docker(["pull", image]).returncode)


def cmd_pull_status(args):
    """Report the background launch/pull recorded in ~/.config/otools/launch-<key>.log."""
    global REMOTE
    # `pull-status <host>`: no key given but a host is set -> find what's on that box.
    if not args.key and REMOTE:
        rows = list_managed(remote=REMOTE) or []
        if rows:
            args.key = _label(rows[0].get("Labels", ""), LABEL_MODEL) or rows[0].get("Names")
        else:
            pk = _pulling_keys(REMOTE)
            args.key = pk[0] if pk else None
    if not args.key:
        print(f"ERROR: name a profile key, or a host that's running/pulling something "
              f"(see `{_cli_name()} ps`).", file=sys.stderr)
        sys.exit(1)
    cfg = load_config(create=False) if os.path.exists(CONFIG_PATH) else {"models": {}}
    merged = merge_model(cfg, args.key) if args.key in cfg.get("models", {}) else {}
    if not args.remote and merged.get("remote"):
        REMOTE = resolve_host(merged["remote"])
    where = f" on {REMOTE}" if REMOTE else " locally"
    log = _launch_log_path(args.key)
    if REMOTE:
        if not shutil.which("ssh"):
            print("ERROR: `ssh` not found on PATH.", file=sys.stderr)
            sys.exit(1)
        res = run_remote(REMOTE, f"cat {log} 2>/dev/null", capture=True, batch=True)
        body = res.stdout if res.returncode == 0 else ""
    else:
        try:
            body = open(os.path.expanduser(log)).read()
        except OSError:
            body = ""
    p = _cli_name()
    status = _launch_status(body)
    if status == "none":
        # No bg-pull log. If the container is already running, it was a direct (cached-image)
        # launch -- say so plainly instead of "nothing is pulling", which reads like a failure
        # and sends agents into a poll loop.
        running = any(r.get("Names") == container_name(args.key)
                      for r in list_managed(remote=REMOTE) or [])
        if running:
            device = _host_label(REMOTE) if REMOTE else "local"
            print(f"'{args.key}': launched directly (image was cached); the container is "
                  f"running{where}. There's no pull to track -- poll `{p} health "
                  f"{device}` until READY.")
        else:
            device = _host_label(REMOTE) if REMOTE else "local"
            print(f"No background launch in progress for '{args.key}'{where}. "
                  f"Start one with `{p} launch {device} {args.key}`.")
        return
    lines = body.strip().splitlines()
    if status == "ok":
        device = _host_label(REMOTE) if REMOTE else "local"
        print(f"'{args.key}': image pulled and container started{where}.")
        _suggest([
            ("Check readiness", f"{p} health {device}"),
            ("Watch logs", f"{p} logs {device} -f"),
        ])
    elif status == "failed":
        print(f"'{args.key}': background launch FAILED{where}. Last lines:")
        for ln in lines[-10:]:
            print(f"   {ln}")
        sys.exit(1)
    else:
        print(f"'{args.key}': still pulling/starting{where}.")
        print(f"   {lines[-1]}")
        _suggest([("Poll again", f"{p} pull-status {args.key}{_rsuf()}")])


def cmd_fetch(args):
    cfg = load_config()
    merged = merge_model(cfg, args.key)
    if not merged.get("assets"):
        print(f"No assets declared for '{args.key}'.")
        return
    resolve_assets(args.key, merged, do_fetch=True, refresh=args.refresh, dry=False)
    print("Assets ready.")


def cmd_stop(args):
    _apply_profile_remote(args)
    need_docker()
    cfg = load_config(create=False) if os.path.exists(CONFIG_PATH) else {"models": {}}
    key = args.target if args.target in cfg.get("models", {}) else None
    target = resolve_target(args.target) if args.target else _managed_on(REMOTE)[0]
    if not args.yes:
        reply = input(f"Stop and remove container '{target}'? [y/N] ").strip().lower()
        if reply not in ("y", "yes"):
            print("Aborted.")
            return False
    cancelled = _cancel_background_launch(key, REMOTE) if key else False
    res = docker(["rm", "-f", target], capture=cancelled)
    if cancelled and res.returncode != 0:
        for _ in range(10):
            time.sleep(0.1)
            res = docker(["rm", "-f", target], capture=True)
            if res.returncode == 0:
                break
    if res.returncode == 0:
        print(f"Stopped {target}.")
        p = _cli_name()
        _suggest([
            ("List what's still running", f"{p} ps{_rsuf()}"),
            ("Launch a model", f"{p} launch <profile>{_rsuf()}"),
            ("See available models", f"{p} list"),
        ])
        return True
    elif cancelled:
        print(f"Cancelled the pending launch for {key}.")
        return True
    else:
        sys.exit(res.returncode)


def cmd_logs(args):
    _apply_profile_remote(args)
    need_docker()
    if args.target:
        ref, rs = args.target, _rsuf()
        target = resolve_target(args.target)
    else:
        # Host-addressed (`logs dgx-2`) or bare `logs`: the positional was consumed, so
        # suggest the host form back (it's self-contained), or fall back to the model key.
        target, key = _managed_on(REMOTE)
        ref, rs = (_host_label(REMOTE), "") if REMOTE else (key, "")
    largs = ["logs"]
    if args.tail is not None:
        largs += ["--tail", str(args.tail)]
    if args.follow:
        largs += ["-f"]
    largs += [target]
    # Stream straight through to the user's terminal (local or over SSH).
    try:
        rc = docker(largs).returncode
    except KeyboardInterrupt:
        # Ctrl-C while following just detaches the viewer; the container keeps running.
        print("\nStopped following logs -- the container is still running.")
        _suggest([
            ("Re-attach to logs", f"{_cli_name()} logs {ref}{rs} -f"),
            ("Check readiness", f"{_cli_name()} health {ref}{rs}"),
            ("Stop the model", f"{_cli_name()} stop {ref}{rs}"),
        ])
        return
    sys.exit(rc)


def cmd_health(args):
    _apply_profile_remote(args)
    need_docker()
    cfg = load_config(create=False) if os.path.exists(CONFIG_PATH) else {"models": {}}
    hostaddr = remote_host() or "127.0.0.1"
    targets = []   # (label, host, port, running)
    if args.target:
        merged = merge_model(cfg, args.target) if args.target in cfg.get("models", {}) else None
        rows = list_managed(include_all=True) or []
        for r in rows:
            if r.get("Names") in (args.target, container_name(args.target)):
                targets.append((r.get("Names"), hostaddr,
                                _label(r.get("Labels", ""), LABEL_PORT), True))
        if not targets and merged:
            targets.append((args.target, hostaddr, merged["port"], False))
    else:
        for r in list_managed(include_all=args.all) or []:
            targets.append((r.get("Names"), hostaddr,
                            _label(r.get("Labels", ""), LABEL_PORT), True))
    if not targets:
        print("No running containers to health-check.")
        return
    for label, host, port, running in targets:
        if not port:
            print(f"  {label}: unknown port"); continue
        # Remote servers bind loopback on the box (the LAN can't see it), so probe
        # over SSH there; local servers are probed directly.
        probe = remote_http_models(REMOTE, int(port)) if REMOTE else http_models(host, int(port))
        phase, detail = probe
        if phase == "ready":
            print(f"  {label:<28} :{port}  READY  {detail}")
        elif phase == "starting" and running:
            print(f"  {label:<28} :{port}  STARTING  vLLM still loading (weights+compile+warmup) "
                  "-- normal for a few min after launch; keep polling, this is NOT an error")
        elif phase == "starting":
            print(f"  {label:<28} :{port}  DOWN  nothing listening and no running container "
                  "(launch it, or it crashed -- check `logs`)")
        else:
            print(f"  {label:<28} :{port}  not ready  {detail}")


def http_models(host, port, timeout=3.0):
    """(phase, detail): 'ready' (models listed), 'starting' (nothing listening yet --
    connection refused/timeout, i.e. the server is still coming up), or 'error' (it
    answered but not with a model list)."""
    url = f"http://{host}:{port}/v1/models"
    try:
        req = urllib.request.Request(url, headers={"Authorization": "Bearer x"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", "ignore"))
        ids = [m.get("id") for m in data.get("data", []) if m.get("id")]
        return "ready", ", ".join(ids) if ids else "(no model ids)"
    except urllib.error.HTTPError as e:
        return "error", f"HTTP {e.code}"
    except (urllib.error.URLError, OSError):
        return "starting", "server not listening yet"


def remote_http_models(target, port, timeout=3.0):
    """http_models() for a remote host, same (phase, detail) contract. The server is
    loopback-bound ON THAT HOST, which the laptop can't reach over the LAN -- so curl
    runs on the box itself and probes its own 127.0.0.1 (works for a 0.0.0.0 bind too)."""
    url = f"http://127.0.0.1:{port}/v1/models"
    sh = (f"out=$(curl -sS --noproxy '*' -w '\\nHTTP_CODE:%{{http_code}}' "
          f"--max-time {int(timeout)} "
          f"-H 'Authorization: Bearer x' {shlex.quote(url)}); rc=$?; "
          f"[ $rc -ne 0 ] && exit $rc; printf '%s' \"$out\"")
    res = run_remote(target, sh, capture=True, batch=True)
    out = res.stdout or ""
    # curl 7/28 are connection-refused/timeout; 52/56 are startup-time socket
    # closures. Those mean vLLM may still be loading. Tool and SSH failures do not.
    if res.returncode in (7, 28, 52, 56):
        return "starting", "server not listening yet"
    error = (res.stderr or "").strip()
    if res.returncode == 127:
        return "error", "curl not found on remote host (run `install <host>` to check setup)"
    if res.returncode == 255:
        return "error", "SSH health probe failed" + (f": {error[-300:]}" if error else "")
    if res.returncode != 0:
        return "error", f"curl health probe failed (exit {res.returncode})" + (
            f": {error[-300:]}" if error else "")
    if not out:
        return "error", "remote curl probe returned an empty response"
    sep = out.rfind("\nHTTP_CODE:")
    if sep < 0:
        return "error", "remote curl probe returned an invalid response"
    body, code = out[:sep], out[sep + len("\nHTTP_CODE:"):].strip()
    if code != "200":
        return "error", f"HTTP {code}"
    try:
        data = json.loads(body)
    except ValueError:
        return "error", "unparseable /v1/models body"
    ids = [m.get("id") for m in data.get("data", []) if m.get("id")]
    return "ready", ", ".join(ids) if ids else "(no model ids)"


def _print_results(results):
    print()
    width = max(len(r[0]) for r in results)
    for name, ok, detail in results:
        mark = "[ok]  " if ok is True else ("[--]  " if ok is None else "[FAIL]")
        print(f"  {mark} {name:<{width}}  {detail}")


def _setup_run(target, cmd, capture=False, tty=False, batch=True):
    """Run an install command locally, or over SSH when target is set."""
    if target:
        return run_remote(target, cmd, capture=capture, tty=tty, batch=batch)
    return subprocess.run(["sh", "-c", cmd], text=True, capture_output=capture)


def _setup_ok(target, cmd):
    """True if a local/remote install check exits 0; returns (ok, stdout)."""
    res = _setup_run(target, cmd, capture=True, batch=True)
    return res.returncode == 0, (res.stdout or "").strip()


def cmd_install(args):
    """Bootstrap local prereqs when no target is given, or bootstrap and register
    explicit remote targets so `ps` and `--host` can find them."""
    raw = args.target
    if not raw:
        ready, _ = _setup_host(None, args.fix)
        sys.exit(0 if ready else 1)
    if not shutil.which("ssh"):
        print("ERROR: no `ssh` client on PATH.", file=sys.stderr)
        sys.exit(1)
    hosts = [h.strip() for h in raw.split(",") if h.strip()]
    alias = (getattr(args, "alias", None) or "").strip() or None
    card = getattr(args, "card", None)
    if alias and len(hosts) != 1:
        print("ERROR: an alias names a single host -- pass just one user@ip when you give an alias.",
              file=sys.stderr)
        sys.exit(1)
    if card and (len(hosts) != 1 or not alias):
        print("ERROR: --card requires one remote target and an explicit host alias.",
              file=sys.stderr)
        sys.exit(1)
    existing = load_hosts()                      # [(alias, target)] already registered
    prior_alias = {t: a for a, t in existing}
    connected, all_ready = [], True
    for target in hosts:
        ready, ssh_ok = _setup_host(target, args.fix, card=card)
        all_ready = all_ready and ready
        if ssh_ok:
            connected.append((alias or prior_alias.get(target) or target, target))
    if connected:
        # Merge, don't overwrite: keep other registered hosts, add/replace these.
        new_targets = {t for _, t in connected}
        new_aliases = {a.casefold() for a, _ in connected}
        merged = [(a, t) for a, t in existing
                  if t not in new_targets and a.casefold() not in new_aliases] + connected
        save_hosts(merged)
        print()
        print(f"-> registered {len(connected)} host(s) for `ps` / `--host` in {HOSTS_FILE}:")
        for a, t in connected:
            print(f"     {a:<12} {t}" if a != t else f"     {t}")
        if card:
            devices = load_devices()
            card_name = f"{alias}-{card}"
            devices[card_name] = {
                "kind": "card", "target": alias,
                "hardware": "intel-arc-pro-b70",
            }
            save_devices(devices)
            print(f"-> registered card device {card_name} on {alias} in {DEVICES_FILE}")
        auto_register_dgx_cluster(merged, preferred_aliases=[a for a, _ in connected])
    sys.exit(0 if all_ready else 1)


def cmd_uninstall(args):
    """Remove an explicit device, or unregister a host and revoke its otools key."""
    name = args.target
    if not name:
        print("ERROR: uninstall needs a device, host alias, or user@ip.", file=sys.stderr)
        sys.exit(1)
    devices = load_devices()
    device_keys = [key for key in devices
                   if isinstance(key, str) and key.casefold() == name.casefold()]
    if device_keys:
        if args.purge:
            print("ERROR: --purge applies to hosts, not device registrations.", file=sys.stderr)
            sys.exit(1)
        for key in device_keys:
            del devices[key]
        save_devices(devices)
        print(f"-> removed device {device_keys[0]} from {DEVICES_FILE}")
        print("   The host registration, SSH key, and any running containers were left unchanged.")
        return
    target = resolve_host(name)
    existing = load_hosts()
    aliases = {a for a, _ in existing}
    targets = {t for _, t in existing}
    if target not in targets and name not in aliases:
        print(f"WARNING: {name!r} is not registered in {HOSTS_FILE}; "
              f"still attempting to revoke the key on {target}.")

    if shutil.which("ssh"):
        print(f"-> revoking the otools key on {target} "
              f"(authorized_keys line matching '{OTOOLS_SSH_COMMENT}') ...")
        revoke = ("sed -i '/%s/d' ~/.ssh/authorized_keys 2>/dev/null || true"
                  % OTOOLS_SSH_COMMENT)
        rc = subprocess.run(ssh_argv(target) + [revoke]).returncode
        print("   done." if rc == 0 else f"   could not reach {target}; skipped key revoke.")
        if args.purge:
            print(f"-> --purge: stopping otools containers, removing the docker group "
                  f"membership and the drop-caches sudo rule on {target} (sudo; may prompt) ...")
            purge = ("docker ps -aq --filter name=%s | xargs -r docker rm -f 2>/dev/null; "
                     "sudo gpasswd -d $USER docker 2>/dev/null || true; "
                     "sudo rm -f %s %s 2>/dev/null || true"
                     % (NAME_PREFIX, DROP_CACHES_SUDOERS, DROP_CACHES_HELPER))
            run_remote(target, purge, tty=True, batch=False)
    else:
        print("WARNING: no `ssh` client on PATH -- skipping remote key revoke.")

    remaining = [(a, t) for a, t in existing if t != target and a != name]
    save_hosts(remaining)
    devices = load_devices()
    kept_devices = {device_name: record for device_name, record in devices.items()
                    if not (isinstance(record, dict)
                            and record.get("target") in (name, target))}
    if kept_devices != devices:
        save_devices(kept_devices)
    print(f"-> removed {name} from {HOSTS_FILE} ({len(remaining)} host(s) remain).")
    print(f"\nNote: the shared local key {OTOOLS_SSH_KEY} was left in place "
          f"(other hosts may still use it).")
    print(f"  To remove it everywhere: rm {OTOOLS_SSH_KEY} {OTOOLS_SSH_PUB}")


def _setup_host(target, fix, card=None):
    """Check/install prerequisites locally or on one remote host."""
    label = target or "this machine"
    print(f"Setup for {label}  "
          f"({'FIX mode -- will make changes' if fix else 'check-only; pass --fix to remediate'})")
    results = []

    # 0) HF token (local) -- required for gated models (e.g. nvidia/*). Stored at
    #    ~/.config/otools/hf_token (0600); launches forward it automatically.
    tok = hf_token()
    if not tok and fix:
        print("\nNo HF_TOKEN found. Gated models (e.g. nvidia/*) need one to download.")
        print(f"  1. Open {HF_TOKENS_URL}")
        print("  2. 'Create new token' -> Token type: Read -> name it (e.g. otools) -> Create")
        print("  3. Copy it (starts with 'hf_') and paste below.")
        try:
            entered = getpass.getpass("  Paste HF token (hidden), or Enter to skip: ").strip()
        except (EOFError, KeyboardInterrupt):
            entered = ""
        if entered:
            save_hf_token(entered)
            tok = entered
            print(f"  saved to {HF_TOKEN_FILE} (chmod 600)")
    if tok:
        src = "$HF_TOKEN" if os.environ.get("HF_TOKEN") else HF_TOKEN_FILE
        results.append(("HF token", True, f"present (from {src})"))
    else:
        results.append(("HF token", None,
                        f"not set -- only needed for gated models; --fix to add ({HF_TOKENS_URL})"))

    if target:
        # 1) dedicated, clearly-named SSH key (so it's easy to find and revoke later)
        have_key = os.path.exists(OTOOLS_SSH_KEY)
        if not have_key and fix:
            os.makedirs(os.path.dirname(OTOOLS_SSH_KEY), exist_ok=True)
            print(f"-> generating a dedicated key: {OTOOLS_SSH_KEY}  (comment: {OTOOLS_SSH_COMMENT})")
            subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "", "-f", OTOOLS_SSH_KEY,
                            "-C", OTOOLS_SSH_COMMENT])
            have_key = os.path.exists(OTOOLS_SSH_KEY)
        results.append(("otools SSH key", have_key,
                        f"{OTOOLS_SSH_KEY}" if have_key
                        else f"missing; --fix to generate ({OTOOLS_SSH_KEY})"))

        # 2) keyless SSH using THAT key (ssh_opts() now pins -i once the key exists)
        ok, _ = _setup_ok(target, "true") if have_key else (False, "")
        if not ok and fix and have_key:
            print("-> installing the otools key on the remote (enter the remote password once)")
            if shutil.which("ssh-copy-id"):
                subprocess.run(["ssh-copy-id", "-i", OTOOLS_SSH_PUB, target])
            else:
                pubkey = open(OTOOLS_SSH_PUB).read().strip()
                remote_cmd = ("mkdir -p ~/.ssh && chmod 700 ~/.ssh && "
                              "printf '%s\\n' " + shlex.quote(pubkey) + " >> ~/.ssh/authorized_keys && "
                              "chmod 600 ~/.ssh/authorized_keys")
                subprocess.run(ssh_argv(target) + [remote_cmd])   # interactive (password)
            ok, _ = _setup_ok(target, "true")
        results.append(("keyless SSH", ok, "connected with otools key" if ok
                        else "no passwordless login; --fix to set up"))
        if not ok:
            _print_results(results)
            print("\nSSH must work before the rest -- skipping this host.")
            return False, False

        # Standard remote health checks probe the box's loopback with curl over SSH.
        curl_ok, curl_path = _setup_ok(target, "command -v curl")
        results.append(("curl", curl_ok, curl_path or
                        "missing; install curl (required for remote health checks)"))

    # 3) docker installed
    dok, _ = _setup_ok(target, "command -v docker")
    if not dok and fix:
        where = " on the remote" if target else ""
        print(f"-> installing Docker via get.docker.com (sudo; may prompt{where}) ...")
        _setup_run(target,
                   "curl -fsSL https://get.docker.com -o /tmp/get-docker.sh && sudo sh /tmp/get-docker.sh",
                   tty=True, batch=False)
        dok, _ = _setup_ok(target, "command -v docker")
    ver = _setup_ok(target, "docker --version")[1] if dok else ""
    results.append(("docker installed", dok, ver or "missing; --fix to install"))

    # 4) docker usable without sudo (docker group)
    nosudo, _ = (_setup_ok(target, "docker info") if dok else (False, ""))
    in_grp = ("docker" in _setup_ok(target, "id -nG")[1].split()) if dok else False
    if not nosudo and dok and fix:
        who = "remote user" if target else "current user"
        print(f"-> adding {who} to the `docker` group (sudo; prompt) ...")
        _setup_run(target, "sudo usermod -aG docker $USER", tty=True, batch=False)
        in_grp = True
        where = " on the remote" if target else ""
        detail = f"added to docker group -- LOG OUT/IN (or reboot){where}, then re-run install"
        results.append(("docker w/o sudo", False, detail))
    else:
        results.append(("docker w/o sudo", nosudo,
                        "ok" if nosudo else ("in group but session stale; re-login" if in_grp
                                             else "not in docker group; --fix to add")))

    # 4.5) passwordless page-cache drop -- every launch runs it (UMA guard, vLLM #35313),
    #      so install a scoped helper + NOPASSWD rule now (one sudo prompt) and it's silent
    #      forever after. Checked with `sudo -n -l` so it doesn't actually drop caches here.
    if fix and not card:
        print("-> installing the scoped drop-caches helper + NOPASSWD sudoers rule "
              f"({DROP_CACHES_HELPER}; sudo, may prompt once) ...")
        _setup_run(target, _drop_caches_install_cmd(), tty=True, batch=False)
    if not card:
        dc_ok, _ = _setup_ok(target, "sudo -n -l %s >/dev/null 2>&1" % DROP_CACHES_HELPER)
        results.append(("drop-caches sudo", dc_ok,
                        "NOPASSWD rule active (launch drops page cache automatically)" if dc_ok
                        else "no NOPASSWD rule; --fix to add (launches warn + skip the drop otherwise)"))

    # 5) GPU: driver + container runtime (check + advise; we don't auto-install the toolkit)
    if card == "b70":
        render_ok, _ = _setup_ok(target, "test -e /dev/dri/renderD128")
        results.append(("B70 render device", render_ok,
                        "/dev/dri/renderD128 present" if render_ok
                        else "/dev/dri/renderD128 missing"))
    else:
        drv = _setup_ok(target, "nvidia-smi -L 2>/dev/null | head -1")[1] if (nosudo or dok) else ""
        results.append(("nvidia driver", bool(drv), drv or "nvidia-smi not found on host"))
    # --gpus all can be backed EITHER by a registered "nvidia" runtime (legacy) OR by
    # CDI (Docker 25+/29 default with the toolkit). Check several signals so a working
    # CDI setup isn't a false negative.
    gpu_ok, gpu_detail = False, ""
    if nosudo and not card:
        runtimes = _setup_ok(target, "docker info --format '{{json .Runtimes}}' 2>/dev/null")[1].lower()
        has_ctk = _setup_ok(target, "command -v nvidia-ctk")[0]
        has_cdi = _setup_ok(target, "ls /etc/cdi/nvidia.yaml /etc/cdi/nvidia.json 2>/dev/null")[0]
        if "nvidia" in runtimes:
            gpu_ok, gpu_detail = True, "nvidia runtime registered"
        elif has_ctk:
            gpu_ok, gpu_detail = True, "nvidia-container-toolkit present (nvidia-ctk); --gpus via CDI"
        elif has_cdi:
            gpu_ok, gpu_detail = True, "CDI nvidia spec present (/etc/cdi)"
    if not gpu_ok and not gpu_detail:
        gpu_detail = ("no nvidia runtime / nvidia-ctk / CDI spec found -- install toolkit: "
                      "https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/"
                      "latest/install-guide.html")
    if not card:
        results.append(("docker GPU runtime", gpu_ok, gpu_detail))

    _print_results(results)
    if target and os.path.exists(OTOOLS_SSH_KEY):
        print(f"\nThis tool uses its own key {OTOOLS_SSH_KEY} (comment '{OTOOLS_SSH_COMMENT}').")
        print(f"  To revoke later: on the remote, delete the authorized_keys line matching "
              f"'{OTOOLS_SSH_COMMENT}'\n"
              f"    ssh {target} \"sed -i '/{OTOOLS_SSH_COMMENT}/d' ~/.ssh/authorized_keys\"\n"
              f"  and locally: rm {OTOOLS_SSH_KEY} {OTOOLS_SSH_PUB}")
    essentials = {"keyless SSH", "curl", "docker installed", "docker w/o sudo",
                  "nvidia driver", "docker GPU runtime", "drop-caches sudo"}
    if card == "b70":
        essentials -= {"nvidia driver", "docker GPU runtime", "drop-caches sudo"}
        essentials.add("B70 render device")
    if not target:
        essentials -= {"keyless SSH", "curl"}
    ready = all(ok for name, ok, _ in results if name in essentials)
    print(f"\n{'READY: launch away.' if ready else 'NOT READY -- address the [FAIL] rows above'}"
          + ("" if fix else "  (re-run with --fix to remediate)"))
    ssh_ok = next((o for n, o, _ in results if n == "keyless SSH"), not target)
    return ready, ssh_ok


def cmd_config(args):
    if args.path:
        print(CONFIG_PATH)
        return
    if args.init:
        if os.path.exists(CONFIG_PATH) and not args.force:
            print(f"{CONFIG_PATH} exists. Use --force to overwrite.", file=sys.stderr)
            sys.exit(1)
        save_config(DEFAULT_CONFIG)
        print(f"Wrote default config to {CONFIG_PATH}")
        return
    if args.edit:
        load_config()   # ensure it exists
        editor = os.environ.get("EDITOR", "nano")
        sys.exit(subprocess.run([editor, CONFIG_PATH]).returncode)
    # default: show it
    cfg = load_config()
    print(f"# {CONFIG_PATH}")
    print(json.dumps(cfg, indent=2))


def cmd_sync(args):
    """Reset model_manager.json from the committed DEFAULT_CONFIG -- the `git pull`
    companion (named to match `omw sync`). Backs up a differing existing file first so
    local tweaks are never silently lost."""
    p = _cli_name()
    fresh = json.loads(json.dumps(DEFAULT_CONFIG))   # deep copy
    old = None
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH) as f:
                old = json.load(f)
        except (json.JSONDecodeError, OSError):
            old = None                               # unreadable -> treat as absent, still back up
    if old == fresh:
        print(f"Already in sync: {CONFIG_PATH} matches DEFAULT_CONFIG "
              f"({len(fresh.get('models', {}))} profiles).")
        return
    if os.path.exists(CONFIG_PATH):
        bak = CONFIG_PATH + ".bak"
        shutil.copyfile(CONFIG_PATH, bak)
        print(f"Backed up your old config to {bak}")
    save_config(fresh)
    oldm = set((old or {}).get("models", {}))
    newm = set(fresh.get("models", {}))
    added, removed = sorted(newm - oldm), sorted(oldm - newm)
    print(f"Synced {CONFIG_PATH} from DEFAULT_CONFIG ({len(newm)} profiles).")
    if added:
        print(f"  new profiles: {', '.join(added)}")
    if removed:
        print(f"  removed (were local-only or renamed): {', '.join(removed)}")
    _suggest([
        ("See the refreshed roster", f"{p} models"),
        ("Choose a device and model", f"{p} devices"),
    ])


def cmd_shell_init(args):
    """Append an `omm` alias for this script to the user's shell rc (idempotent)."""
    script = os.path.abspath(__file__)
    alias_line = f"alias omm='python3 {shlex.quote(script)}'"
    marker = "# omodel-manager alias (omm)"
    rc = os.path.expanduser("~/.bashrc")
    existing = open(rc).read() if os.path.exists(rc) else ""
    if marker in existing:
        print(f"Alias already installed in {rc}  (omm -> {script})")
        return
    if args.dry_run:
        print(f"Would append to {rc}:\n  {marker}\n  {alias_line}")
        return
    with open(rc, "a") as f:
        f.write(f"\n{marker}\n{alias_line}\n")
    print(f"Installed `omm` alias in {rc}.")
    print(f"  Activate now:  source {rc}   (or open a new shell)")


# ============================================================================
# CLI
# ============================================================================
def main():
    ap = argparse.ArgumentParser(
        prog="omodel-manager",
        description="Manage vLLM Docker containers from an editable config.")
    ap.add_argument("--version", action="version", version=f"omodel-manager {__version__}")
    ap.add_argument("--config", metavar="PATH",
                    help="config file (default: model_manager.json next to this script, "
                         "or $OMODEL_MANAGER_CONFIG). Must precede the subcommand.")
    sub = ap.add_subparsers(dest="cmd")

    # Shared --host option (--remote is a legacy alias) for commands that talk to docker.
    remote_parent = argparse.ArgumentParser(add_help=False)
    remote_parent.add_argument("--host", "--remote", dest="remote", metavar="ALIAS|USER@HOST",
                               help="target host over SSH: an alias from `install` (e.g. dgx1) or "
                                    "user@ip (default: config defaults.remote, else local)")

    p = sub.add_parser("ps", help="list running managed vLLM containers (default)",
                       parents=[remote_parent])
    p.add_argument("--all", action="store_true", help="also include other vllm/* containers")
    p.add_argument("--hosts", metavar="USER@HOST", action="append",
                   help="query these hosts over SSH (repeat for multiple; "
                        "default: every registered host, else local)")
    p.set_defaults(func=cmd_ps)

    for alias in ("models", "list"):
        p = sub.add_parser(alias, help="list unified card/node/cluster model profiles")
        p.add_argument("kind", nargs="?", choices=("card", "node", "cluster"),
                       help="show profiles compatible with this device kind")
        p.set_defaults(func=cmd_models)

    p = sub.add_parser("devices", help="list unified card/node/cluster devices")
    p.add_argument("kind", nargs="?", choices=("card", "node", "cluster"),
                   help="show only this device kind")
    p.set_defaults(func=cmd_devices)

    p = sub.add_parser("launch", help="launch MODEL on DEVICE (device first)")
    p.add_argument("device", nargs="?", metavar="DEVICE", help="device from `devices`")
    p.add_argument("model", nargs="?", metavar="MODEL", help="compatible profile from `models`")
    p.set_defaults(func=cmd_device_launch)

    p = sub.add_parser("plan", help="print a non-mutating launch plan for DEVICE MODEL")
    p.add_argument("device", metavar="DEVICE")
    p.add_argument("model", metavar="MODEL")
    p.set_defaults(func=cmd_plan)

    p = sub.add_parser("pull", help="pre-pull a profile's image so `launch` starts instantly",
                       parents=[remote_parent])
    p.add_argument("key", help="profile key from the config")
    p.set_defaults(func=cmd_pull)

    p = sub.add_parser("pull-status", help="show progress of a backgrounded launch/pull",
                       parents=[remote_parent])
    p.add_argument("key", nargs="?",
                   help="profile key, or a host (alias/user@ip) that's running/pulling one")
    p.set_defaults(func=cmd_pull_status)

    p = sub.add_parser("fetch", help="download a profile's declared assets (without launching)")
    p.add_argument("key", help="profile key from the config")
    p.add_argument("--refresh", action="store_true", help="re-download even if cached")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("stop", help="stop the deployment on DEVICE")
    p.add_argument("device", metavar="DEVICE")
    p.add_argument("--yes", "-y", action="store_true", help="skip confirmation")
    p.set_defaults(func=cmd_device_stop)

    p = sub.add_parser("logs", help="show/follow the deployment logs on DEVICE")
    p.add_argument("device", metavar="DEVICE")
    p.add_argument("role", nargs="?", choices=("head", "worker"), metavar="ROLE",
                   help="cluster rank (default: head)")
    p.add_argument("--follow", "-f", action="store_true", help="stream new logs")
    p.set_defaults(func=cmd_device_logs)

    p = sub.add_parser("health", help="check the deployment on DEVICE")
    p.add_argument("device", metavar="DEVICE")
    p.set_defaults(func=cmd_device_health)

    cluster = sub.add_parser("cluster", help="manage one model across two DGX Sparks")
    cluster_sub = cluster.add_subparsers(dest="cluster_cmd", required=True)

    p = cluster_sub.add_parser("profiles", help="list audited two-node model profiles")
    p.set_defaults(func=cmd_cluster_profiles)

    p = cluster_sub.add_parser("add", help="register a two-Spark cluster and its RoCE rails")
    p.add_argument("name", help="short cluster name")
    p.add_argument("head", help="registered head host alias, user@host, or IP")
    p.add_argument("worker", help="registered worker host alias, user@host, or IP")
    p.add_argument("--interface", action="append", required=True, metavar="IFACE",
                   help="RoCE interface present on both hosts (repeat per rail)")
    p.add_argument("--ucx-device", action="append", required=True, metavar="MLX5:PORT",
                   help="UCX RDMA device mapped to the interface, e.g. mlx5_0:1 (repeat per rail)")
    p.add_argument("--head-ip", action="append", required=True, metavar="IP",
                   help="head fabric IP for the corresponding rail (repeat per rail)")
    p.add_argument("--worker-ip", action="append", required=True, metavar="IP",
                   help="worker fabric IP for the corresponding rail (repeat per rail)")
    p.add_argument("--mtu", type=int, default=9000, choices=range(1500, 9001), metavar="1500..9000")
    p.add_argument("--force", action="store_true", help="replace an existing cluster definition")
    p.set_defaults(func=cmd_cluster_add)

    p = cluster_sub.add_parser("list", help="list configured clusters")
    p.set_defaults(func=cmd_cluster_list)

    p = cluster_sub.add_parser("show", help="show one cluster definition as JSON")
    p.add_argument("name")
    p.set_defaults(func=cmd_cluster_show)

    p = cluster_sub.add_parser("rename", help="rename a stopped cluster and its cached state")
    p.add_argument("name", help="current cluster name")
    p.add_argument("new_name", help="new cluster name")
    p.set_defaults(func=cmd_cluster_rename)

    p = cluster_sub.add_parser("remove", help="remove a cluster definition, preserving caches")
    p.add_argument("name")
    p.set_defaults(func=cmd_cluster_remove)

    p = cluster_sub.add_parser("preflight", help="validate management hosts and the exact RoCE fabric")
    p.add_argument("name")
    p.add_argument("--management-only", action="store_true",
                   help="skip cable/interface/RoCE gates; launch always requires them")
    p.set_defaults(func=cmd_cluster_preflight)

    p = cluster_sub.add_parser("prepare", help="stage reviewed runtime source, image, and weights")
    p.add_argument("name")
    p.add_argument("profile", choices=sorted(CLUSTER_PROFILES))
    p.add_argument("--build", action="store_true", help="build the pinned local runtime on both nodes")
    p.add_argument("--weights", action="store_true", help="download the exact official snapshot on both nodes")
    p.add_argument("--allow-busy", action="store_true",
                   help="permit heavy build/download while inference is active")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_cluster_prepare)

    p = sub.add_parser("install", aliases=["setup"],
                       help="bootstrap/register hosts and discover DGX cluster pairs")
    p.add_argument("target", nargs="?",
                   help="USER@HOST to install (default: this machine); comma-separate several "
                         "(a,b) when giving no alias. "
                          "Reachable hosts are saved to ~/.config/otools/hosts so `devices` and "
                          "device-first lifecycle commands find them; an identity-verified NVIDIA "
                          "Sync pair is registered automatically.")
    p.add_argument("alias", nargs="?",
                   help="short device name, e.g. dgx1 (then `launch dgx1 <model>`)")
    p.add_argument("--card", choices=("b70",),
                   help="also register the host's qualified card as ALIAS-b70")
    p.add_argument("--fix", action="store_true", help="remediate failures (installs docker, adds "
                                                      "docker group; remote setup also adds SSH keys)")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall",
                       help="unregister a host and revoke the otools key from it (--purge for more)")
    p.add_argument("target", help="alias or USER@HOST to remove (from `ps`/`install`)")
    p.add_argument("--purge", action="store_true",
                   help="also stop its otools containers and drop the remote docker-group membership")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("sync", help="reset model_manager.json from the committed DEFAULT_CONFIG "
                                    "(run after `git pull`; backs up a differing old file)")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("config", help="show/init/edit the config file")
    p.add_argument("--path", action="store_true", help="print the config path")
    p.add_argument("--init", action="store_true", help="write a fresh default config")
    p.add_argument("--edit", action="store_true", help="open in $EDITOR")
    p.add_argument("--force", action="store_true", help="overwrite on --init")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("shell-init", aliases=["install-aliases"],
                       help="add an `omm` shell alias for this script")
    p.add_argument("--dry-run", action="store_true", help="show what would change, don't write")
    p.set_defaults(func=cmd_shell_init)

    args = ap.parse_args()

    # Resolve the config path (global, since helpers read module-level CONFIG_PATH).
    global CONFIG_PATH, REMOTE
    if args.config:
        CONFIG_PATH = os.path.expanduser(args.config)

    # A bare host (alias / user@ip / IP) as the positional addresses the model running
    # on that box -- so `logs dgx-2` needs no model name (one model per host). Only when
    # no explicit --host/--remote was given, and only for the act-on-a-running-model cmds.
    HOST_ADDR = (cmd_logs, cmd_stop, cmd_health, cmd_pull_status)
    if getattr(args, "func", None) in HOST_ADDR and not getattr(args, "remote", None):
        for attr in ("target", "key"):
            if hasattr(args, attr):
                val = getattr(args, attr)
                if val and host_of(val):
                    args.remote = val                 # feeds the host resolution below
                    setattr(args, attr, None)         # command resolves the sole container on it
                break

    # For normal profiles the positional target is a host (same as --host). Cluster-only
    # profiles resolve it as a registered cluster inside cmd_launch instead.
    at_host = getattr(args, "host", None)
    if at_host:
        args.remote = at_host

    # Resolve the target host: explicit --host/--remote > config defaults.remote > local.
    # resolve_host() maps an alias to its user@host (a raw user@host passes through).
    chosen = getattr(args, "remote", None)
    if not chosen and os.path.exists(CONFIG_PATH):
        try:
            chosen = (load_config().get("defaults", {}) or {}).get("remote")
        except SystemExit:
            chosen = None
    REMOTE = resolve_host(chosen) if chosen else None

    if not args.cmd:
        # no subcommand -> friendly home screen (status + suggested next steps)
        cmd_home(argparse.Namespace())
        return
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Calm exit -- never dump a stack trace on Ctrl-C.
        print()
        sys.exit(130)
