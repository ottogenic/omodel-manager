            "files=sorted((root,f) for root in roots for f in root.rglob('*') if f.is_file() "
            "and '__pycache__' not in f.parts and f.suffix != '.pyc'); "
            "[(h.update(str(f.relative_to(root)).encode()),h.update(f.read_bytes())) "
            "for root,f in files]; "
            f"overlay={json.dumps(overlay_files)}; "
            "[(h.update(rel.encode()),h.update((p/rel).read_bytes())) for rel in overlay]; "
            "print(vllm.__version__,h.hexdigest())")
        result = _host_exec(target, ["docker", "run", "--rm", "--entrypoint", "python3",
                                     image, "-c", smoke], capture=True)
        if result.returncode != 0:
            return None, ((result.stdout or "") + (result.stderr or "")).strip()
        return result.stdout.strip(), ""
    overlay_files = [path[len("vllm/"):] for path in sorted(DEEPSEEK_VLLM_PREIMAGES)]
    overlay_files.append("model_executor/layers/fused_moe/experts/b12x_mxfp4_moe.py")
    smoke = (
        "import hashlib,pathlib,vllm,b12x,flashinfer; "
        "p=pathlib.Path(vllm.__file__).parent; "
        "assert vllm.__version__.startswith('0.26.0'); "
        "assert 'upstream guard downgraded' in (p/'config/speculative.py').read_text(); "
        "assert '\"nvfp4_ds_mla\",' in (p/'config/cache.py').read_text(); "
        "assert 'Skipping zero-token sparse prefill chunk' in "
        "(p/'models/deepseek_v4/nvidia/flashinfer_sparse.py').read_text(); "
        "assert 'active_topk_width' in (p/'models/deepseek_v4/sparse_mla.py').read_text(); "
        "assert 'skip_k_cache_insert' in (p/'models/deepseek_v4/attention.py').read_text(); "
        "assert '_get_c128_boundary' in (p/'models/deepseek_v4/compressor.py').read_text(); "
        "assert '_pad_to_supported_q_heads' in "
        "(p/'models/deepseek_v4/nvidia/flashinfer_sparse.py').read_text(); "
        "assert 'get_draft_quant_config' in "
        "(p/'v1/worker/gpu/spec_decode/dspark/utils.py').read_text(); "
        "h=hashlib.sha256(); "
        "roots=[pathlib.Path(b12x.__file__).parent,pathlib.Path(flashinfer.__file__).parent]; "
        "files=sorted((root,f) for root in roots for f in root.rglob('*') if f.is_file() "
        "and '__pycache__' not in f.parts and f.suffix != '.pyc'); "
        "[(h.update(str(f.relative_to(root)).encode()),h.update(f.read_bytes())) "
        "for root,f in files]; "
        f"overlay={json.dumps(overlay_files)}; "
        "[(h.update(rel.encode()),h.update((p/rel).read_bytes())) for rel in overlay]; "
        "print(vllm.__version__,h.hexdigest())")
    result = _host_exec(target, ["docker", "run", "--rm", "--entrypoint", "python3",
                                 image, "-c", smoke], capture=True)
    if result.returncode != 0:
        return None, ((result.stdout or "") + (result.stderr or "")).strip()
    return result.stdout.strip(), ""


def _deepseek_image_signature(target, image):
    image_format = "{{json .RootFS.Layers}}\n{{json .Config}}\n{{.Os}}/{{.Architecture}}"
    result = _host_exec(target, ["docker", "image", "inspect", "--format", image_format,
                                 image], capture=True)
    if result.returncode != 0:
        return None
    lines = result.stdout.splitlines()
    if len(lines) != 3:
        return None
    try:
        identity = {
            "layers": json.loads(lines[0]),
            "config": json.loads(lines[1]),
            "platform": lines[2],
        }
    except json.JSONDecodeError:
        return None
    canonical = json.dumps(identity, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(canonical).hexdigest()


def _deepseek_model_signature(target, profile):
    repo = profile["model"].replace("/", "--")
    snapshot = os.path.join(remote_home(target), ".cache", "huggingface", "hub",
                            f"models--{repo}", "snapshots", profile["revision"])
    script = '''
import hashlib, json, os, pathlib, sys
snapshot = pathlib.Path(sys.argv[1])
expected_files, expected_size, expected_shards = map(int, sys.argv[2:5])
repo = snapshot.parent.parent.resolve()
files = sorted(path for path in snapshot.rglob("*") if path.is_file())
if len(files) != expected_files:
    raise SystemExit(f"expected {expected_files} files, found {len(files)}")
shards = [path for path in files if path.name.startswith("model-") and path.suffix == ".safetensors"]
if len(shards) != expected_shards:
    raise SystemExit(f"expected {expected_shards} shards, found {len(shards)}")
aggregate = hashlib.sha256()
total = 0
for path in files:
    resolved = path.resolve()
    if os.path.commonpath((str(repo), str(resolved))) != str(repo):
        raise SystemExit(f"snapshot link escapes model repository: {path}")
    digest = hashlib.sha256()
    with open(resolved, "rb") as stream:
        for block in iter(lambda: stream.read(8 * 1024 * 1024), b""):
            digest.update(block)
    size = resolved.stat().st_size
    total += size
    aggregate.update(str(path.relative_to(snapshot)).encode())
    aggregate.update(b"\\0")
    aggregate.update(digest.digest())
if total != expected_size:
    raise SystemExit(f"expected {expected_size} bytes, found {total}")
print(json.dumps({"sha256": aggregate.hexdigest(), "files": len(files),
                  "shards": len(shards), "size": total}, sort_keys=True))
'''
    result = _host_exec_retry(target, ["python3", "-c", script, snapshot,
                                        profile["model_file_count"], profile["model_size"],
                                        profile["model_shards"]], capture=True)
    detail = ((result.stdout or "") + ("\n" + result.stderr if result.stderr else "")).strip()
    if result.returncode != 0:
        return None, detail
    try:
        return json.loads(result.stdout), ""
    except json.JSONDecodeError:
        return None, detail


def _deepseek_profile_fingerprint(profile):
    canonical = json.dumps(_deepseek_manifest_inputs(profile), sort_keys=True,
                           separators=(",", ":")).encode()
    return hashlib.sha256(canonical).hexdigest()


def _deepseek_certificate_path(target, profile):
    fingerprint = _deepseek_profile_fingerprint(profile)
    return os.path.join(remote_home(target), ".local", "share", "otools", "artifacts",
                        "deepseek", fingerprint, "certificate.json")


def _read_host_json(target, path):
    result = _host_exec(target, ["cat", path], capture=True)
    if result.returncode != 0:
        return None
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    return value if isinstance(value, dict) else None


def _write_host_json(target, path, value):
    body = json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n"
    script = ("import json,os,pathlib,sys,tempfile; p=pathlib.Path(sys.argv[1]); "
              "p.parent.mkdir(parents=True,exist_ok=True); "
              "fd,tmp=tempfile.mkstemp(prefix='.certificate-',dir=p.parent,text=True); "
              "os.write(fd,(sys.argv[2]+'\\n').encode()); os.close(fd); os.chmod(tmp,0o600); "
              "os.replace(tmp,p)")
    _host_exec_retry(target, ["python3", "-c", script, path, body.rstrip("\n")], check=True)


def _deepseek_snapshot_identity(target, profile):
    repo = profile["model"].replace("/", "--")
    snapshot = os.path.join(remote_home(target), ".cache", "huggingface", "hub",
                            f"models--{repo}", "snapshots", profile["revision"])
    script = '''
import hashlib, json, pathlib, sys
p=pathlib.Path(sys.argv[1]); files=sorted(x for x in p.rglob("*") if x.is_file())
shards=[x for x in files if x.name.startswith("model-") and x.suffix==".safetensors"]
metadata=hashlib.sha256()
for x in files:
    resolved=x.resolve(); stat=resolved.stat()
    metadata.update(str(x.relative_to(p)).encode()); metadata.update(b"\\0")
    metadata.update(str(resolved).encode()); metadata.update(b"\\0")
    metadata.update(str(stat.st_size).encode()); metadata.update(b"\\0")
    metadata.update(str(stat.st_mtime_ns).encode()); metadata.update(b"\\0")
print(json.dumps({"files":len(files),"shards":len(shards),
                  "size":sum(x.resolve().stat().st_size for x in files),
                  "metadata_sha256":metadata.hexdigest()},sort_keys=True))
'''
    result = _host_exec_retry(target, ["python3", "-c", script, snapshot], capture=True)
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def _deepseek_certificate_valid(target, profile, certificate):
    if not certificate or certificate.get("profile_fingerprint") != _deepseek_profile_fingerprint(profile):
        return False
    machine_id = _host_exec(target, ["cat", "/etc/machine-id"], capture=True)
    image_id = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                   profile["image"]], capture=True)
    if (machine_id.returncode != 0 or image_id.returncode != 0
            or certificate.get("machine_id") != machine_id.stdout.strip()
            or certificate.get("image_id") != image_id.stdout.strip()
            or (profile.get("image_signature")
                and certificate.get("image_signature") != profile["image_signature"])):
        return False
    identity = _deepseek_snapshot_identity(target, profile)
    expected = {"files": profile["model_file_count"], "shards": profile["model_shards"],
                "size": profile["model_size"]}
    return (identity and all(identity.get(key) == value for key, value in expected.items())
            and certificate.get("snapshot_identity") == identity
            and certificate.get("model_signature"))


def _certify_deepseek_node(target, role, profile):
    inspected = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                    profile["image"]], capture=True)
    if inspected.returncode != 0:
        raise RuntimeError(f"reviewed DeepSeek image is missing on {role}")
    image_signature = _deepseek_image_signature(target, profile["image"])
    if profile.get("image_signature") and image_signature != profile["image_signature"]:
        raise RuntimeError(f"reviewed DeepSeek image content mismatch on {role}")
    runtime_signature, detail = _deepseek_runtime_signature(target, profile["image"])
    if not runtime_signature:
        raise RuntimeError(f"DeepSeek runtime smoke failed on {role}: {detail}")
    model_signature, detail = _deepseek_model_signature(target, profile)
    if not model_signature:
        raise RuntimeError(f"DeepSeek model verification failed on {role}: {detail}")
    machine_id = _host_exec(target, ["cat", "/etc/machine-id"], capture=True, check=True)
    certificate = {
        "schema": 1,
        "profile_fingerprint": _deepseek_profile_fingerprint(profile),
        "machine_id": machine_id.stdout.strip(),
        "image_id": inspected.stdout.strip(),
        "image_signature": image_signature,
        "runtime_signature": runtime_signature,
        "model_signature": model_signature,
        "snapshot_identity": _deepseek_snapshot_identity(target, profile),
    }
    _write_host_json(target, _deepseek_certificate_path(target, profile), certificate)
    return role, certificate


def _transfer_deepseek_image(source, target, image):
    print(f"Copying reviewed DeepSeek image from {_host_label(source)} to {_host_label(target)} ...")
    save = "docker save %s | zstd -T0 -3" % shlex.quote(image)
    load = "zstd -dc | docker load"
    producer = subprocess.Popen(ssh_argv(source, batch=True) + [save], stdout=subprocess.PIPE)
    try:
        consumer = subprocess.run(ssh_argv(target, batch=True) + [load], stdin=producer.stdout)
    finally:
        if producer.stdout:
            producer.stdout.close()
    source_status = producer.wait()
    if source_status != 0 or consumer.returncode != 0:
        raise RuntimeError("reviewed DeepSeek image peer transfer failed")


def _find_deepseek_image_donor(profile, excluded):
    for _, target in load_hosts():
        if target in excluded:
            continue
        if _deepseek_image_signature(target, profile["image"]) == profile.get("image_signature"):
            return target
    return None


def _ensure_reviewed_base_image(cfg, profile):
    signature = profile.get("base_image_signature")
    if not signature:
        return
    head, worker = _cluster_targets(cfg)
    roles = {"head": head, "worker": worker}
    missing = [target for target in roles.values()
               if _deepseek_image_signature(target, profile["base_image"]) != signature]
    if not missing:
        return
    donor = next((target for target in roles.values() if target not in missing), None)
    if donor is None:
        excluded = set(roles.values())
        donor = next((target for _, target in load_hosts()
                      if target not in excluded
                      and _deepseek_image_signature(target, profile["base_image"]) == signature),
                     None)
    if donor is None:
        raise RuntimeError("certified DeepSeek base image is unavailable on registered hosts")
    for target in missing:
        _transfer_deepseek_image(donor, target, profile["base_image"])
        if _deepseek_image_signature(target, profile["base_image"]) != signature:
            raise RuntimeError("transferred DeepSeek base image content mismatch")


def _ensure_deepseek_deployment(cfg, profile):
    head, worker = _cluster_targets(cfg)
    roles = {"head": head, "worker": worker}
    expected_snapshot = {"files": profile["model_file_count"],
                         "shards": profile["model_shards"], "size": profile["model_size"]}
    missing_weights = []
    for target in roles.values():
        identity = _deepseek_snapshot_identity(target, profile)
        if not identity or any(identity.get(key) != value
                               for key, value in expected_snapshot.items()):
            missing_weights.append(target)
    if missing_weights:
        print("Downloading the pinned DeepSeek snapshot on missing nodes ...")
        selected = [(role, target) for role, target in roles.items()
                    if target in missing_weights]
        _download_cluster_snapshot(cfg, profile, profile["download_image"], "DeepSeek",
                                   roles=selected)
    missing = [target for target in roles.values()
               if _host_exec(target, ["docker", "image", "inspect", profile["image"]],
                             capture=True).returncode != 0]
    if missing:
        donor = next((target for target in roles.values() if target not in missing
                      and _deepseek_image_signature(target, profile["image"])
                      == profile.get("image_signature")), None)
        donor = donor or _find_deepseek_image_donor(profile, set(roles.values()))
        if not donor:
            raise RuntimeError("reviewed DeepSeek image is unavailable on registered hosts; "
                               "publish/pull the pinned image or run the reviewed source build")
        for target in missing:
            _transfer_deepseek_image(donor, target, profile["image"])

    certificates = {}
    stale = []
    for role, target in roles.items():
        certificate = _read_host_json(target, _deepseek_certificate_path(target, profile))
        if _deepseek_certificate_valid(target, profile, certificate):
            certificates[role] = certificate
        else:
            stale.append((role, target))
    if stale:
        print("Certifying DeepSeek runtime and exact model snapshot on "
              + ", ".join(role for role, _ in stale) + " ...")
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(stale)) as executor:
            futures = [executor.submit(_certify_deepseek_node, target, role, profile)
                       for role, target in stale]
            for future in concurrent.futures.as_completed(futures):
                role, certificate = future.result()
                certificates[role] = certificate
    if len({json.dumps(value["model_signature"], sort_keys=True)
            for value in certificates.values()}) != 1:
        raise RuntimeError("DeepSeek model snapshots differ between roles")
    if len({value["runtime_signature"] for value in certificates.values()}) != 1:
        raise RuntimeError("DeepSeek runtime contents differ between roles")
    root = _deepseek_build_dir(profile)
    os.makedirs(root, exist_ok=True)
    manifest = _deepseek_manifest_inputs(profile)
    manifest["built_images"] = {role: value["image_id"] for role, value in certificates.items()}
    manifest["image_signatures"] = {role: value["image_signature"]
                                    for role, value in certificates.items()}
    manifest["runtime_signatures"] = {role: value["runtime_signature"]
                                      for role, value in certificates.items()}
    manifest["model_signatures"] = {role: value["model_signature"]
                                    for role, value in certificates.items()}
    with open(os.path.join(root, "manifest.json"), "w") as stream:
        json.dump(manifest, stream, indent=2); stream.write("\n")
    return certificates


def _prepare_deepseek(cfg, profile, build=False, weights=False, dry=False):
    if profile.get("runtime_lane") == "c8r":
        context = _clone_reviewed_runtime(profile, dry=dry)
        if not dry:
            print(f"  reviewed source ready: {context}")
        if weights:
            _download_cluster_snapshot(cfg, profile, profile["download_image"], "DeepSeek", dry=dry)
        if not build:
            return
        if dry:
            print(f"  would certify resident full-source image {profile['image']} on both nodes")
            return
        _record_deepseek_runtime(cfg, profile)
        return
    context = _deepseek_runtime_context(profile, dry=dry) if build else _clone_reviewed_runtime(
        profile, dry=dry)
    if not dry:
        print(f"  reviewed source ready: {context}")
    if weights:
        _download_cluster_snapshot(cfg, profile, profile["download_image"], "DeepSeek", dry=dry)
    if not build:
        return
    if dry:
        print(f"  would build {profile['image']} with --network=none on both nodes")
        return

    _sync_cluster_files(cfg, context, "deepseek-runtime")
    head, worker = _cluster_targets(cfg)
    with open(os.path.join(context, "manifest.json")) as f:
        staged_manifest = json.load(f)
    for role, target in (("head", head), ("worker", worker)):
        remote_context = os.path.join(_cluster_state_dir(cfg["name"], target),
                                      "deepseek-runtime")
        verified = _verify_deepseek_context(target, remote_context)
        if verified != staged_manifest["context_sha256"]:
            raise RuntimeError(f"DeepSeek build context verification failed on {role}")
    if profile.get("base_image_signature"):
        _ensure_reviewed_base_image(cfg, profile)
    remote_contexts = {}
    for role, target in (("head", head), ("worker", worker)):
        if not profile.get("base_image_signature"):
            print(f"Pulling official DeepSeek base on {role} ({target or 'local'}) ...")
            if _host_exec(target, ["docker", "pull", profile["base_image"]]).returncode != 0:
                raise RuntimeError(f"official DeepSeek base pull failed on {role}")
        architecture = _host_exec(target, ["docker", "image", "inspect", "--format",
                                           "{{.Architecture}}", profile["base_image"]], capture=True)
        if architecture.returncode != 0 or architecture.stdout.strip() != "arm64":
            raise RuntimeError(f"official DeepSeek base architecture mismatch on {role}")
        remote_contexts[role] = os.path.join(_cluster_state_dir(cfg["name"], target),
                                             "deepseek-runtime")

    print(f"Building reviewed DeepSeek runtime once on head with network disabled ...")
    command = ["docker", "build", "--network=none", "--build-arg",
               f"VLLM_BASE={profile['base_image']}", "-t", profile["image"],
               remote_contexts["head"]]
    if _host_exec(head, command).returncode != 0:
        raise RuntimeError("DeepSeek runtime build failed on head")

    head_signature = _deepseek_image_signature(head, profile["image"])
    worker_signature = _deepseek_image_signature(worker, profile["image"])
    if not head_signature:
        raise RuntimeError("cannot record the head DeepSeek image signature")
    if worker_signature != head_signature:
        for role, target in (("head", head), ("worker", worker)):
            if _host_exec(target, ["zstd", "--version"], capture=True).returncode != 0:
                raise RuntimeError(f"zstd is required to distribute the reviewed image to {role}")
        print("Distributing the exact head image to worker ...")
        _transfer_deepseek_image(head, worker, profile["image"])
    else:
        print("Worker already has the head image's exact runtime layers and configuration.")

    built_images, image_signatures, runtime_signatures = {}, {}, {}
    for role, target in (("head", head), ("worker", worker)):
        inspected = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                        profile["image"]], capture=True)
        if inspected.returncode != 0:
            raise RuntimeError(f"cannot record DeepSeek runtime identity on {role}")
        signature, detail = _deepseek_runtime_signature(target, profile["image"])
        if not signature:
            raise RuntimeError(f"DeepSeek runtime smoke failed on {role}: {detail}")
        built_images[role] = inspected.stdout.strip()
        image_signatures[role] = _deepseek_image_signature(target, profile["image"])
        runtime_signatures[role] = signature

    if None in image_signatures.values() or len(set(image_signatures.values())) != 1:
        raise RuntimeError("DeepSeek runtime layers or image configuration differ between roles")
    if len(set(runtime_signatures.values())) != 1:
        raise RuntimeError("DeepSeek installed runtime contents differ between head and worker")
    model_signatures = {}
    for role, target in (("head", head), ("worker", worker)):
        print(f"Hashing exact DeepSeek snapshot on {role} ...")
        signature, detail = _deepseek_model_signature(target, profile)
        if not signature:
            raise RuntimeError(f"DeepSeek model verification failed on {role}: {detail}")
        model_signatures[role] = signature
    if len({json.dumps(value, sort_keys=True) for value in model_signatures.values()}) != 1:
        raise RuntimeError("DeepSeek model snapshots differ between head and worker")

    manifest_path = os.path.join(context, "manifest.json")
    with open(manifest_path) as f:
        manifest = json.load(f)
    manifest["built_images"] = built_images
    manifest["image_signatures"] = image_signatures
    manifest["runtime_signatures"] = runtime_signatures
    manifest["model_signatures"] = model_signatures
    with open(manifest_path, "w") as f:
        json.dump(manifest, f, indent=2); f.write("\n")
    for role, target in (("head", head), ("worker", worker)):
        machine_id = _host_exec_retry(
            target, ["cat", "/etc/machine-id"], capture=True, check=True)
        certificate = {
            "schema": 1,
            "profile_fingerprint": _deepseek_profile_fingerprint(profile),
            "machine_id": machine_id.stdout.strip(),
            "image_id": built_images[role],
            "image_signature": image_signatures[role],
            "runtime_signature": runtime_signatures[role],
            "model_signature": model_signatures[role],
            "snapshot_identity": _deepseek_snapshot_identity(target, profile),
        }
        _write_host_json(target, _deepseek_certificate_path(target, profile), certificate)
    print("DeepSeek runtime built and smoke-tested on both nodes; launch still requires fabric.")


def _deepseek_build_dir(profile):
    lane = profile.get("runtime_lane", "cand7")
    return os.path.join(CLUSTER_DATA_DIR, "builds", f"deepseek-v4-flash-0731-{lane}")


def _record_deepseek_runtime(cfg, profile):
    """Certify a c8r image built by the pinned upstream full-source kit."""
    head, worker = _cluster_targets(cfg)
    built_images, image_signatures, runtime_signatures = {}, {}, {}
    for role, target in (("head", head), ("worker", worker)):
        inspected = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                        profile["image"]], capture=True)
        if inspected.returncode != 0:
            raise RuntimeError(f"c8r image is missing on {role}; run the pinned full-source build")
        image_signature = _deepseek_image_signature(target, profile["image"])
        if image_signature != profile["image_signature"]:
            raise RuntimeError(f"c8r image content signature mismatch on {role}")
        runtime_signature, detail = _deepseek_runtime_signature(target, profile["image"])
        if not runtime_signature:
            raise RuntimeError(f"c8r runtime smoke failed on {role}: {detail}")
        built_images[role] = inspected.stdout.strip()
        image_signatures[role] = image_signature
        runtime_signatures[role] = runtime_signature
    if len(set(image_signatures.values())) != 1 or len(set(runtime_signatures.values())) != 1:
        raise RuntimeError("c8r runtime contents differ between head and worker")

    model_signatures = {}
    for role, target in (("head", head), ("worker", worker)):
        print(f"Hashing exact DeepSeek snapshot on {role} ...")
        signature, detail = _deepseek_model_signature(target, profile)
        if not signature:
            raise RuntimeError(f"DeepSeek model verification failed on {role}: {detail}")
        model_signatures[role] = signature
    if len({json.dumps(value, sort_keys=True) for value in model_signatures.values()}) != 1:
        raise RuntimeError("DeepSeek model snapshots differ between head and worker")

    for role, target in (("head", head), ("worker", worker)):
        machine_id = _host_exec(target, ["cat", "/etc/machine-id"], capture=True, check=True)
        certificate = {
            "schema": 1,
            "profile_fingerprint": _deepseek_profile_fingerprint(profile),
            "machine_id": machine_id.stdout.strip(),
            "image_id": built_images[role],
            "image_signature": image_signatures[role],
            "runtime_signature": runtime_signatures[role],
            "model_signature": model_signatures[role],
            "snapshot_identity": _deepseek_snapshot_identity(target, profile),
        }
        _write_host_json(target, _deepseek_certificate_path(target, profile), certificate)

    root = _deepseek_build_dir(profile)
    os.makedirs(root, exist_ok=True)
