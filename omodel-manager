def _default_config_path():
    """Config lives next to this script by default (so it's visible in the repo).
    Override with $OMODEL_MANAGER_CONFIG (or legacy $OTOOLS_MODEL_MANAGER_CONFIG) or --config."""
    env = (os.environ.get("OMODEL_MANAGER_CONFIG")
           or os.environ.get("OTOOLS_MODEL_MANAGER_CONFIG"))
    if env:
        return os.path.expanduser(env)
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(here, "model_manager.json")


