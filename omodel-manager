def _extract_mia_patches(archive_path, destination):
    """Extract regular files from the archive's checked-in patches/ tree only."""
    if os.path.isdir(destination):
        shutil.rmtree(destination)
    os.makedirs(destination)
    extracted = set()
    found = False
    with tarfile.open(archive_path, "r:gz") as archive:
        for member in archive.getmembers():
            name = member.name
            parts = name.split("/")
            if (name.startswith("/") or "\\" in name or any(
                    part in ("", ".", "..") for part in parts)):
                raise RuntimeError(f"unsafe MiaAI archive path: {name}")
            if member.issym() or member.islnk():
                raise RuntimeError(f"links are not allowed in the MiaAI archive: {name}")
            if not (member.isdir() or member.isfile()):
                raise RuntimeError(f"special files are not allowed in the MiaAI archive: {name}")
            if len(parts) < 2 or parts[1] != "patches":
                continue
            found = True
            relative_parts = parts[2:]
            if not relative_parts:
                continue
            relative = os.path.join(*relative_parts)
            if relative in extracted:
                raise RuntimeError(f"duplicate MiaAI patch archive path: {relative}")
            extracted.add(relative)
            target = os.path.join(destination, relative)
            if member.isdir():
                os.makedirs(target, exist_ok=True)
                continue
            os.makedirs(os.path.dirname(target), exist_ok=True)
            source = archive.extractfile(member)
            if source is None:
                raise RuntimeError(f"cannot read MiaAI patch archive member: {name}")
            with source, open(target, "wb") as output:
                shutil.copyfileobj(source, output)
            os.chmod(target, 0o755 if member.mode & 0o111 else 0o644)
    if not found or not extracted:
        raise RuntimeError("pinned MiaAI archive contains no patches/ tree")


