_SUPPRESS_INTERNAL_SUGGESTIONS = False


def _prog():
    return sys.argv[0]


def _cli_name():
    """Display name for suggested commands — always 'omm' so paths don't clutter output."""
    return "omm"


def _host_label(target):
    """A registered alias for this host if one exists, else the raw target -- so
    suggested commands read `--host dgx1`, not `--host user@ip`."""
    if not target:
        return target
    for alias, t in load_hosts():
        if t == target and alias != t:
            return alias
    return target


def _rsuf():
    """' --host X' (alias-preferred) if a remote is in play, else '' (for examples)."""
    return f" --host {_host_label(REMOTE)}" if REMOTE else ""


def _suggest(items, header="Next steps"):
    """items: list of (description, command-string). Prints a breadcrumb block."""
    if _SUPPRESS_INTERNAL_SUGGESTIONS:
        return
    items = [it for it in items if it]
    if not items:
        return
    print(f"\n{header}:")
    for desc, cmd in items:
        print(f"  - {desc}")
        print(f"      {cmd}")


def cmd_home(args):
    """First-run-friendly landing screen: status + suggested next steps. No docker calls."""
    cfg = load_config()
    models = cfg.get("models", {})
    p, setup_done = _cli_name(), os.path.exists(OTOOLS_SSH_KEY)
    print("otools_model_manager -- manage vLLM Docker containers (local or over SSH)\n")
    print("Status:")
    print(f"  config : {CONFIG_PATH}  ({len(models)} model profile(s))")
    print(f"  devices: {len(device_inventory())} available (run `{_cli_name()} devices`)")
    print(f"  setup  : {'done -- key ' + OTOOLS_SSH_KEY if setup_done else 'not run yet'}")
    host = REMOTE or "user@host"
    items = []
    if not setup_done:
        items.append(("Bootstrap + name a host (keyless SSH, docker, HF token)",
                      f"{p} install {host} dgx1 --fix"))
    items += [
        ("List available models", f"{p} models"),
        ("Choose a model for the local device", f"{p} launch local"),
        ("See what's running", f"{p} ps"),
    ]
    _suggest(items, header="Suggested next steps")


def load_hosts():
    """Registered remote hosts (managed by `install`). Returns a list of
    (alias, target) tuples, order-preserving. File format: one `alias<TAB>user@host`
    per line in ~/.config/otools/hosts; a bare `user@host` line has alias == itself.
    Blank lines and #-comments are ignored."""
    out = []
    try:
        with open(HOSTS_FILE) as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):
                    continue
                parts = ln.split(None, 1)          # first whitespace splits alias from target
                if len(parts) == 2:
                    out.append((parts[0], parts[1].strip()))
                else:
                    out.append((parts[0], parts[0]))
    except OSError:
        pass
    return out


def host_targets():
    """Just the user@host targets `ps` queries (aliases dropped)."""
    return [t for _, t in load_hosts()]


def resolve_host(name):
    """Map an alias to its user@host target; pass a raw user@host / unknown through
    unchanged (SSH surfaces a clear error if it's bogus)."""
    if not name:
        return name
    for alias, target in load_hosts():
        if name == alias:
            return target
    return name


def save_hosts(pairs):
    """Overwrite the hosts file. `pairs` items are (alias, target) tuples or bare
    `user@host` strings (alias defaults to the target). Dedup by target and alias, order-kept."""
    seen_targets, seen_aliases, uniq = set(), set(), []
    for p in pairs:
        alias, target = (p, p) if isinstance(p, str) else (p[0] or p[1], p[1])
        alias_key = str(alias).casefold()
        if target and target not in seen_targets and alias_key not in seen_aliases:
            seen_targets.add(target)
            seen_aliases.add(alias_key)
            uniq.append((alias, target))
    os.makedirs(os.path.dirname(HOSTS_FILE), exist_ok=True)
    with open(HOSTS_FILE, "w") as f:
        print("# omodel-manager remote hosts (managed by `install`).", file=f)
        print("# Format: `alias<TAB>user@host`  (or a bare `user@host`). Safe to hand-edit.", file=f)
        for alias, target in uniq:
            print(target if alias == target else "%s\t%s" % (alias, target), file=f)


def _load_versioned_registry(path, field, contract):
    """Read one of the public v1 JSON contracts. Missing files are empty."""
    try:
        with open(path) as f:
            body = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as e:
        print(f"ERROR: could not read {contract} registry {path}: {e}", file=sys.stderr)
        sys.exit(1)
    if not isinstance(body, dict) or body.get("version") != 1:
        print(f"ERROR: {contract} registry {path} must be a version 1 JSON object.",
              file=sys.stderr)
        sys.exit(1)
    records = body.get(field, {})
    if not isinstance(records, dict):
        print(f"ERROR: malformed {contract} registry {path}: '{field}' must be an object.",
              file=sys.stderr)
        sys.exit(1)
    if _has_secret_field(records):
        print(f"ERROR: {contract} registry {path} contains a secret field.", file=sys.stderr)
        sys.exit(1)
    return records


def _has_secret_field(value):
    if isinstance(value, dict):
        for key, child in value.items():
            normalized = str(key).lower().replace("-", "_")
            if (normalized in ("token", "password", "secret", "private_key", "api_key")
                    or normalized.endswith(("_token", "_password", "_secret"))):
                return True
            if _has_secret_field(child):
                return True
    elif isinstance(value, list):
        return any(_has_secret_field(item) for item in value)
    return False


def _save_versioned_registry(path, field, records, contract):
    """Atomically replace a v1 registry with owner-only permissions."""
    if not isinstance(records, dict):
        raise TypeError(f"{field} must be a dict")
    if _has_secret_field(records):
        raise ValueError(f"{contract} registry cannot contain secret fields")
    parent = os.path.dirname(path) or "."
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{field}-", dir=parent, text=True)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({"$otools": contract, "version": 1, field: records}, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass


def load_devices(path=None):
    return _load_versioned_registry(path or DEVICES_FILE, "devices", "model_devices")


def save_devices(devices, path=None):
    _save_versioned_registry(path or DEVICES_FILE, "devices", devices, "model_devices")


def _device_collision(name, existing):
    print(f"ERROR: device name '{name}' conflicts case-insensitively with "
          f"'{existing['name']}'. Device names must be globally unambiguous.", file=sys.stderr)
    sys.exit(1)


def device_inventory(kind=None):
    """Normalized card/node/cluster inventory, including legacy host registries."""
    by_fold = {}

    def add(name, record, override=False):
        if not isinstance(name, str) or not name.strip():
            print("ERROR: every device needs a non-empty string name.", file=sys.stderr)
            sys.exit(1)
        name = name.strip()
        folded = name.casefold()
        current = by_fold.get(folded)
        if current and not override:
            _device_collision(name, current)
        base = current if current and override else {}
        if not isinstance(record, dict):
            print(f"ERROR: device '{name}' must be a JSON object.", file=sys.stderr)
            sys.exit(1)
        merged = _deep_merge(base, record)
        merged["name"] = current["name"] if current and override else name
        if folded == "local":
            merged["kind"] = "node"
        elif folded == "b70":
            merged["kind"] = "card"
        if merged.get("kind") not in ("card", "node", "cluster"):
            print(f"ERROR: device '{name}' has invalid kind '{merged.get('kind')}'.",
                  file=sys.stderr)
            sys.exit(1)
        if merged["kind"] in ("card", "node"):
            target = merged.get("target")
            merged["target"] = (None if target in (None, "local", "localhost")
                                else resolve_host(target))
        if merged["kind"] == "cluster":
            head_value, worker_value = merged.get("head"), merged.get("worker")
            merged["members"] = [head_value, worker_value]
            merged["member_targets"] = [
                None if value in (None, "local", "localhost") else resolve_host(value)
                for value in (head_value, worker_value)
            ]
        by_fold[folded] = merged

    add("local", {"kind": "node", "target": None, "builtin": True})
    add("b70", {"kind": "card", "target": "local", "hardware": "intel-arc-pro-b70",
                "builtin": True})
    for alias, target in load_hosts():
        add(alias, {"kind": "node", "target": target, "source": "hosts"})
    for name, cfg in load_clusters().items():
        if not isinstance(cfg, dict):
            continue
        head_value, worker_value = cfg.get("head"), cfg.get("worker")
        record = dict(cfg)
        record.update({"kind": "cluster", "target": name,
                       "head": head_value, "worker": worker_value,
                       "members": [head_value, worker_value],
                       "member_targets": [
                           None if value in ("local", "localhost") else resolve_host(value)
                           for value in (head_value, worker_value)
                       ], "source": "clusters"})
        add(name, record)
    explicit = load_devices()
    seen_explicit = set()
    for name, record in explicit.items():
        folded = name.casefold() if isinstance(name, str) else name
        if folded in seen_explicit:
            _device_collision(name, by_fold[folded])
        seen_explicit.add(folded)
        add(name, record, override=True)
    records = {record["name"]: record for record in by_fold.values()
               if kind is None or record["kind"] == kind}
    return dict(sorted(records.items(), key=lambda item: item[0].casefold()))


def resolve_device(name):
    if not name:
        return None
    matches = [record for record in device_inventory().values()
               if record["name"].casefold() == name.casefold()]
    if not matches:
        available = ", ".join(device_inventory())
        print(f"ERROR: unknown device '{name}'. Available: {available or '(none)'}.\n"
              f"Run `{_cli_name()} devices` to inspect devices.", file=sys.stderr)
        sys.exit(1)
    return matches[0]


def profile_inventory(kind=None):
    """One row per profile key, with all compatible device kinds attached."""
    profiles = {}

    def add(key, profile_kind, details):
        row = profiles.setdefault(key, {"key": key, "kinds": [], "variants": {}})
        if profile_kind not in row["kinds"]:
            row["kinds"].append(profile_kind)
        row["variants"][profile_kind] = details
        for field in ("served_model", "model_config", "port", "status", "backend",
                      "hardware", "context", "users", "tok_s", "usecase"):
            if field not in row and field in details:
                row[field] = details[field]

    def model_config(profile_kind, *identities):
        root = os.path.join(CONFIGS_DIR, profile_kind)
        candidates = []
        for current, _, files in os.walk(root):
            for filename in sorted(files):
                if not filename.endswith(".toml"):
                    continue
                path = os.path.join(current, filename)
                with open(path, "rb") as stream:
                    declared = tomllib.load(stream).get("match") or []
                if not isinstance(declared, list):
                    declared = [declared]
                candidates.append((
                    os.path.relpath(path, CONFIGS_DIR).replace(os.sep, "/"),
                    {str(value).casefold() for value in declared},
                ))
        for identity in identities:
            if not identity:
                continue
            matches = [path for path, declared in candidates
                       if str(identity).casefold() in declared]
            if len(matches) == 1:
                return matches[0]
            if len(matches) > 1:
                raise RuntimeError(
                    f"profile identity {identity!r} resolves to multiple {profile_kind} "
                    f"model configs: {', '.join(matches)}"
                )
        joined = ", ".join(str(value) for value in identities if value)
        raise RuntimeError(
            f"profile identities [{joined}] resolve to no {profile_kind} model config"
        )

    cfg = load_config()
    for key in sorted(cfg.get("models", {})):
        entry = merge_model(cfg, key)
        va = entry.get("vllm_args", {})
        add(key, "node", {
            "served_model": va.get("served-model-name") or entry.get("model", key),
            "model_config": model_config(
                "node", key, va.get("served-model-name"), entry.get("model")),
            "port": entry.get("port", 8000),
            "status": entry.get("status", "validated"), "backend": "vllm-docker",
            "context": va.get("max-model-len") or entry.get("limit", {}).get("context"),
            "users": va.get("max-num-seqs", 1), "tok_s": entry.get("tok_s"),
            "usecase": entry.get("usecase", []),
        })
    for key in sorted(CLUSTER_PROFILES):
        entry = CLUSTER_PROFILES[key]
        add(key, "cluster", {
            "served_model": entry.get("served_model_name") or entry.get("model", key),
            "model_config": model_config(
                "cluster", key, entry.get("served_model_name"), entry.get("model")),
            "port": entry["port"],
            "status": entry["status"],
            "backend": entry["backend"], "context": entry.get("max_model_len"),
            "users": entry.get("max_num_seqs") or entry.get("max_batch_size", 1),
            "tok_s": entry.get("tok_s"),
            "usecase": entry.get("usecase", []),
        })
    add(CARD_PROFILE_KEY, "card", {
        "served_model": CARD_PROFILE_KEY,
        "model_config": model_config("card", CARD_PROFILE_KEY), "port": 8000,
        "status": "validated", "hardware": "intel-arc-pro-b70",
        "backend": "vllm-xpu-docker", "users": 1,
        "usecase": ["Reasoning", "Vision", "Agentic"],
    })
    for row in profiles.values():
        row["kinds"].sort(key=("card", "node", "cluster").index)
        row["kind"] = row["kinds"][0] if len(row["kinds"]) == 1 else None
    if kind:
        profiles = {key: row for key, row in profiles.items() if kind in row["kinds"]}
    return dict(sorted(profiles.items()))


def _host_machine_id(target):
    """Stable physical-host identity used to collapse aliases for the same machine."""
    if target is None:
        try:
            with open("/etc/machine-id") as f:
                return f.read().strip() or None
        except OSError:
            return None
    result = run_remote(target, "cat /etc/machine-id", capture=True, batch=True)
    return result.stdout.strip() if result.returncode == 0 and result.stdout.strip() else None


def _dedupe_host_targets(targets, machine_ids=None):
    """Keep the first connection path for each physical host, preserving unknown targets."""
    machine_ids = {} if machine_ids is None else machine_ids
    seen, unique = set(), []
    for target in targets:
        if target not in machine_ids:
            machine_ids[target] = _host_machine_id(target)
        machine_id = machine_ids[target]
        identity = ("machine", machine_id) if machine_id else ("target", target)
        if identity in seen:
            continue
        seen.add(identity)
        unique.append(target)
    return unique


