            "ucx_devices": args.ucx_device,
            "head_ips": args.head_ip,
            "worker_ips": args.worker_ip,
            "mtu": args.mtu,
        },
    }
    head, worker = _cluster_targets(dict(candidate, name=name))
    clusters[name] = candidate
    save_clusters(clusters)
    print(f"Saved cluster '{name}' to {CLUSTERS_FILE}.")
    print(f"  head   : {args.head} -> {head or 'local'}")
    print(f"  worker : {args.worker} -> {worker or 'local'}")
    print(f"  fabric : {', '.join(interfaces)} (MTU {args.mtu})")
    print(f"  UCX    : {', '.join(args.ucx_device)}")
    print(f"  rails  : {', '.join(args.head_ip)} <-> {', '.join(args.worker_ip)}")


