def _vllm_image_identity(target, profile, allow_unpinned=False):
    if (not allow_unpinned
            and not (profile.get("image_signature") or profile.get("image_signatures"))):
        raise RuntimeError("vLLM image content identity is not pinned")
    inspected = _host_exec(target, ["docker", "image", "inspect", profile["image"]],
                           capture=True)
    if inspected.returncode != 0:
        raise RuntimeError("pinned vLLM image is missing")
    try:
        metadata = json.loads(inspected.stdout)[0]
    except (IndexError, TypeError, json.JSONDecodeError) as e:
        raise RuntimeError("cannot parse pinned vLLM image metadata") from e
    if metadata.get("Architecture") != "arm64" or metadata.get("Os") != "linux":
        raise RuntimeError("pinned vLLM image is not Linux ARM64")
    if profile.get("base_image") is None and profile["image"] not in metadata.get("RepoDigests", []):
        raise RuntimeError("local vLLM image is not bound to the pinned registry digest")
    content = {
        "architecture": metadata.get("Architecture"),
        "os": metadata.get("Os"),
        "config": metadata.get("Config"),
        "rootfs": metadata.get("RootFS"),
    }
    content_sha256 = hashlib.sha256(
        json.dumps(content, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    expected_signatures = profile.get("image_signatures")
    if (not allow_unpinned
            and (profile.get("image_signature")
                 and content_sha256 != profile["image_signature"]
                 or expected_signatures and content_sha256 not in expected_signatures)):
        raise RuntimeError("pinned vLLM image content mismatch")
    version = _host_exec(target, [
        "docker", "run", "--rm", "--network", "none", "--entrypoint", "python3",
        profile["image"], "-c", "import vllm; print(vllm.__version__)",
    ], capture=True)
    if version.returncode != 0:
        detail = (version.stdout or version.stderr or "unavailable").strip()
        raise RuntimeError(f"unexpected vLLM runtime version: {detail}")
    actual_version = version.stdout.strip()
    if profile.get("vllm_version") and actual_version != profile["vllm_version"]:
        raise RuntimeError(f"unexpected vLLM runtime version: {actual_version}")
    identity = {"id": metadata.get("Id"), "content_sha256": content_sha256}
    if profile.get("base_image"):
        identity["vllm_version"] = actual_version
    return identity


