def cmd_cluster_preflight(args):
    cfg = cluster_config(args.name)
    ok, _ = cluster_preflight(cfg, require_fabric=not args.management_only)
    if not ok:
        sys.exit(1)


def cmd_cluster_prepare(args):
    cfg = cluster_config(args.name)
    profile = cluster_profile(args.profile)
    ok, _ = cluster_preflight(cfg, require_fabric=False)
    if not ok:
        sys.exit(1)
    head, worker = _cluster_targets(cfg)
    busy = {"head": _cluster_busy(head), "worker": _cluster_busy(worker)}
    heavy = args.build or args.weights
    if any(names is None for names in busy.values()):
        print("ERROR: cannot determine whether both nodes are idle; preparation is blocked.",
              file=sys.stderr)
        sys.exit(1)
    if heavy and not args.allow_busy and any(busy.values()):
        details = "; ".join(f"{role}: {', '.join(names)}" for role, names in busy.items() if names)
        print(f"ERROR: refusing heavy image/model preparation while inference is active ({details}). "
              "Stop those models or pass --allow-busy after assessing UMA/page-cache risk.",
              file=sys.stderr)
        sys.exit(1)
    print(f"Preparing '{args.profile}' for cluster '{args.name}' ...")
    if profile["backend"] == "trtllm-mpi":
        _prepare_qwen(cfg, profile, build=args.build, weights=args.weights, dry=args.dry_run)
    else:
        try:
            _prepare_deepseek(cfg, profile, build=args.build, weights=args.weights,
                              dry=args.dry_run)
        except (RuntimeError, subprocess.CalledProcessError, OSError) as e:
            print(f"ERROR: DeepSeek preparation failed: {e}", file=sys.stderr)
            sys.exit(1)
    print("Preparation stage complete.")


def _ensure_cluster_idle(cfg):
    head, worker = _cluster_targets(cfg)
    for role, target in (("head", head), ("worker", worker)):
        conflicts = _cluster_busy(target)
        if conflicts is None:
            print(f"ERROR: cannot query {role} {target}.", file=sys.stderr); sys.exit(1)
        if conflicts:
            print(f"ERROR: {role} is already serving {', '.join(conflicts)}. "
                  "A two-node model requires both Sparks exclusively.", file=sys.stderr)
            sys.exit(1)


def _qwen_snapshot_path(profile):
    repo = profile["model"].replace("/", "--")
    return f"/root/.cache/huggingface/hub/models--{repo}/snapshots/{profile['revision']}"


def _qwen_runtime_signature(target, image):
    command = ("sha256sum /opt/otools/trtllm-mn-entrypoint.sh; "
               "dpkg-query -W -f='${Version}\\n' openssh-server")
    result = _host_exec(target, ["docker", "run", "--rm", "--entrypoint", "sh",
                                 image, "-c", command], capture=True)
    return result.stdout.strip() if result.returncode == 0 else None


def _qwen_extra_config(profile):
    body = ("print_iter_log: false\nkv_cache_config:\n  dtype: auto\n"
            f"  free_gpu_memory_fraction: {profile['kv_free_fraction']}\n")
    if profile.get("disable_flashinfer_sampling"):
        body += "disable_flashinfer_sampling: true\n"
    if profile.get("conservative_fp4_startup"):
        return (body + "nvfp4_gemm_config:\n  allowed_backends:\n    - cublaslt\n"
                "enable_autotuner: false\ncuda_graph_config: null\n")
    return body + "cuda_graph_config:\n  enable_padding: true\n"


def _qwen_warmup_requests(profile):
    thinking = profile.get("reasoning_parser") == "deepseek-r1"
    temperature = 0.6 if thinking else 0
    max_tokens = 2048 if thinking else 512
    tool = {
        "type": "function",
        "function": {
            "name": "get_weather",
            "description": "Get current weather for a location",
            "parameters": {
                "type": "object",
                "properties": {"location": {"type": "string"}},
                "required": ["location"],
            },
        },
    }
    return [
        ("plain chat", 300, {
            "model": profile["model"],
            "messages": [{"role": "user", "content": "Reply with the single word ok."}],
            "max_tokens": 512 if thinking else 128,
            "temperature": temperature,
            **({"top_p": 0.95, "top_k": 20} if thinking else {}),
        }),
        ("tool parser", 600, {
            "model": profile["model"],
            "messages": [{"role": "user", "content": (
                "Call the function get_weather exactly once with location Tokyo. "
                "Do not call any other function and do not answer directly.")}],
            "tools": [tool],
            "tool_choice": "auto",
            "max_tokens": max_tokens,
            "temperature": temperature,
            **({"top_p": 0.95, "top_k": 20} if thinking else {}),
        }),
        ("streaming", 300, {
            "model": profile["model"],
            "messages": [{"role": "user", "content": "Write three short words."}],
            "max_tokens": 512 if thinking else 128,
            "temperature": temperature,
            **({"top_p": 0.95, "top_k": 20} if thinking else {}),
            "stream": True,
        }),
    ]


def _warm_qwen_cluster(head, profile):
    endpoint = f"http://127.0.0.1:{profile['port']}/v1/chat/completions"
    for label, timeout, payload in _qwen_warmup_requests(profile):
        print(f"Warming Qwen {label} path ...")
        ok, body = _host_text(head, [
            "curl", "--fail-with-body", "-sS", "--max-time", str(timeout),
            "-H", "Content-Type: application/json", "--data-binary",
            json.dumps(payload, separators=(",", ":")), endpoint,
        ])
        if not ok:
            raise RuntimeError(f"Qwen {label} warmup failed: {body[-500:].replace(chr(10), ' ')}")
        if payload.get("stream"):
            finish_seen = False
            done_seen = False
            for line in body.splitlines():
                if not line.startswith("data: "):
                    continue
                if line == "data: [DONE]":
                    done_seen = True
                    continue
                try:
                    event = json.loads(line[6:])
                except json.JSONDecodeError as e:
                    raise RuntimeError(f"Qwen {label} warmup returned invalid SSE: {e}") from e
                if event.get("error"):
                    raise RuntimeError(f"Qwen {label} warmup returned an error event")
                finish_seen = finish_seen or any(
                    choice.get("finish_reason") for choice in event.get("choices", []))
            if not done_seen or not finish_seen:
                raise RuntimeError(f"Qwen {label} warmup returned an incomplete stream")
            continue
        try:
            response = json.loads(body)
        except json.JSONDecodeError as e:
            raise RuntimeError(f"Qwen {label} warmup returned invalid JSON: {e}") from e
        choices = response.get("choices")
        if not isinstance(choices, list) or not choices:
            raise RuntimeError(f"Qwen {label} warmup returned no choices")
        if label == "tool parser":
            calls = choices[0].get("message", {}).get("tool_calls")
            if not isinstance(calls, list) or len(calls) != 1:
                raise RuntimeError("Qwen tool parser warmup did not emit exactly one tool call")
            function = calls[0].get("function", {})
            if function.get("name") != "get_weather":
                raise RuntimeError("Qwen tool parser warmup called the wrong function")
            try:
                arguments = json.loads(function.get("arguments", ""))
            except (TypeError, json.JSONDecodeError) as e:
                raise RuntimeError("Qwen tool parser warmup emitted invalid JSON arguments") from e
            if not isinstance(arguments, dict) or arguments.get("location") != "Tokyo":
                raise RuntimeError("Qwen tool parser warmup emitted incorrect arguments")


def _launch_qwen_cluster(profile_key, profile, cfg, dry=False, startup_timeout=1800):
    head, worker = _cluster_targets(cfg)
    if not dry:
        if not cluster_preflight(cfg, require_fabric=True)[0]:
            sys.exit(1)
        _ensure_cluster_idle(cfg)
    nodes = (("worker", worker), ("head", head))
    commands = []
    for role, target in nodes:
        name, argv = build_qwen_cluster_argv(profile_key, profile, cfg, role, target)
        commands.append((role, target, name, argv))
    if dry:
        print("--- DRY RUN: worker starts before head; live fabric preflight not performed ---")
        for role, target, _, argv in commands:
            print(f"\n# {role}")
            print(format_run(argv, target))
        return
    runtime_root = os.path.join(_cluster_state_dir(cfg["name"]), "qwen-runtime")
    current_inputs = _qwen_expected_manifest(profile)
    build_manifest = {}
    for manifest_path in (_qwen_manifest_path(runtime_root, profile),
                          os.path.join(runtime_root, "manifest.json")):
        try:
            with open(manifest_path) as f:
                candidate = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        if all(candidate.get(key) == value for key, value in current_inputs.items()):
            build_manifest = candidate
            break
    built_images = build_manifest.get("built_images", {})
    expected_signatures = build_manifest.get("runtime_signatures", {})
    if any(build_manifest.get(key) != value for key, value in current_inputs.items()):
        print("ERROR: Qwen build manifest does not match the current reviewed inputs; rebuild "
              "both nodes before launch.", file=sys.stderr)
        sys.exit(1)
    if set(built_images) != {"head", "worker"} or set(expected_signatures) != {"head", "worker"}:
        print("ERROR: reviewed Qwen build manifest is missing; rebuild both nodes before launch.",
              file=sys.stderr)
        sys.exit(1)
    signatures = {}
    for role, target, _, _ in commands:
        present = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                      profile["runtime_image"]], capture=True)
        if present.returncode != 0:
            print(f"ERROR: prepared runtime image missing on {role}; run `omm cluster prepare "
                  f"{cfg['name']} {profile_key} --build --weights` while both nodes are idle.",
                  file=sys.stderr)
            sys.exit(1)
        image_id = present.stdout.strip()
        if image_id != built_images[role]:
            print(f"ERROR: {role} runtime image ID does not match the reviewed build manifest; "
                  "rebuild before launch.", file=sys.stderr)
            sys.exit(1)
        signatures[role] = _qwen_runtime_signature(target, profile["runtime_image"])
        if not signatures[role]:
            print(f"ERROR: cannot verify prepared runtime contents on {role}.", file=sys.stderr)
            sys.exit(1)
        if signatures[role] != expected_signatures[role]:
            print(f"ERROR: {role} runtime contents do not match the reviewed build manifest; "
                  "rebuild before launch.", file=sys.stderr)
            sys.exit(1)
    if len(set(signatures.values())) != 1:
        print("ERROR: Qwen runtime contents differ between head and worker; rebuild both from "
              "the same pinned context before launch.", file=sys.stderr)
        sys.exit(1)
    for role, target, _, _ in commands:
        _drop_caches(target)
    started = []
    try:
        for role, target, name, argv in commands:
            print(f"Starting {role} container {name} on {target} ...")
            res = _host_exec(target, ["docker"] + argv)
            if res.returncode != 0:
                raise RuntimeError(f"{role} container failed")
            started.append((target, name))
        time.sleep(3)
        hostfile = os.path.join(_cluster_state_dir(cfg["name"]), "openmpi-hostfile")
        with open(hostfile, "w") as f:
            f.write(cfg["fabric"]["head_ips"][0] + "\n" + cfg["fabric"]["worker_ips"][0] + "\n")
        remote_hostfile = os.path.join(_cluster_state_dir(cfg["name"], head), "openmpi-hostfile")
        _copy_to_host(head, hostfile, remote_hostfile)
        head_name = _cluster_container_name(profile_key, cfg["name"], "head")
        _host_exec(head, ["docker", "cp", remote_hostfile,
                          f"{head_name}:/etc/openmpi-hostfile"], check=True)
        config_body = _qwen_extra_config(profile)
        config_local = os.path.join(_cluster_state_dir(cfg["name"]), "trtllm.yml")
        with open(config_local, "w") as f:
            f.write(config_body)
        config_remote = os.path.join(_cluster_state_dir(cfg["name"], head), "trtllm.yml")
        _copy_to_host(head, config_local, config_remote)
        _host_exec(head, ["docker", "cp", config_remote, f"{head_name}:/tmp/trtllm.yml"],
                   check=True)
        worker_ip = cfg["fabric"]["worker_ips"][0]
        for _ in range(15):
            ssh_ready = _host_exec(head, ["docker", "exec", head_name, "ssh",
                                           "-o", "BatchMode=yes", worker_ip, "true"],
                                   capture=True)
            if ssh_ready.returncode == 0:
                break
            time.sleep(2)
        else:
            raise RuntimeError("head container cannot reach worker SSH over the fabric")
        parser_args = f" --tool_parser {shlex.quote(profile['tool_parser'])}"
        if profile.get("reasoning_parser"):
            parser_args += f" --reasoning_parser {shlex.quote(profile['reasoning_parser'])}"
        if profile.get("explicit_tokenizer"):
            parser_args += f" --tokenizer {shlex.quote(_qwen_snapshot_path(profile))}"
        serve = ("mpirun trtllm-llmapi-launch trtllm-serve serve " +
                 shlex.quote(profile["model"]) +
                 f" --revision {shlex.quote(profile['revision'])}" +
                 " --tp_size 2 --backend pytorch" +
                 f" --max_seq_len {int(profile['max_model_len'])}" +
                 f" --max_num_tokens {int(profile['max_num_tokens'])}" +
                 f" --max_batch_size {int(profile['max_batch_size'])}" +
                 (" --enable_chunked_prefill" if profile["enable_chunked_prefill"] else "") +
                 parser_args +
                 " --extra_llm_api_options /tmp/trtllm.yml" +
                 " --host 127.0.0.1" +
                 f" --port {int(profile['port'])} > /tmp/otools-serve.log 2>&1")
        res = _host_exec(head, ["docker", "exec", "-d", head_name, "sh", "-c", serve])
        if res.returncode != 0:
            raise RuntimeError("TRT-LLM MPI launch failed")
        time.sleep(5)
        alive = _host_exec(head, ["docker", "exec", head_name, "pgrep", "-f",
                                    "trtllm-serve"], capture=True)
        if alive.returncode != 0:
            raise RuntimeError("TRT-LLM serve process exited during startup")
        deadline = time.monotonic() + startup_timeout
        while time.monotonic() < deadline:
            alive = _host_exec(head, ["docker", "exec", head_name, "pgrep", "-f",
                                      "trtllm-serve"], capture=True)
            if alive.returncode != 0:
                raise RuntimeError("TRT-LLM serve process exited during model loading")
            healthy, _ = _host_text(head, ["curl", "-fsS", "--max-time", "5",
                                           f"http://127.0.0.1:{profile['port']}/health"])
            if healthy:
                break
            time.sleep(10)
        else:
            raise RuntimeError(f"TRT-LLM API did not become healthy within {startup_timeout}s")
        generated, detail = _host_text(head, ["curl", "-fsS", "--max-time", "300",
                                               f"http://127.0.0.1:{profile['port']}/health_generate"])
        if not generated:
            raise RuntimeError(f"TRT-LLM generation health check failed: {detail[-300:]}")
        serve_log = _host_exec(head, ["docker", "exec", head_name, "sh", "-c",
                                      "grep -q 'NET/IB' /tmp/otools-serve.log"], capture=True)
        if serve_log.returncode != 0:
            raise RuntimeError("TRT-LLM launch has no NCCL NET/IB evidence")
        _warm_qwen_cluster(head, profile)
    except (RuntimeError, subprocess.CalledProcessError, OSError, KeyboardInterrupt) as e:
        reason = "launch interrupted" if isinstance(e, KeyboardInterrupt) else str(e)
        print(f"ERROR: {reason}; rolling back rank containers.", file=sys.stderr)
        diagnostic_name = _cluster_container_name(profile_key, cfg["name"], "head")
        diagnostic = _host_exec(head, ["docker", "exec", diagnostic_name, "sh", "-c",
                                      "tail -n 120 /tmp/otools-serve.log"], capture=True)
        diagnostic_body = ((diagnostic.stdout or "") + (diagnostic.stderr or "")).strip()
        if diagnostic_body:
            print("--- TRT-LLM launch diagnostics ---\n" + diagnostic_body, file=sys.stderr)
        cleanup_failures = []
        for target, name in reversed(started):
            try:
                removed = _host_exec(target, ["docker", "rm", "-f", name], capture=True)
                if removed.returncode != 0:
                    cleanup_failures.append(name)
            except OSError:
                cleanup_failures.append(name)
        if cleanup_failures:
            print("ERROR: rollback could not remove: " + ", ".join(cleanup_failures),
                  file=sys.stderr)
        if isinstance(e, KeyboardInterrupt):
            raise
        sys.exit(1)
    print(f"READY: '{profile_key}' passed generation, parser, streaming, and NCCL NET/IB "
          f"checks across '{cfg['name']}'; head API port {profile['port']}.")


