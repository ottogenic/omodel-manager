def cmd_cluster_rename(args):
    cfg = cluster_config(args.name)
    old_name = cfg["name"]
    new_name = _safe_cluster_name(args.new_name, "new cluster name")
    clusters = load_clusters()
    if any(name.casefold() == new_name.casefold() for name in clusters):
        print(f"ERROR: cluster '{new_name}' already exists.", file=sys.stderr)
        sys.exit(1)
    head, worker = _cluster_targets(cfg)
    for role, target in (("head", head), ("worker", worker)):
        ok, running = _host_text(target, ["docker", "ps", "-a", "-q", "--filter",
                                         f"label={LABEL_CLUSTER}={old_name}"])
        if not ok:
            print(f"ERROR: cannot check {role} before renaming the cluster.", file=sys.stderr)
            sys.exit(1)
        if running:
            print(f"ERROR: stop cluster '{old_name}' before renaming it.", file=sys.stderr)
            sys.exit(1)
    old_local = _cluster_state_dir(old_name)
    new_local = _cluster_state_dir(new_name)
    if os.path.exists(new_local):
        print(f"ERROR: cached state already exists for '{new_name}'.", file=sys.stderr)
        sys.exit(1)
    for target in (head, worker):
        if target is None:
            continue
        old_remote = _cluster_state_dir(old_name, target)
        new_remote = _cluster_state_dir(new_name, target)
        if _host_exec(target, ["test", "-e", old_remote], capture=True).returncode != 0:
            continue
        if _host_exec(target, ["test", "!", "-e", new_remote], capture=True).returncode != 0:
            print(f"ERROR: cached state already exists for '{new_name}' on {target or 'local'}.",
                  file=sys.stderr)
            sys.exit(1)
        _host_exec(target, ["mkdir", "-p", os.path.dirname(new_remote)], check=True)
        result = _host_exec(target, ["mv", old_remote, new_remote], capture=True)
        if result.returncode != 0:
            print(f"ERROR: could not rename cached state on {target or 'local'}.", file=sys.stderr)
            sys.exit(1)
    if os.path.exists(old_local):
        os.makedirs(os.path.dirname(new_local), exist_ok=True)
        os.replace(old_local, new_local)
    clusters[new_name] = clusters.pop(old_name)
    save_clusters(clusters)
    print(f"Renamed cluster '{old_name}' to '{new_name}'.")


