def cmd_cluster_add(args):
    name = _safe_cluster_name(args.name)
    if args.head not in ("local", "localhost") and not host_of(args.head):
        print(f"ERROR: head '{args.head}' is not a registered host alias/user@host/IP.",
              file=sys.stderr)
        sys.exit(1)
    if args.worker not in ("local", "localhost") and not host_of(args.worker):
        print(f"ERROR: worker '{args.worker}' is not a registered host alias/user@host/IP.",
              file=sys.stderr)
        sys.exit(1)
    interfaces = args.interface
    for value in interfaces:
        _safe_net_name(value)
    for value in args.ucx_device:
        _safe_ucx_device(value)
    for value in args.head_ip + args.worker_ip:
        _safe_ip(value)
    if not (len(interfaces) == len(args.ucx_device) == len(args.head_ip) == len(args.worker_ip)):
        print("ERROR: repeat --interface, --ucx-device, --head-ip, and --worker-ip "
              "the same number of times.",
              file=sys.stderr)
        sys.exit(1)
    clusters = load_clusters()
    if name in clusters and not args.force:
        print(f"ERROR: cluster '{name}' already exists; use --force to replace it.",
              file=sys.stderr)
        sys.exit(1)
    candidate = {
        "head": args.head,
        "worker": args.worker,
        "fabric": {
