def _prepare_cluster_key(cfg, dry=False):
    root = _cluster_state_dir(cfg["name"])
    ssh_dir = os.path.join(root, "ssh")
    key = os.path.join(ssh_dir, "id_ed25519")
    if dry:
        print(f"  would create deployment-specific MPI key: {key}")
        return
    os.makedirs(ssh_dir, exist_ok=True)
    if not os.path.exists(key):
        subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "", "-f", key,
                        "-C", f"omodel-cluster-{cfg['name']}"], check=True)
    pub = open(key + ".pub").read().strip()
    auth = os.path.join(ssh_dir, "authorized_keys")
    with open(auth, "w") as f:
        f.write(pub + "\n")
    for path, mode in ((key, 0o600), (key + ".pub", 0o644), (auth, 0o600)):
        os.chmod(path, mode)


def _clone_reviewed_runtime(profile, dry=False):
    commit = profile["runtime_revision"]
    root = os.path.join(CLUSTER_DATA_DIR, "sources", f"deepseek-v4-flash-{commit}")
    if dry:
        print(f"  would clone {profile['runtime_repo']} at {commit} -> {root}")
        return root
    os.makedirs(os.path.dirname(root), exist_ok=True)
    if not os.path.isdir(os.path.join(root, ".git")):
        subprocess.run(["git", "clone", "--no-checkout", profile["runtime_repo"], root],
                       check=True)
    subprocess.run(["git", "-C", root, "fetch", "--depth=1", "origin", commit], check=True)
    subprocess.run(["git", "-C", root, "checkout", "--detach", commit], check=True)
    head = subprocess.run(["git", "-C", root, "rev-parse", "HEAD"], text=True,
                          capture_output=True, check=True).stdout.strip()
    tree = subprocess.run(["git", "-C", root, "rev-parse", "HEAD^{tree}"], text=True,
                          capture_output=True, check=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", root, "status", "--porcelain"], text=True,
                           capture_output=True, check=True).stdout.strip()
    if head != commit or tree != profile["runtime_tree"] or dirty:
        print("ERROR: reviewed DeepSeek runtime checkout is not the expected clean commit.",
              file=sys.stderr)
        sys.exit(1)
    lane = profile.get("runtime_lane")
    if lane == "c8r":
        kit = subprocess.run(
            ["git", "-C", root, "rev-parse", "HEAD:patches/vllm-0261-main-c8r"],
            text=True, capture_output=True, check=True).stdout.strip()
        overlay = subprocess.run(
            ["git", "-C", root, "rev-parse",
             "HEAD:patches/vllm-0261-main-c8r/overlay0261"],
            text=True, capture_output=True, check=True).stdout.strip()
        if kit != profile["runtime_kit_tree"] or overlay != profile["runtime_overlay_tree"]:
            print("ERROR: reviewed DeepSeek c8r kit does not match its pinned trees.",
                  file=sys.stderr)
            sys.exit(1)
    elif lane == "smpcache":
        for relative, expected in profile["runtime_patch_trees"].items():
            tree = subprocess.run(
                ["git", "-C", root, "rev-parse", f"HEAD:{relative}"], text=True,
                capture_output=True, check=True).stdout.strip()
            if tree != expected:
                print(f"ERROR: reviewed DeepSeek patch kit changed: {relative}", file=sys.stderr)
                sys.exit(1)
        for relative, metadata in profile["runtime_files"].items():
            if _sha256_file(os.path.join(root, relative)) != metadata["sha256"]:
                print(f"ERROR: reviewed DeepSeek runtime file changed: {relative}", file=sys.stderr)
                sys.exit(1)
    else:
        patch = os.path.join(root, "patches", "vllm-026-rebase", "gx10-overlay-026.patch")
        if _sha256_file(patch) != profile["runtime_patch_sha256"]:
            print("ERROR: reviewed DeepSeek vLLM patch does not match its pinned digest.",
                  file=sys.stderr)
            sys.exit(1)
    manifest = {
        "repository": profile["runtime_repo"],
        "commit": commit,
        "tree": tree,
        "lane": profile.get("runtime_lane", "cand7"),
        "model": profile["model"],
        "model_revision": profile["revision"],
        "model_file_count": profile["model_file_count"],
        "model_size": profile["model_size"],
        "model_shards": profile["model_shards"],
        "audit": "source reviewed; build and hardware qualification still required",
    }
    manifest_path = root + "-manifest.json"
    with open(manifest_path, "w") as f:
        json.dump(manifest, f, indent=2); f.write("\n")
    return root


def _download_verified_source(url, path, expected_sha256):
    if os.path.isfile(path) and _sha256_file(path) == expected_sha256:
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    error = None
    for attempt in range(3):
        fd, tmp = tempfile.mkstemp(prefix=".source-", dir=os.path.dirname(path))
        os.close(fd)
        try:
            request = urllib.request.Request(url, headers={"User-Agent": "omodel-manager/0.3"})
            with urllib.request.urlopen(request, timeout=120) as response, open(tmp, "wb") as out:
                shutil.copyfileobj(response, out)
            actual = _sha256_file(tmp)
            if actual != expected_sha256:
                raise RuntimeError(f"source archive hash mismatch: expected {expected_sha256}, got {actual}")
            os.replace(tmp, path)
            return
        except (OSError, urllib.error.URLError, RuntimeError) as exc:
            error = exc
            try:
                os.remove(tmp)
            except OSError:
                pass
            if attempt < 2:
                time.sleep(2 ** attempt)
    raise RuntimeError(f"failed to acquire reviewed source {url}: {error}")


