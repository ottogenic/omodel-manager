def _qwen_warmup_requests(profile):
    thinking = profile.get("reasoning_parser") == "deepseek-r1"
    temperature = 0.6 if thinking else 0
    max_tokens = 2048 if thinking else 512
    tool = {
        "type": "function",
        "function": {
            "name": "get_weather",
            "description": "Get current weather for a location",
            "parameters": {
                "type": "object",
                "properties": {"location": {"type": "string"}},
                "required": ["location"],
            },
        },
    }
    return [
        ("plain chat", 300, {
            "model": profile["model"],
            "messages": [{"role": "user", "content": "Reply with the single word ok."}],
            "max_tokens": 512 if thinking else 128,
            "temperature": temperature,
            **({"top_p": 0.95, "top_k": 20} if thinking else {}),
        }),
        ("tool parser", 600, {
            "model": profile["model"],
            "messages": [{"role": "user", "content": (
                "Call the function get_weather exactly once with location Tokyo. "
                "Do not call any other function and do not answer directly.")}],
            "tools": [tool],
            "tool_choice": "auto",
            "max_tokens": max_tokens,
            "temperature": temperature,
            **({"top_p": 0.95, "top_k": 20} if thinking else {}),
        }),
        ("streaming", 300, {
            "model": profile["model"],
            "messages": [{"role": "user", "content": "Write three short words."}],
            "max_tokens": 512 if thinking else 128,
            "temperature": temperature,
            **({"top_p": 0.95, "top_k": 20} if thinking else {}),
            "stream": True,
        }),
    ]


def _warm_qwen_cluster(head, profile):
    endpoint = f"http://127.0.0.1:{profile['port']}/v1/chat/completions"
    for label, timeout, payload in _qwen_warmup_requests(profile):
        print(f"Warming Qwen {label} path ...")
        ok, body = _host_text(head, [
            "curl", "--fail-with-body", "-sS", "--max-time", str(timeout),
            "-H", "Content-Type: application/json", "--data-binary",
            json.dumps(payload, separators=(",", ":")), endpoint,
        ])
        if not ok:
            raise RuntimeError(f"Qwen {label} warmup failed: {body[-500:].replace(chr(10), ' ')}")
        if payload.get("stream"):
            finish_seen = False
            done_seen = False
            for line in body.splitlines():
                if not line.startswith("data: "):
                    continue
                if line == "data: [DONE]":
                    done_seen = True
                    continue
                try:
                    event = json.loads(line[6:])
                except json.JSONDecodeError as e:
                    raise RuntimeError(f"Qwen {label} warmup returned invalid SSE: {e}") from e
                if event.get("error"):
                    raise RuntimeError(f"Qwen {label} warmup returned an error event")
                finish_seen = finish_seen or any(
                    choice.get("finish_reason") for choice in event.get("choices", []))
            if not done_seen or not finish_seen:
                raise RuntimeError(f"Qwen {label} warmup returned an incomplete stream")
            continue
        try:
            response = json.loads(body)
        except json.JSONDecodeError as e:
            raise RuntimeError(f"Qwen {label} warmup returned invalid JSON: {e}") from e
        choices = response.get("choices")
        if not isinstance(choices, list) or not choices:
            raise RuntimeError(f"Qwen {label} warmup returned no choices")
        if label == "tool parser":
            calls = choices[0].get("message", {}).get("tool_calls")
            if not isinstance(calls, list) or len(calls) != 1:
                raise RuntimeError("Qwen tool parser warmup did not emit exactly one tool call")
            function = calls[0].get("function", {})
            if function.get("name") != "get_weather":
                raise RuntimeError("Qwen tool parser warmup called the wrong function")
            try:
                arguments = json.loads(function.get("arguments", ""))
            except (TypeError, json.JSONDecodeError) as e:
                raise RuntimeError("Qwen tool parser warmup emitted invalid JSON arguments") from e
            if not isinstance(arguments, dict) or arguments.get("location") != "Tokyo":
                raise RuntimeError("Qwen tool parser warmup emitted incorrect arguments")


def _launch_qwen_cluster(profile_key, profile, cfg, dry=False, startup_timeout=1800):
    head, worker = _cluster_targets(cfg)
    if not dry:
        if not cluster_preflight(cfg, require_fabric=True)[0]:
            sys.exit(1)
        _ensure_cluster_idle(cfg)
    nodes = (("worker", worker), ("head", head))
    commands = []
    for role, target in nodes:
        name, argv = build_qwen_cluster_argv(profile_key, profile, cfg, role, target)
        commands.append((role, target, name, argv))
    if dry:
        print("--- DRY RUN: worker starts before head; live fabric preflight not performed ---")
        for role, target, _, argv in commands:
            print(f"\n# {role}")
            print(format_run(argv, target))
        return
    runtime_root = os.path.join(_cluster_state_dir(cfg["name"]), "qwen-runtime")
    current_inputs = _qwen_expected_manifest(profile)
    build_manifest = {}
    for manifest_path in (_qwen_manifest_path(runtime_root, profile),
                          os.path.join(runtime_root, "manifest.json")):
        try:
            with open(manifest_path) as f:
                candidate = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        if all(candidate.get(key) == value for key, value in current_inputs.items()):
            build_manifest = candidate
            break
    built_images = build_manifest.get("built_images", {})
    expected_signatures = build_manifest.get("runtime_signatures", {})
    if any(build_manifest.get(key) != value for key, value in current_inputs.items()):
        print("ERROR: Qwen build manifest does not match the current reviewed inputs; rebuild "
              "both nodes before launch.", file=sys.stderr)
        sys.exit(1)
    if set(built_images) != {"head", "worker"} or set(expected_signatures) != {"head", "worker"}:
        print("ERROR: reviewed Qwen build manifest is missing; rebuild both nodes before launch.",
              file=sys.stderr)
        sys.exit(1)
    signatures = {}
    for role, target, _, _ in commands:
        present = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                      profile["runtime_image"]], capture=True)
        if present.returncode != 0:
            print(f"ERROR: prepared runtime image missing on {role}; run `omm cluster prepare "
                  f"{cfg['name']} {profile_key} --build --weights` while both nodes are idle.",
                  file=sys.stderr)
            sys.exit(1)
        image_id = present.stdout.strip()
        if image_id != built_images[role]:
            print(f"ERROR: {role} runtime image ID does not match the reviewed build manifest; "
                  "rebuild before launch.", file=sys.stderr)
            sys.exit(1)
        signatures[role] = _qwen_runtime_signature(target, profile["runtime_image"])
        if not signatures[role]:
            print(f"ERROR: cannot verify prepared runtime contents on {role}.", file=sys.stderr)
            sys.exit(1)
        if signatures[role] != expected_signatures[role]:
            print(f"ERROR: {role} runtime contents do not match the reviewed build manifest; "
                  "rebuild before launch.", file=sys.stderr)
            sys.exit(1)
    if len(set(signatures.values())) != 1:
        print("ERROR: Qwen runtime contents differ between head and worker; rebuild both from "
              "the same pinned context before launch.", file=sys.stderr)
        sys.exit(1)
    for role, target, _, _ in commands:
        _drop_caches(target)
    started = []
    try:
        for role, target, name, argv in commands:
            print(f"Starting {role} container {name} on {target} ...")
            res = _host_exec(target, ["docker"] + argv)
            if res.returncode != 0:
                raise RuntimeError(f"{role} container failed")
            started.append((target, name))
        time.sleep(3)
        hostfile = os.path.join(_cluster_state_dir(cfg["name"]), "openmpi-hostfile")
        with open(hostfile, "w") as f:
            f.write(cfg["fabric"]["head_ips"][0] + "\n" + cfg["fabric"]["worker_ips"][0] + "\n")
        remote_hostfile = os.path.join(_cluster_state_dir(cfg["name"], head), "openmpi-hostfile")
        _copy_to_host(head, hostfile, remote_hostfile)
        head_name = _cluster_container_name(profile_key, cfg["name"], "head")
        _host_exec(head, ["docker", "cp", remote_hostfile,
                          f"{head_name}:/etc/openmpi-hostfile"], check=True)
        config_body = _qwen_extra_config(profile)
        config_local = os.path.join(_cluster_state_dir(cfg["name"]), "trtllm.yml")
        with open(config_local, "w") as f:
            f.write(config_body)
        config_remote = os.path.join(_cluster_state_dir(cfg["name"], head), "trtllm.yml")
        _copy_to_host(head, config_local, config_remote)
        _host_exec(head, ["docker", "cp", config_remote, f"{head_name}:/tmp/trtllm.yml"],
                   check=True)
        worker_ip = cfg["fabric"]["worker_ips"][0]
        for _ in range(15):
            ssh_ready = _host_exec(head, ["docker", "exec", head_name, "ssh",
                                           "-o", "BatchMode=yes", worker_ip, "true"],
                                   capture=True)
            if ssh_ready.returncode == 0:
                break
            time.sleep(2)
        else:
            raise RuntimeError("head container cannot reach worker SSH over the fabric")
        parser_args = f" --tool_parser {shlex.quote(profile['tool_parser'])}"
        if profile.get("reasoning_parser"):
            parser_args += f" --reasoning_parser {shlex.quote(profile['reasoning_parser'])}"
        if profile.get("explicit_tokenizer"):
            parser_args += f" --tokenizer {shlex.quote(_qwen_snapshot_path(profile))}"
        serve = ("mpirun trtllm-llmapi-launch trtllm-serve serve " +
                 shlex.quote(profile["model"]) +
                 f" --revision {shlex.quote(profile['revision'])}" +
                 " --tp_size 2 --backend pytorch" +
                 f" --max_seq_len {int(profile['max_model_len'])}" +
                 f" --max_num_tokens {int(profile['max_num_tokens'])}" +
                 f" --max_batch_size {int(profile['max_batch_size'])}" +
                 (" --enable_chunked_prefill" if profile["enable_chunked_prefill"] else "") +
                 parser_args +
                 " --extra_llm_api_options /tmp/trtllm.yml" +
                 " --host 127.0.0.1" +
                 f" --port {int(profile['port'])} > /tmp/otools-serve.log 2>&1")
        res = _host_exec(head, ["docker", "exec", "-d", head_name, "sh", "-c", serve])
        if res.returncode != 0:
            raise RuntimeError("TRT-LLM MPI launch failed")
        time.sleep(5)
        alive = _host_exec(head, ["docker", "exec", head_name, "pgrep", "-f",
                                    "trtllm-serve"], capture=True)
        if alive.returncode != 0:
            raise RuntimeError("TRT-LLM serve process exited during startup")
        deadline = time.monotonic() + startup_timeout
        while time.monotonic() < deadline:
            alive = _host_exec(head, ["docker", "exec", head_name, "pgrep", "-f",
                                      "trtllm-serve"], capture=True)
            if alive.returncode != 0:
                raise RuntimeError("TRT-LLM serve process exited during model loading")
            healthy, _ = _host_text(head, ["curl", "-fsS", "--max-time", "5",
                                           f"http://127.0.0.1:{profile['port']}/health"])
            if healthy:
                break
            time.sleep(10)
        else:
            raise RuntimeError(f"TRT-LLM API did not become healthy within {startup_timeout}s")
        generated, detail = _host_text(head, ["curl", "-fsS", "--max-time", "300",
                                               f"http://127.0.0.1:{profile['port']}/health_generate"])
        if not generated:
            raise RuntimeError(f"TRT-LLM generation health check failed: {detail[-300:]}")
        serve_log = _host_exec(head, ["docker", "exec", head_name, "sh", "-c",
                                      "grep -q 'NET/IB' /tmp/otools-serve.log"], capture=True)
        if serve_log.returncode != 0:
            raise RuntimeError("TRT-LLM launch has no NCCL NET/IB evidence")
        _warm_qwen_cluster(head, profile)
    except (RuntimeError, subprocess.CalledProcessError, OSError, KeyboardInterrupt) as e:
        reason = "launch interrupted" if isinstance(e, KeyboardInterrupt) else str(e)
        print(f"ERROR: {reason}; rolling back rank containers.", file=sys.stderr)
        diagnostic_name = _cluster_container_name(profile_key, cfg["name"], "head")
        diagnostic = _host_exec(head, ["docker", "exec", diagnostic_name, "sh", "-c",
                                      "tail -n 120 /tmp/otools-serve.log"], capture=True)
        diagnostic_body = ((diagnostic.stdout or "") + (diagnostic.stderr or "")).strip()
        if diagnostic_body:
            print("--- TRT-LLM launch diagnostics ---\n" + diagnostic_body, file=sys.stderr)
        cleanup_failures = []
        for target, name in reversed(started):
            try:
                removed = _host_exec(target, ["docker", "rm", "-f", name], capture=True)
                if removed.returncode != 0:
                    cleanup_failures.append(name)
            except OSError:
                cleanup_failures.append(name)
        if cleanup_failures:
            print("ERROR: rollback could not remove: " + ", ".join(cleanup_failures),
                  file=sys.stderr)
        if isinstance(e, KeyboardInterrupt):
            raise
        sys.exit(1)
    print(f"READY: '{profile_key}' passed generation, parser, streaming, and NCCL NET/IB "
          f"checks across '{cfg['name']}'; head API port {profile['port']}.")


def _vllm_warmup_requests(profile):
    model = profile["served_model_name"]
    thinking_kwarg = profile.get("thinking_kwarg", "enable_thinking")
    no_think = {thinking_kwarg: False}
    tool = {
        "type": "function",
        "function": {
            "name": "get_weather",
            "description": "Get current weather for a location",
            "parameters": {
                "type": "object",
                "properties": {"location": {"type": "string"}},
                "required": ["location"],
            },
        },
    }
    blue_png = ("data:image/png;base64,"
                "iVBORw0KGgoAAAANSUhEUgAAAAQAAAABCAIAAAB2XpiaAAAADUlEQVR4nGNgYPgPRwAV9wP9eJEBOw"
                "AAAABJRU5ErkJggg==")
    return [
        ("direct chat", 300, {
            "model": model,
            "messages": [{"role": "user", "content": "Reply with the single word ok."}],
            "max_tokens": 64,
            "temperature": 0.7,
            "top_p": 0.8,
            "top_k": 20,
            "presence_penalty": 1.5,
            "chat_template_kwargs": no_think,
        }),
        ("reasoning", 600, {
            "model": model,
            "messages": [{"role": "user", "content": "What is 17 multiplied by 19?"}],
            "max_tokens": 2048,
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "reasoning_effort": "low",
            "chat_template_kwargs": {thinking_kwarg: True, "reasoning_effort": "low"},
        }),
        ("tool parser", 600, {
            "model": model,
            "messages": [{"role": "user", "content": (
                "Call get_weather exactly once with location Tokyo. Do not answer directly.")}],
            "tools": [tool],
            "tool_choice": "auto",
            "max_tokens": 512,
            "temperature": 0.7,
            "top_p": 0.8,
            "top_k": 20,
            "presence_penalty": 1.5,
            "chat_template_kwargs": no_think,
        }),
        ("vision", 600, {
            "model": model,
            "messages": [{"role": "user", "content": [
                {"type": "image_url", "image_url": {"url": blue_png}},
                {"type": "text", "text": (
                    "This image is one solid primary color. Reply with that lowercase color word.")},
            ]}],
            "max_tokens": 64,
            "temperature": 0,
            "chat_template_kwargs": no_think,
        }),
        ("streaming", 300, {
            "model": model,
            "messages": [{"role": "user", "content": "Write three short words."}],
            "max_tokens": 64,
            "temperature": 0.7,
            "top_p": 0.8,
            "top_k": 20,
            "presence_penalty": 1.5,
            "chat_template_kwargs": no_think,
            "stream": True,
        }),
    ]


def _warm_vllm_cluster(head, profile, deadline):
    endpoint = f"http://127.0.0.1:{profile['port']}/v1/chat/completions"
    for label, timeout, payload in _vllm_warmup_requests(profile):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError(f"Qwen3.8 warmup deadline exhausted before {label}")
        print(f"Warming {profile['served_model_name']} {label} path ...")
        ok, body = _host_text(head, [
            "curl", "--fail-with-body", "-sS", "--max-time", str(min(timeout, remaining)),
            "-H", "Content-Type: application/json", "--data-binary",
            json.dumps(payload, separators=(",", ":")), endpoint,
        ])
        if time.monotonic() >= deadline:
            raise RuntimeError(f"Qwen3.8 warmup deadline exhausted during {label}")
        if not ok:
            detail = body[-500:].replace("\n", " ")
            raise RuntimeError(f"Qwen3.8 {label} warmup failed: {detail}")
        if payload.get("stream"):
            done_seen = body.count("data: [DONE]") == 1
            finish_seen = False
            content_seen = False
            for line in body.splitlines():
                if not line.startswith("data: ") or line == "data: [DONE]":
                    continue
                try:
                    event = json.loads(line[6:])
                except json.JSONDecodeError as e:
                    raise RuntimeError(f"Qwen3.8 {label} warmup returned invalid SSE: {e}") from e
                if not isinstance(event, dict):
                    raise RuntimeError(f"Qwen3.8 {label} warmup returned a non-object SSE event")
                if event.get("error"):
                    raise RuntimeError(f"Qwen3.8 {label} warmup returned an error event")
                choices = event.get("choices", [])
                if (not isinstance(choices, list)
                        or any(not isinstance(choice, dict) for choice in choices)):
                    raise RuntimeError(f"Qwen3.8 {label} warmup returned malformed SSE choices")
                for choice in choices:
                    delta = choice.get("delta", {})
                    if not isinstance(delta, dict):
                        raise RuntimeError(f"Qwen3.8 {label} warmup returned a malformed SSE delta")
                    content = delta.get("content")
                    if content is not None and not isinstance(content, str):
                        raise RuntimeError(
                            f"Qwen3.8 {label} warmup returned malformed SSE content")
                    content_seen = content_seen or bool(content)
                finish_seen = finish_seen or any(
                    choice.get("finish_reason") for choice in choices)
            if not done_seen or not finish_seen or not content_seen:
                raise RuntimeError(f"Qwen3.8 {label} warmup returned an incomplete stream")
            continue
        try:
            response = json.loads(body)
        except json.JSONDecodeError as e:
            raise RuntimeError(f"Qwen3.8 {label} warmup returned invalid JSON: {e}") from e
        if not isinstance(response, dict):
            raise RuntimeError(f"Qwen3.8 {label} warmup returned a non-object response")
        choices = response.get("choices")
        if not isinstance(choices, list) or not choices:
            raise RuntimeError(f"Qwen3.8 {label} warmup returned no choices")
        if not isinstance(choices[0], dict):
            raise RuntimeError(f"Qwen3.8 {label} warmup returned a malformed choice")
        message = choices[0].get("message")
        if not isinstance(message, dict):
            raise RuntimeError(f"Qwen3.8 {label} warmup returned a malformed message")
        reasoning = message.get("reasoning") or message.get("reasoning_content")
        content = message.get("content")
        if label == "direct chat":
            if reasoning:
                raise RuntimeError("Qwen3.8 direct warmup ignored enable_thinking=false")
            if not isinstance(content, str) or not content:
                raise RuntimeError("Qwen3.8 direct warmup emitted no content")
        elif label == "reasoning":
            if (not isinstance(reasoning, str) or not reasoning
                    or not isinstance(content, str) or not content):
                raise RuntimeError("Qwen3.8 reasoning warmup did not separate reasoning and content")
        elif label == "tool parser":
            calls = message.get("tool_calls")
            if not isinstance(calls, list) or len(calls) != 1:
                raise RuntimeError("Qwen3.8 tool warmup did not emit exactly one tool call")
            if not isinstance(calls[0], dict):
                raise RuntimeError("Qwen3.8 tool warmup emitted a malformed tool call")
            function = calls[0].get("function")
            if not isinstance(function, dict):
                raise RuntimeError("Qwen3.8 tool warmup emitted a malformed function")
            try:
                arguments = json.loads(function.get("arguments", ""))
            except (TypeError, json.JSONDecodeError) as e:
                raise RuntimeError("Qwen3.8 tool warmup emitted invalid arguments") from e
            if not isinstance(arguments, dict):
                raise RuntimeError("Qwen3.8 tool warmup emitted invalid arguments")
            if function.get("name") != "get_weather" or arguments.get("location") != "Tokyo":
                raise RuntimeError("Qwen3.8 tool warmup emitted the wrong call")
        elif label == "vision":
            if not isinstance(content, str) or "blue" not in content.casefold():
                raise RuntimeError("Qwen3.8 vision warmup did not identify the blue image")


def _launch_vllm_cluster(profile_key, profile, cfg, dry=False, startup_timeout=1800, keep=False):
    head, worker = _cluster_targets(cfg)
    if not dry:
        if (not (profile.get("image_signature") or profile.get("image_signatures"))
                or not profile.get("vllm_version")):
            print("ERROR: experimental vLLM image identity is not pinned; prepare the image, "
                  "record its reported signature/version, then retry.", file=sys.stderr)
            sys.exit(1)
        if not cluster_preflight(cfg, require_fabric=True)[0]:
            sys.exit(1)
        _ensure_cluster_idle(cfg)
    commands = []
    for role, target in (("worker", worker), ("head", head)):
        name, argv = build_vllm_cluster_argv(profile_key, profile, cfg, role, target, keep=keep)
        commands.append((role, target, name, argv))
    if dry:
        print("--- DRY RUN: worker starts before head; live fabric preflight not performed ---")
        for role, target, _, argv in commands:
            print(f"\n# {role}")
            print(format_run(argv, target))
        return

    existing = []
    for role, target, name, _ in commands:
        inspected = _host_exec(target, ["docker", "container", "inspect", name], capture=True)
        if inspected.returncode == 0:
            existing.append(f"{role} {name}")
    if existing:
        print("ERROR: cluster rank container(s) already exist: " + ", ".join(existing) + ". "
              f"Run `{_cli_name()} stop {cfg['name']} -y` before relaunching.",
              file=sys.stderr)
        sys.exit(1)

    identities = {}
    for role, target, _, _ in commands:
        try:
            identities[role] = _vllm_image_identity(target, profile)
        except RuntimeError as e:
            print(f"ERROR: {role}: {e}; run `omm cluster prepare {cfg['name']} {profile_key} "
                  "--build --weights` while both nodes are idle.", file=sys.stderr)
            sys.exit(1)
        repo = profile["model"].replace("/", "--")
        snapshot = os.path.join(remote_home(target), ".cache", "huggingface", "hub",
                                f"models--{repo}", "snapshots", profile["revision"])
        if _host_exec(target, ["test", "-d", snapshot], capture=True).returncode != 0:
            print(f"ERROR: exact model snapshot is missing on {role}; run cluster prepare "
                  "with --weights.", file=sys.stderr)
            sys.exit(1)
        _host_exec(target, ["mkdir", "-p", _vllm_runtime_cache(target, profile)], check=True)
    signatures = {identity["content_sha256"] for identity in identities.values()}
    expected = set(profile.get("image_signatures", []))
    if ((expected and not signatures.issubset(expected))
            or (not expected and len(signatures) != 1)):
        print("ERROR: pinned vLLM image contents do not match the qualified pair.", file=sys.stderr)
        sys.exit(1)

    for _, target, _, _ in commands:
        _drop_caches(target)
    started = []
    try:
        for role, target, name, argv in commands:
            print(f"Starting vLLM {role} container {name} on {target or 'local'} ...")
            result = _host_exec(target, ["docker"] + argv)
            if result.returncode != 0:
                raise RuntimeError(f"vLLM {role} container failed to start")
            started.append((role, target, name))
            time.sleep(3)
            running = _host_exec(target, ["docker", "inspect", "--format", "{{.State.Running}}",
                                          name], capture=True)
            if running.returncode != 0 or running.stdout.strip() != "true":
                raise RuntimeError(f"vLLM {role} container exited during rendezvous")
        deadline = time.monotonic() + startup_timeout
        while time.monotonic() < deadline:
            for role, target, name, _ in commands:
                running = _host_exec(target, ["docker", "inspect", "--format",
                                              "{{.State.Running}}", name], capture=True)
                if running.returncode != 0 or running.stdout.strip() != "true":
                    raise RuntimeError(f"vLLM {role} container exited during model loading")
            healthy, _ = _host_text(head, ["curl", "-fsS", "--max-time", "5",
                                           f"http://127.0.0.1:{profile['port']}/v1/models"])
            if healthy:
                ib_ready = True
                for _, target, name, _ in commands:
                    logs = _host_exec(target, ["docker", "logs", name], capture=True)
                    body = (logs.stdout or "") + (logs.stderr or "")
                    if logs.returncode != 0 or "NET/IB" not in body:
                        ib_ready = False
                        break
                if ib_ready:
                    _warm_vllm_cluster(head, profile, deadline)
                    break
            time.sleep(10)
        else:
            raise RuntimeError(f"vLLM did not become healthy on NET/IB within {startup_timeout}s")
    except (RuntimeError, subprocess.CalledProcessError, OSError, KeyboardInterrupt) as e:
        reason = "launch interrupted" if isinstance(e, KeyboardInterrupt) else str(e)
        if keep:
            print(f"ERROR: {reason}; stopping started vLLM peers and retaining rank containers "
                  "for diagnostics.", file=sys.stderr)
        else:
            print(f"ERROR: {reason}; rolling back vLLM rank containers.", file=sys.stderr)
        for role, target, name in started:
            diagnostic = _host_exec(target, ["docker", "logs", "--tail", "160", name],
                                    capture=True)
            body = ((diagnostic.stdout or "") + (diagnostic.stderr or "")).strip()
            if body:
                print(f"--- vLLM {role} diagnostics ---\n{body}", file=sys.stderr)
        failures = []
        for _, target, name in reversed(started):
            try:
                cleanup = ["docker", "stop", name] if keep else ["docker", "rm", "-f", name]
                cleaned = _host_exec(target, cleanup, capture=True)
                if cleaned.returncode != 0:
                    detail = (((getattr(cleaned, "stdout", "") or "") + "\n"
                               + (getattr(cleaned, "stderr", "") or "")).strip())
                    absent = (not keep and detail ==
                              f"Error response from daemon: No such container: {name}")
                    if not absent:
                        failures.append(name)
            except OSError:
                failures.append(name)
        if failures:
            action = "stop retained" if keep else "remove"
            print(f"ERROR: cleanup could not {action}: " + ", ".join(failures), file=sys.stderr)
        if keep and started:
            print(f"Retained rank containers. Inspect with `{_cli_name()} logs "
                  f"{cfg['name']} head -f` (or role `worker`), then remove them with "
                  f"`{_cli_name()} stop {cfg['name']} -y`.", file=sys.stderr)
        if isinstance(e, KeyboardInterrupt):
            raise
        sys.exit(1)
    print(f"READY: '{profile_key}' passed direct, reasoning, tool, vision, streaming, and "
          f"NCCL NET/IB checks across '{cfg['name']}'; head API port {profile['port']}.")


