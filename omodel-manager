def _prepare_vllm(cfg, profile, build=False, weights=False, dry=False):
    if dry:
        if build:
            action = ("build the reviewed overlay"
                      if profile.get("overlay_source") or profile.get("build_context")
                      else "pull and verify")
            print(f"  would {action} {profile['image']} on both nodes")
        if weights:
            _download_cluster_snapshot(cfg, profile, profile["image"], "Qwen", dry=True)
        return
    head, worker = _cluster_targets(cfg)
    roles = (("head", head), ("worker", worker))
    if build and (profile.get("overlay_source") or profile.get("build_context")):
        anemll = profile.get("build_context") == "anemll-mia"
        context = _vllm_anemll_context(profile) if anemll else _vllm_overlay_context(profile)
        remote_leaf = "vllm-anemll" if anemll else "vllm-overlay"
        _sync_cluster_files(cfg, context, remote_leaf)

        def build_overlay(role, target):
            print(f"Pulling pinned vLLM base on {role} ({target or 'local'}) ...")
            if _host_exec(target, ["docker", "pull", profile["base_image"]]).returncode != 0:
                raise RuntimeError(f"pinned vLLM base pull failed on {role}")
            remote_context = os.path.join(_cluster_state_dir(cfg["name"], target), remote_leaf)
            print(f"Building reviewed Vision overlay on {role} ({target or 'local'}) ...")
            command = ["docker", "build", "--network", "none", "--pull=false",
                       "--provenance=false",
                       "-t", profile["image"], remote_context]
            if _host_exec(target, command).returncode != 0:
                raise RuntimeError(f"reviewed Vision overlay build failed on {role}")
            return role, _vllm_image_identity(target, profile, allow_unpinned=True)

        identities = {}
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
            futures = [executor.submit(build_overlay, role, target) for role, target in roles]
            for future in concurrent.futures.as_completed(futures):
                role, identity = future.result()
                identities[role] = identity
        signatures = {identity["content_sha256"] for identity in identities.values()}
        versions = {identity["vllm_version"] for identity in identities.values()}
        expected = set(profile.get("image_signatures", []))
        if (expected and not signatures.issubset(expected)) or len(versions) != 1:
            for role in sorted(identities):
                print(f"  {role}: {identities[role]}")
            raise RuntimeError("reviewed Vision overlay differs between nodes")
        if expected:
            print(f"  candidate image_signatures={','.join(sorted(signatures))}")
        else:
            for role in sorted(identities):
                print(f"  candidate image_signature[{role}]="
                      f"{identities[role]['content_sha256']}")
        print(f"  candidate vllm_version={versions.pop()}")
    elif build:
        def pull(role, target):
            print(f"Pulling pinned vLLM preview image on {role} ({target or 'local'}) ...")
            if _host_exec(target, ["docker", "pull", profile["image"]]).returncode != 0:
                raise RuntimeError(f"pinned vLLM image pull failed on {role}")
            return role, _vllm_image_identity(target, profile)

        identities = {}
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
            futures = [executor.submit(pull, role, target) for role, target in roles]
            for future in concurrent.futures.as_completed(futures):
                role, identity = future.result()
                identities[role] = identity
        signatures = {identity["content_sha256"] for identity in identities.values()}
        if len(signatures) != 1:
            raise RuntimeError("pinned vLLM image contents differ between nodes")
        print(f"  verified vLLM {profile['vllm_version']} "
              f"(content sha256:{signatures.pop()}) on both nodes")
    if weights:
        if not build:
            for role, target in roles:
                try:
                    _vllm_image_identity(target, profile)
                except RuntimeError as e:
                    raise RuntimeError(f"{role}: {e}; rerun with --build") from e
        _download_cluster_snapshot(cfg, profile, profile["image"], "Qwen")


def _cluster_container_name(profile_key, cluster_name, role):
    raw = f"{profile_key}-{cluster_name}-{role}"
    safe = re.sub(r"[^a-zA-Z0-9_.-]", "-", raw)
    return NAME_PREFIX + safe


