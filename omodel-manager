              "--shutdown-timeout", "30", "--max-cudagraph-capture-size",
              str(profile["max_cudagraph_capture_size"]),
              "--gpu-memory-utilization", str(profile["gpu_memory_utilization"]),
              "--kv-cache-memory-bytes", str(profile["kv_cache_memory_bytes"]),
               "--enable-prompt-tokens-details", "--no-async-scheduling",
               "--enable-chunked-prefill",
              "--speculative-config",
              '{"method":"dspark","num_speculative_tokens":2,"draft_sample_method":"probabilistic"}',
              "--tokenizer-mode", "deepseek_v4", "--attention-config",
             '{"backend":"FLASHINFER_MLA_SPARSE_DSV4"}',
             "--distributed-executor-backend", "mp", "--tool-call-parser", "deepseek_v4",
             "--enable-auto-tool-choice", "--reasoning-parser", "deepseek_v4",
             "--reasoning-config",
             '{"reasoning_parser":"deepseek_v4","reasoning_start_str":"<think>","reasoning_end_str":"</think>"}',
             "--default-chat-template-kwargs", '{"thinking":true,"reasoning_effort":"high"}',
              "--generation-config", "vllm", "--override-generation-config",
              '{"temperature":1.0,"top_p":1.0}', "--enable-flashinfer-autotune",
              "--distributed-timeout-seconds", "900", "--cpu-distributed-timeout-seconds", "900",
              "--nnodes", "2", "--node-rank", "0" if role == "head" else "1",
              "--master-addr", fabric["head_ips"][0], "--master-port", "25000"]
    if profile.get("enable_prefix_caching", True):
        argv.insert(argv.index("--no-async-scheduling"), "--enable-prefix-caching")
    if role == "worker":
        argv.append("--headless")
    return name, argv


def _pulling_keys(target):
    """Profile keys with a background launch still in progress on `target` -- a
    launch-<key>.log that exists but hasn't recorded a terminal marker yet. Lets
    `ps` flag a box that's mid-pull instead of showing it as free. Best-effort."""
    cmd = ('for f in "$HOME"/.config/otools/launch-*.log; do [ -e "$f" ] || continue; '
           "grep -qE 'OTOOLS_LAUNCH_OK|OTOOLS_LAUNCH_FAILED' \"$f\" || "
           '{ b=$(basename "$f" .log); echo "${b#launch-}"; }; done')
    try:
        if target:
            res = run_remote(target, cmd, capture=True, batch=True)
        else:
            res = subprocess.run(["sh", "-c", cmd], text=True, capture_output=True)
    except OSError:
        return []
    if res.returncode != 0:
        return []
    return [ln.strip() for ln in res.stdout.splitlines() if ln.strip()]


def _looks_ip(s):
    parts = s.split(".")
    return len(parts) == 4 and all(p.isdigit() for p in parts)


def host_of(name):
    """If `name` refers to a HOST -- a registered alias (from `install`), a user@host,
    or a bare IP -- return it (to be resolved as the --host target); else None. This
    lets `logs <hostname>` address the model running on that box without naming it.
    A profile key / container name is never a registered alias or an IP, so it returns
    None and falls through to the normal name lookup."""
    if not name:
        return None
    if "@" in name or _looks_ip(name):
        return name
    return name if any(name == a for a, _ in load_hosts()) else None


def _apply_profile_remote(args):
    """launch/pull parity for logs/stop/health: when the positional names a profile
    whose config sets a per-model `remote`, target that host. An explicit --host wins;
    a container name or host positional isn't a profile key, so it's a no-op."""
    global REMOTE
    key = getattr(args, "target", None)
    if getattr(args, "remote", None) or not key or not os.path.exists(CONFIG_PATH):
        return
    cfg = load_config(create=False)
    if key in cfg.get("models", {}):
        r = resolve_entry(cfg, key).get("remote")
        if r:
            REMOTE = resolve_host(r)


def _managed_on(remote):
    """(container_name, model_key) for the single managed container on `remote`, or
    exit with a clear error. Used when a command gets a host but no model name."""
    rows = list_managed(remote=remote)
    if rows is None:
        print(f"ERROR: cannot query {remote or 'local'} (SSH/docker failed -- box down? "
              f"try `{_cli_name()} install {remote or ''} --fix`).", file=sys.stderr)
        sys.exit(1)
    if len(rows) > 1:
        names = ", ".join(r.get("Names", "") for r in rows)
        print(f"ERROR: {len(rows)} managed containers on {remote or 'local'} ({names}). "
              f"Name the model too, e.g. `{_cli_name()} logs <model> --host <host>`.",
              file=sys.stderr)
        sys.exit(1)
    if not rows:
        print(f"ERROR: no managed container running on {remote or 'local'} "
              f"(idle, or still pulling? see `{_cli_name()} ps`).", file=sys.stderr)
        sys.exit(1)
    r = rows[0]
    return r.get("Names"), (_label(r.get("Labels", ""), LABEL_MODEL) or r.get("Names"))


def _print_ps_table(rows):
    """Print ps rows with widths derived from the complete result set."""
    headers = ("HOST", "CLUSTER", "NAME", "MODEL", "PORT", "STATUS")
    host_width = max(16, *(len(str(row[0])) for row in rows))
    cluster_width = max(16, *(len(str(row[1])) for row in rows))
    name_width = max(28, *(len(str(row[2])) for row in rows))
    model_width = max(28, *(len(str(row[3])) for row in rows))
    port_width = max(6, *(len(str(row[4])) for row in rows))
    fmt = (f"{{:<{host_width}}} {{:<{cluster_width}}} {{:<{name_width}}} "
           f"{{:<{model_width}}} {{:<{port_width}}} {{}}")
    print(fmt.format(*headers))
    for row in rows:
        print(fmt.format(*row))


def cmd_ps(args):
    p = _cli_name()
    registered = load_hosts()                       # [(alias, target)]
    alias_of = {t: a for a, t in registered}
    hlabel = lambda t: alias_of.get(t) or (t if t else "localhost")
    machine_ids = {}
    cluster_membership, cluster_membership_by_machine = {}, {}

    def machine_id(target):
        if target not in machine_ids:
            machine_ids[target] = _host_machine_id(target)
        return machine_ids[target]

    for cluster_name, cfg in load_clusters().items():
        if not isinstance(cfg, dict):
            continue
        for value in (cfg.get("head"), cfg.get("worker")):
            target = None if value in ("local", "localhost") else resolve_host(value)
            if value and cluster_name not in cluster_membership.setdefault(target, []):
                cluster_membership[target].append(cluster_name)
                physical = machine_id(target)
                if physical:
                    cluster_membership_by_machine.setdefault(physical, []).append(cluster_name)

    def cluster_label(target):
        names = list(cluster_membership.get(target, []))
        physical = machine_id(target)
        if physical:
            for name in cluster_membership_by_machine.get(physical, []):
                if name not in names:
                    names.append(name)
        return ",".join(names) or "—"

    # Targets, and whether to also show registered hosts that have nothing running.
    # explicit --hosts > --host/--remote > registered hosts > local.
    if args.hosts:
        targets = [resolve_host(h) for h in args.hosts]
        show_idle = True
    elif REMOTE:
        targets = [REMOTE]
        show_idle = False
    elif registered:
        # A remote registry must not hide local node or card containers.
        targets = [t for _, t in registered] + ([None] if shutil.which("docker") else [])
        show_idle = True
    else:
        targets = [None]
        show_idle = False

    if None in targets:
        need_docker()
    if any(targets) and not shutil.which("ssh"):
        print("ERROR: `ssh` not found on PATH (needed for --host).", file=sys.stderr)
        sys.exit(1)
    targets = _dedupe_host_targets(targets, machine_ids)

    all_rows, state, pulling = [], {}, {}
    for t in targets:
        rows = list_managed(include_all=args.all, remote=t)
        if rows is None:                     # SSH/docker failed -- the box is down, not idle
            state[t] = "unreachable"
            continue
        for r in rows:
            r["_host"] = t
        all_rows.extend(rows)
        pulling[t] = _pulling_keys(t)            # background launches still mid-pull
        state[t] = "running" if rows else ("pulling" if pulling[t] else "idle")

    if not all_rows and not show_idle and not any(pulling.values()):
        print("No running managed vLLM containers."
              + ("" if args.all else "  (try --all to include unmanaged ones)"))
        _suggest([
            ("List available devices", f"{p} devices"),
            ("Choose a model for the local device", f"{p} launch local"),
        ])
        return

    display_rows = []
    for r in all_rows:
        labels = r.get("Labels", "")
        model = _label(labels, LABEL_MODEL) or r.get("Image", "")[:28]
        port = _label(labels, LABEL_PORT) or "?"
        cluster = _label(labels, LABEL_CLUSTER) or cluster_label(r.get("_host"))
        cname = r.get("Names", "")
        name = cname[len(NAME_PREFIX):] if cname.startswith(NAME_PREFIX) else cname
        display_rows.append((hlabel(r.get("_host")), cluster, name, model, str(port),
                             r.get("Status", "")))
    for t in targets:                                # a box mid-pull isn't free -- surface it
        for key in pulling.get(t, []):
            display_rows.append((hlabel(t), cluster_label(t), key, "—", "—", "pulling image"))
    if show_idle:                                    # idle/unreachable hosts so agents can pick one
        for t in targets:
            st = state.get(t)
            if st in ("idle", "unreachable"):
                label = "idle" if st == "idle" else "unreachable (ssh)"
                display_rows.append((hlabel(t), cluster_label(t), "—", "—", "—", label))
    _print_ps_table(display_rows)

    cluster_rows = [(r, _label(r.get("Labels", ""), LABEL_CLUSTER))
                    for r in all_rows if _label(r.get("Labels", ""), LABEL_CLUSTER)]
    if cluster_rows:
        row, cluster = cluster_rows[0]
        _suggest([
            ("Check cluster readiness", f"{p} health {cluster}"),
            ("Follow cluster logs", f"{p} logs {cluster} -f"),
            ("Stop the cluster", f"{p} stop {cluster}"),
        ])
    elif all_rows:                                   # address a one-node model by its stable host
        fh = all_rows[0].get("_host")
        ref = hlabel(fh) if fh else "local"
        _suggest([
            ("View a model's logs (by host; Ctrl-C to stop)", f"{p} logs {ref} -f"),
            ("Check readiness", f"{p} health {ref}"),
            ("Stop a model", f"{p} stop {ref}"),
        ])
    else:
        idle = [hlabel(t) for t in targets if state.get(t) == "idle"]
        _suggest([
            ("Choose a model for a free device", f"{p} launch {idle[0] if idle else 'local'}"),
            ("List available models", f"{p} models"),
        ])


