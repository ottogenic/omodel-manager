# Build the `docker run` argv
# ============================================================================
def _stored_hf_token():
    """The HF token saved by `setup` (~/.config/otools/hf_token), or None."""
    try:
        if os.path.exists(HF_TOKEN_FILE):
            with open(HF_TOKEN_FILE) as f:
                return f.read().strip() or None
    except OSError:
        pass
    return None


def hf_token():
    """Effective HF token: $HF_TOKEN in the shell, else the saved store."""
    return os.environ.get("HF_TOKEN") or _stored_hf_token()


def save_hf_token(tok):
    os.makedirs(os.path.dirname(HF_TOKEN_FILE), exist_ok=True)
    with open(HF_TOKEN_FILE, "w") as f:
        f.write(tok.strip() + "\n")
    try:
        os.chmod(HF_TOKEN_FILE, 0o600)
    except OSError:
        pass


def host_path(p, target=None):
    """Resolve a bind-mount host path. Local: expand ~/${PWD}/$VARs here.
    Remote: resolve ~ against the remote $HOME (cwd is meaningless remotely)."""
    if target:
        home = remote_home(target)
        p = p.replace("${PWD}", home).replace("$PWD", home)
        if p == "~" or p.startswith("~/"):
            p = home + p[1:]
        return p
    return expand_path(p)


def build_run_argv(key, merged, foreground=False, target=None, keep=False):
    name = container_name(key)
    argv = ["run"]
    # Color comes from VLLM_LOGGING_COLOR=1 in the env (works without a TTY and
    # propagates to the EngineCore subprocess), so plain -d is fine when detached.
    argv += ["-it"] if foreground else ["-d"]
    if not keep:
        argv += ["--rm"]   # --keep omits this so a crashed container persists for `logs`
    argv += ["--name", name]
    argv += ["--label", f"{LABEL_MANAGER}={LABEL_VALUE}",
             "--label", f"{LABEL_MODEL}={key}",
             "--label", f"{LABEL_PORT}={merged['port']}"]
    if merged["gpus"]:
        argv += ["--gpus", str(merged["gpus"])]
    argv += list(merged["docker_flags"])

    # HF cache mount
    cache = host_path(merged["hf_cache"], target)
    argv += ["-v", f"{cache}:/root/.cache/huggingface"]

    # Extra volumes (host:container[:opts]); host side gets ~/${PWD}/$VAR expansion.
    for vol in merged.get("volumes", []):
        host, sep, rest = str(vol).partition(":")
        argv += ["-v", f"{host_path(host, target)}:{rest}" if sep else host_path(host, target)]

    # Env: None/""/"${KEY}"/"inherit" -> inherit; else `-e KEY=value`.
    # Locally we inherit (`-e KEY`). Remotely the non-interactive SSH shell won't
    # have it, so we forward the value we hold locally (visible in remote inspect).
    warnings = []
    for k, v in merged["env"].items():
        inherit = v in (None, "", "inherit") or v == "${%s}" % k
        if inherit:
            env_val = os.environ.get(k)
            # HF_TOKEN can also come from the store `setup` writes.
            file_val = _stored_hf_token() if (k == "HF_TOKEN" and env_val is None) else None
            if env_val is not None and not target:
                argv += ["-e", k]                          # inherit locally (keeps it out of argv)
            elif env_val is not None:
                argv += ["-e", f"{k}={env_val}"]           # forward to the remote shell
            elif file_val is not None:
                argv += ["-e", f"{k}={file_val}"]          # from the saved token store
            else:
                argv += ["-e", k]
                warnings.append(f"env {k} not set (run `install <host> --fix` to add HF_TOKEN)"
                                if k == "HF_TOKEN" else f"env {k} not set locally"
                                + (" -> relying on remote env" if target else ""))
        else:
            argv += ["-e", f"{k}={os.path.expandvars(str(v))}"]

    # Image, then vLLM server args. The model is a POSITIONAL arg (`vllm serve <model>`),
    # not `--model`: current vLLM deprecated the flag and prints a warning as the very
    # first log line, which reads alarmingly when the tool is shared.
    argv += [merged["image"]]
    argv += [str(merged["model"]),
             "--host", str(merged["host"]),
             "--port", str(merged["port"])]
    for flag, val in merged["vllm_args"].items():
        if val is True:
            argv += [f"--{flag}"]
        elif val is False or val is None:
            continue
        else:
            argv += [f"--{flag}", str(val)]
    return name, argv, warnings


