def _sync_cluster_files(cfg, local_root, remote_leaf):
    head, worker = _cluster_targets(cfg)
    for _, target in (("head", head), ("worker", worker)):
        remote_root = os.path.join(_cluster_state_dir(cfg["name"], target), remote_leaf)
        if target is None and os.path.abspath(local_root) == os.path.abspath(remote_root):
            continue
        if target is None:
            if os.path.isdir(remote_root):
                shutil.rmtree(remote_root)
            os.makedirs(os.path.dirname(remote_root), exist_ok=True)
            shutil.copytree(local_root, remote_root)
            continue
        _host_exec(target, ["rm", "-rf", remote_root], check=True)
        _host_exec(target, ["mkdir", "-p", os.path.dirname(remote_root)], check=True)
        res = subprocess.run(["scp"] + ssh_opts() + ["-r", local_root,
                             f"{target}:{remote_root}"], text=True)
        if res.returncode != 0:
            print(f"ERROR: failed to copy cluster runtime to {target}", file=sys.stderr)
            sys.exit(res.returncode)


def _sync_cluster_key(cfg):
    head, worker = _cluster_targets(cfg)
    local = os.path.join(_cluster_state_dir(cfg["name"]), "ssh")
    for target in (head, worker):
        remote = os.path.join(_cluster_state_dir(cfg["name"], target), "ssh")
        if target is None and os.path.abspath(local) == os.path.abspath(remote):
            continue
        _host_exec(target, ["rm", "-rf", remote], check=True)
        _host_exec(target, ["mkdir", "-p", os.path.dirname(remote)], check=True)
        res = subprocess.run(["scp"] + ssh_opts() + ["-r", local,
                             f"{target}:{os.path.dirname(remote)}/"], text=True)
        if res.returncode != 0:
            print(f"ERROR: failed to copy deployment key to {target}", file=sys.stderr)
            sys.exit(res.returncode)
        _host_exec(target, ["chmod", "700", remote], check=True)
        _host_exec(target, ["chmod", "600", os.path.join(remote, "id_ed25519"),
                            os.path.join(remote, "authorized_keys")], check=True)


def _download_cluster_snapshot(cfg, profile, image, family, dry=False, roles=None):
    head, worker = _cluster_targets(cfg)
    selected = roles or (("head", head), ("worker", worker))
    if dry:
        print(f"  would download {profile['model']} at {profile['revision']} on "
              + ", ".join(role for role, _ in selected))
        return

    def download(role, target):
        cache = os.path.join(remote_home(target), ".cache", "huggingface")
        _host_exec(target, ["mkdir", "-p", cache], check=True)
        print(f"Downloading official {family} snapshot on {role} ({target or 'local'}) ...")
        cmd = ["docker", "run", "--rm", "--network", "host", "--entrypoint", "hf",
               "-e", "HF_HUB_DISABLE_XET=1", "-e", "HF_HUB_DOWNLOAD_TIMEOUT=600",
               "-e", "HF_HUB_ETAG_TIMEOUT=60",
               "-v", f"{cache}:/root/.cache/huggingface"]
        token = os.path.join(remote_home(target), ".config", "otools", "hf_token")
        if _host_exec(target, ["test", "-s", token], capture=True).returncode == 0:
            cmd += ["-e", "HF_TOKEN_PATH=/run/secrets/hf_token",
                    "-v", f"{token}:/run/secrets/hf_token:ro"]
        cmd += [image, "download", profile["model"], "--revision", profile["revision"],
                "--max-workers", "4"]
        if _host_exec(target, cmd).returncode != 0:
            raise RuntimeError(f"model download failed on {role}; rerun to resume")
        repo = profile["model"].replace("/", "--")
        snapshot = os.path.join(cache, "hub", f"models--{repo}", "snapshots",
                                profile["revision"])
        if _host_exec(target, ["test", "-d", snapshot], capture=True).returncode != 0:
            raise RuntimeError(f"exact snapshot {profile['revision']} missing on {role} after download")
        if family == "Qwen":
            # TRT-LLM probes the default revision before applying --revision.
            # Point that offline-only probe at the same immutable commit.
            ref = os.path.join("/root/.cache/huggingface", "hub", f"models--{repo}",
                               "refs", "main")
            script = ("import pathlib,sys; p=pathlib.Path(sys.argv[1]); "
                      "p.parent.mkdir(parents=True,exist_ok=True); "
                      "p.write_text(sys.argv[2])")
            _host_exec(target, ["docker", "run", "--rm", "--network", "none",
                                "--entrypoint", "python3", "-v",
                                f"{cache}:/root/.cache/huggingface", image,
                                 "-c", script, ref, profile["revision"]], check=True)

    with concurrent.futures.ThreadPoolExecutor(max_workers=len(selected)) as executor:
        futures = [executor.submit(download, role, target) for role, target in selected]
        for future in concurrent.futures.as_completed(futures):
            future.result()


def _prepare_qwen(cfg, profile, build=False, weights=False, dry=False):
    _prepare_cluster_key(cfg, dry=dry)
    if dry:
        print("  would stage the pinned NVIDIA entrypoint and local Docker build context")
        if build:
            print(f"  would build {profile['runtime_image']} from {profile['image']} on both nodes")
        if weights:
            _download_cluster_snapshot(cfg, profile, profile["image"], "Qwen", dry=True)
        return
    context = _qwen_runtime_context(cfg, profile)
    _sync_cluster_key(cfg)
    _sync_cluster_files(cfg, context, "qwen-runtime")
    head, worker = _cluster_targets(cfg)
    if build:
        built_images, runtime_signatures = {}, {}
        for role, target in (("head", head), ("worker", worker)):
            remote_context = os.path.join(_cluster_state_dir(cfg["name"], target),
                                          "qwen-runtime")
            print(f"Building reviewed TRT-LLM runtime on {role} ({target}) ...")
            cmd = ["docker", "build", "--pull", "--build-arg", f"BASE={profile['image']}",
                   "-t", profile["runtime_image"], remote_context]
            if _host_exec(target, cmd).returncode != 0:
                print(f"ERROR: TRT-LLM runtime build failed on {role}.", file=sys.stderr)
                sys.exit(1)
            inspected = _host_exec(target, ["docker", "image", "inspect", "--format",
                                             "{{.Id}}", profile["runtime_image"]], capture=True)
            if inspected.returncode != 0:
                print(f"ERROR: cannot record built runtime identity on {role}.", file=sys.stderr)
                sys.exit(1)
            built_images[role] = inspected.stdout.strip()
            runtime_signatures[role] = _qwen_runtime_signature(target, profile["runtime_image"])
            if not runtime_signatures[role]:
                print(f"ERROR: cannot record built runtime contents on {role}.", file=sys.stderr)
                sys.exit(1)
        manifest_path = _qwen_manifest_path(context, profile)
        with open(manifest_path) as f:
            manifest = json.load(f)
        manifest["built_images"] = built_images
        manifest["runtime_signatures"] = runtime_signatures
        with open(manifest_path, "w") as f:
            json.dump(manifest, f, indent=2); f.write("\n")
    if weights:
        image = profile["runtime_image"] if build else profile["image"]
        _download_cluster_snapshot(cfg, profile, image, "Qwen")


