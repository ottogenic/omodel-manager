    shutil.copyfile(entrypoint, os.path.join(root, "trtllm-mn-entrypoint.sh"))
    shutil.copyfile(license_path, os.path.join(root, "LICENSE.Apache-2.0"))
    dockerfile = (
        "ARG BASE\n"
        "FROM ${BASE}\n"
        "LABEL org.opencontainers.image.source=\"https://github.com/NVIDIA/dgx-spark-playbooks\"\n"
        "LABEL org.opencontainers.image.revision=\"1fb66f059ee427c5a3678b3117ef73aab042b458\"\n"
