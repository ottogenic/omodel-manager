# Two-node cluster registry and preparation
# ============================================================================
def load_clusters(path=None):
    """Load machine-local cluster definitions. This file contains addresses only,
    never secrets, but is kept outside the repository with restrictive permissions."""
    path = path or CLUSTERS_FILE
    try:
        with open(path) as f:
            body = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as e:
        print(f"ERROR: could not read cluster registry {path}: {e}", file=sys.stderr)
        sys.exit(1)
    clusters = body.get("clusters", {}) if isinstance(body, dict) else {}
    if not isinstance(clusters, dict):
        print(f"ERROR: malformed cluster registry {path}: 'clusters' must be an object.",
              file=sys.stderr)
        sys.exit(1)
    return clusters


def save_clusters(clusters, path=None):
    path = path or CLUSTERS_FILE
    parent = os.path.dirname(path)
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".clusters-", dir=parent, text=True)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({"$otools": "model_clusters", "version": 1,
                       "clusters": clusters}, f, indent=2)
            f.write("\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass


def _dgx_cluster_host(alias, target):
    """Read the DGX-side identity and active NVIDIA Sync RoCE fabric."""
    checks = (
        (["test", "-f", "/etc/netplan/99-nvidia-sync-cluster.yaml"], None),
        (["uname", "-m"], "aarch64"),
    )
    for command, expected in checks:
        ok, body = _host_text(target, command)
        if not ok or (expected is not None and body != expected):
            return None
    ok, gpu = _host_text(target, ["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"])
    if not ok or "GB10" not in gpu:
        return None
    ok, hostname = _host_text(target, ["hostnamectl", "--static"])
    if not ok or not hostname:
        return None
    ok, machine_id = _host_text(target, ["cat", "/etc/machine-id"])
    if not ok or not machine_id:
        return None
    ok, rdma_body = _host_text(target, ["ibdev2netdev"])
    if not ok:
        return None
    rdma = {}
    for line in rdma_body.splitlines():
        match = re.match(r"^(\S+)\s+port\s+([1-9][0-9]*)\s+==>\s+(\S+)\s+\(Up\)$",
                         line.strip())
        if match:
            device, port, interface = match.groups()
            rdma[interface] = f"{device}:{port}"
    ok, address_body = _host_text(target, ["ip", "-j", "address", "show"])
    if not ok:
        return None
    try:
        links = json.loads(address_body)
    except json.JSONDecodeError:
        return None
    fabric = {}
    for link in links if isinstance(links, list) else []:
        if not isinstance(link, dict):
            continue
        interface = link.get("ifname")
        if interface not in rdma or link.get("operstate") != "UP":
            continue
        addresses = [item for item in link.get("addr_info", [])
                     if isinstance(item, dict) and item.get("family") == "inet"
                     and item.get("scope") == "global"]
        if len(addresses) != 1:
            continue
        address = addresses[0]
        try:
            ipif = ipaddress.ip_interface(f"{address['local']}/{address['prefixlen']}")
            mtu = int(link.get("mtu", 0))
        except (KeyError, TypeError, ValueError):
            continue
        if ipif.version != 4 or not 1500 <= mtu <= 9000:
            continue
        fabric[interface] = {
            "ip": str(ipif.ip),
            "network": str(ipif.network),
            "ucx_device": rdma[interface],
            "mtu": mtu,
        }
        ok, mac = _host_text(target, ["cat", f"/sys/class/net/{interface}/address"])
        if ok and re.fullmatch(r"[0-9a-fA-F:]{17}", mac):
            fabric[interface]["mac"] = mac.lower()
    if not fabric:
        return None
    return {"alias": alias, "target": target, "hostname": hostname.splitlines()[0].strip(),
            "machine_id": machine_id.splitlines()[0].strip(), "fabric": fabric}


def _dgx_pair_config(head, worker, verify=True):
    if head["machine_id"] == worker["machine_id"]:
        return None
    interfaces = []
    for interface, left in head["fabric"].items():
        right = worker["fabric"].get(interface)
        if not right:
            continue
        if (left["network"] != right["network"] or left["ip"] == right["ip"]
                or left["ucx_device"] != right["ucx_device"]
                or left["mtu"] != right["mtu"]):
            continue
        interfaces.append(interface)
    if not interfaces:
        return None
    if len({head["fabric"][name]["mtu"] for name in interfaces}) != 1:
        return None
    if verify:
        for interface in interfaces:
            left, right = head["fabric"][interface], worker["fabric"][interface]
            checks = ((head["target"], interface, right["ip"]),
                      (worker["target"], interface, left["ip"]))
            for target, source_interface, peer_ip in checks:
                ok, _ = _host_text(target, ["ping", "-c", "1", "-W", "2", "-I",
                                                source_interface, peer_ip])
                if not ok:
                    return None
            # NVIDIA Sync links are point-to-point. Bind the candidate to the
            # physical peer's MAC so overlapping Sync subnets cannot cross-pair.
            if left.get("mac") and right.get("mac"):
                for target, peer_ip, expected_mac in (
                        (head["target"], right["ip"], right["mac"]),
                        (worker["target"], left["ip"], left["mac"])):
                    ok, neighbor = _host_text(target, ["ip", "neigh", "show", peer_ip])
                    match = re.search(r"\blladdr\s+([0-9a-fA-F:]{17})\b", neighbor)
                    if not ok or not match or match.group(1).lower() != expected_mac:
                        return None
    return {
        "head": head["alias"],
        "worker": worker["alias"],
        "head_machine_id": head["machine_id"],
        "worker_machine_id": worker["machine_id"],
        "fabric": {
            "interfaces": interfaces,
            "ucx_devices": [head["fabric"][name]["ucx_device"] for name in interfaces],
            "head_ips": [head["fabric"][name]["ip"] for name in interfaces],
            "worker_ips": [worker["fabric"][name]["ip"] for name in interfaces],
            "mtu": head["fabric"][interfaces[0]]["mtu"],
        },
    }


def _cluster_registered_for_pair(clusters, candidate, hosts, machine_ids):
    host_map = dict(hosts)

    def identity(value):
        target = host_map.get(value, resolve_host(value))
        machine_id = machine_ids.get(target)
        return ("machine", machine_id) if machine_id else ("target", target)

    candidate_hosts = {identity(candidate["head"]), identity(candidate["worker"])}
    for cfg in clusters.values():
        if not isinstance(cfg, dict):
            continue
        current_hosts = {identity(cfg.get("head")), identity(cfg.get("worker"))}
        if current_hosts == candidate_hosts:
            return True
    return False


def _available_cluster_name(clusters, head, worker):
    base = _safe_cluster_name(f"{head}-{worker}")
    if not any(name.casefold() == base.casefold() for name in clusters):
        return base
    index = 2
    while any(name.casefold() == f"{base}-{index}".casefold() for name in clusters):
        index += 1
    return f"{base}-{index}"


def auto_register_dgx_cluster(hosts=None, preferred_aliases=None):
    """Discover and automatically name one identity-verified NVIDIA Sync pair."""
    hosts = load_hosts() if hosts is None else hosts
    discovered = []
    machine_ids = {}
    seen_machine_ids = set()
    for alias, target in hosts:
        host = _dgx_cluster_host(alias, target)
        if not host:
            continue
        machine_ids[target] = host["machine_id"]
        if host["machine_id"] in seen_machine_ids:
            continue
        seen_machine_ids.add(host["machine_id"])
        discovered.append(host)
    candidates = []
    for index, head in enumerate(discovered):
        for worker in discovered[index + 1:]:
            candidate = _dgx_pair_config(head, worker)
            if candidate:
                candidates.append(candidate)
    clusters = load_clusters()
    candidates = [candidate for candidate in candidates
                   if not _cluster_registered_for_pair(clusters, candidate, hosts, machine_ids)]
    preferred = set(preferred_aliases or ())
    if preferred:
        candidates = [candidate for candidate in candidates
                      if preferred.intersection((candidate["head"], candidate["worker"]))]
    if not candidates:
        return []
    if len(candidates) != 1:
        pairs = ", ".join(f"{item['head']}+{item['worker']}" for item in candidates)
        print(f"WARNING: found multiple possible DGX cluster pairs ({pairs}); "
              "not auto-registering an ambiguous topology.", file=sys.stderr)
        return []
    candidate = candidates[0]
    print(f"-> discovered DGX cluster fabric: {candidate['head']} + {candidate['worker']} "
          f"on {', '.join(candidate['fabric']['interfaces'])}")
    name = _available_cluster_name(clusters, candidate["head"], candidate["worker"])
    clusters[name] = candidate
    save_clusters(clusters)
    print(f"-> registered cluster '{name}' in {CLUSTERS_FILE}")
    print(f"   Rename it with `{_cli_name()} cluster rename {name} <new-name>`.")
    return [name]


def cluster_profile(key):
    try:
        return json.loads(json.dumps(CLUSTER_PROFILES[key]))
    except KeyError:
        avail = ", ".join(sorted(CLUSTER_PROFILES))
        print(f"ERROR: unknown cluster profile '{key}'. Available: {avail}", file=sys.stderr)
        sys.exit(1)


def cluster_config(name):
    clusters = load_clusters()
    if name not in clusters:
        matches = [candidate for candidate in clusters
                   if candidate.casefold() == name.casefold()]
        if len(matches) == 1:
            name = matches[0]
        else:
            avail = ", ".join(sorted(clusters)) or "(none)"
            print(f"ERROR: unknown cluster '{name}'. Available: {avail}. "
                  f"Create one with `{_cli_name()} cluster add ...`.", file=sys.stderr)
            sys.exit(1)
    cfg = json.loads(json.dumps(clusters[name]))
    cfg["name"] = name
    return cfg


def _safe_cluster_name(value, label="cluster name"):
    if not value or not re.fullmatch(r"[A-Za-z0-9_.-]+", value):
        print(f"ERROR: {label} must contain only letters, digits, dot, underscore, or dash.",
              file=sys.stderr)
        sys.exit(1)
    return value


def _safe_net_name(value):
    if not value or not re.fullmatch(r"[A-Za-z0-9_.:-]+", value):
        print(f"ERROR: unsafe network interface or address: {value!r}", file=sys.stderr)
        sys.exit(1)
    return value


def _safe_ip(value):
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        print(f"ERROR: invalid fabric IP address: {value!r}", file=sys.stderr)
        sys.exit(1)
    if address.version != 4:
        print("ERROR: cluster fabric currently requires IPv4 addresses.", file=sys.stderr)
        sys.exit(1)
    return value


def _safe_ucx_device(value):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+:[1-9][0-9]*", value or ""):
        print(f"ERROR: UCX device must use device:port syntax, e.g. mlx5_0:1: {value!r}",
              file=sys.stderr)
        sys.exit(1)
    return value


def _route_uses_interface(route, interface):
    return bool(re.search(r"\bdev\s+" + re.escape(interface) + r"(?:\s|$)", route))


def _cluster_targets(cfg):
    def target(value):
        return None if value in ("local", "localhost") else resolve_host(value)

    head = target(cfg["head"])
    worker = target(cfg["worker"])
    if head == worker:
        print("ERROR: a cluster requires two distinct registered hosts.", file=sys.stderr)
        sys.exit(1)
    return head, worker


def _host_exec(target, args, capture=False, check=False, tty=False):
    """Execute a fixed argv on one cluster host. Local execution stays shell-free;
    SSH necessarily invokes the remote shell, so every token is quoted independently."""
    args = [str(a) for a in args]
    if target:
        cmd = " ".join(shlex.quote(a) for a in args)
        return run_remote(target, cmd, capture=capture, batch=True, tty=tty, check=check)
    return subprocess.run(args, text=True, capture_output=capture, check=check)


def _host_exec_retry(target, args, capture=False, check=False, attempts=3):
    """Retry idempotent host probes when SSH fails before opening a session."""
    result = None
    for attempt in range(attempts):
        result = _host_exec(target, args, capture=capture, check=False)
        if not target or result.returncode != 255:
            break
        if attempt + 1 < attempts:
            time.sleep(2)
    if check and result.returncode != 0:
        raise subprocess.CalledProcessError(
            result.returncode, result.args, output=result.stdout, stderr=result.stderr)
    return result


def _host_text(target, args):
    try:
        res = _host_exec(target, args, capture=True)
    except OSError as e:
        return False, str(e)
    text = ((res.stdout or "") + ("\n" + res.stderr if res.stderr else "")).strip()
    return res.returncode == 0, text


def _cluster_state_dir(name, target=None):
    local = os.path.join(CLUSTER_DATA_DIR, _safe_cluster_name(name))
    if not target:
        return local
    return os.path.join(remote_home(target), ".local", "share", "otools", "clusters",
                        _safe_cluster_name(name))


def _cluster_busy(target):
    ok, body = _host_text(target, ["docker", "ps", "-q"])
    if not ok:
        return None
    container_ids = body.split()
    busy = []
    if container_ids:
        ok, details = _host_text(target, ["docker", "inspect", "--format",
                                          "{{.Name}}\t{{json .HostConfig.DeviceRequests}}\t"
                                          "{{json .HostConfig.Devices}}\t{{.HostConfig.Runtime}}\t"
                                          "{{json .Config.Env}}"] + container_ids)
        if not ok:
            return None
        for line in details.splitlines():
            name, _, devices = line.partition("\t")
            hardware = devices.lower()
            if "gpu" in hardware or "nvidia" in hardware:
                busy.append(name.lstrip("/"))
    if busy:
        return busy
    ok, processes = _host_text(target, ["nvidia-smi", "--query-compute-apps=pid,process_name",
                                        "--format=csv,noheader"])
    if not ok:
        return None
    return ["host-gpu:" + line.strip().replace(", ", ":")
            for line in processes.splitlines()
            if line.strip() and "no running processes" not in line.lower()]


def cluster_preflight(cfg, require_fabric=True, quiet=False):
    """Validate two management hosts and, when requested, the exact QSFP/RoCE fabric.
    Never falls back to the management LAN for distributed traffic."""
    head, worker = _cluster_targets(cfg)
    roles = (("head", head), ("worker", worker))
    results, facts = [], {}

    def record(role, check, ok, detail):
        results.append((f"{role}:{check}", ok, detail))

    for role, target in roles:
        ok, hostname = _host_text(target, ["hostnamectl", "--static"])
        record(role, "ssh", ok, hostname or target)
        if not ok:
            continue
        facts[(role, "hostname")] = hostname
        ok, arch = _host_text(target, ["uname", "-m"])
        record(role, "arch", ok and arch == "aarch64", arch or "unknown")
        ok, gpu = _host_text(target, ["nvidia-smi", "--query-gpu=name,driver_version",
                                     "--format=csv,noheader"])
        record(role, "gpu", ok and "GB10" in gpu, gpu or "nvidia-smi failed")
        if ok:
            facts[(role, "driver")] = gpu.split(",")[-1].strip()
        ok, docker_ver = _host_text(target, ["docker", "version", "--format",
                                                "{{.Server.Version}}"])
        record(role, "docker", ok, docker_ver or "docker unavailable")
        ok, disk = _host_text(target, ["df", "-BG", "--output=avail", remote_home(target)])
        available = disk.splitlines()[-1].strip() if disk else "unknown"
        match = re.search(r"(\d+)G", available)
        record(role, "disk", ok and bool(match) and int(match.group(1)) >= 200,
               available + " available (200G required)")

    hostnames = [facts.get((r, "hostname")) for r, _ in roles]
    if all(hostnames) and hostnames[0] == hostnames[1]:
        record("pair", "identity", False, "both entries resolve to the same hostname")
    drivers = [facts.get((r, "driver")) for r, _ in roles]
    if all(drivers):
        record("pair", "driver-parity", drivers[0] == drivers[1], " / ".join(drivers))

    fabric = cfg.get("fabric", {})
    interfaces = fabric.get("interfaces", [])
    ucx_devices = fabric.get("ucx_devices", [])
    head_ips = fabric.get("head_ips", [])
    worker_ips = fabric.get("worker_ips", [])
    mtu = int(fabric.get("mtu", 9000))
    if require_fabric:
        if not (len(interfaces) == len(ucx_devices) == len(head_ips) == len(worker_ips)
                and interfaces):
            record("pair", "fabric-config", False,
                   "interfaces/ucx_devices/head_ips/worker_ips must be non-empty equal-length lists")
        else:
            for role, target, own_ips, peer_ips in (
                    ("head", head, head_ips, worker_ips),
                    ("worker", worker, worker_ips, head_ips)):
                roce_ok, roce = _host_text(target, ["ibdev2netdev"])
                for iface, ucx_device, own_ip, peer_ip in zip(
                        interfaces, ucx_devices, own_ips, peer_ips):
                    _safe_net_name(iface); _safe_ucx_device(ucx_device)
                    _safe_ip(own_ip); _safe_ip(peer_ip)
                    ok, link = _host_text(target, ["ip", "-o", "link", "show", "dev", iface])
                    link_ok = ok and "UP" in link and "LOWER_UP" in link
                    record(role, iface, link_ok, link or "interface missing/down")
                    ok, addr = _host_text(target, ["ip", "-o", "-4", "addr", "show", "dev", iface])
                    record(role, iface + "-ip", ok and f" {own_ip}/" in addr,
                           addr or f"expected {own_ip}")
                    ok, mtu_body = _host_text(target, ["cat", f"/sys/class/net/{iface}/mtu"])
                    record(role, iface + "-mtu", ok and mtu_body == str(mtu),
                           mtu_body or f"expected {mtu}")
                    ok, route = _host_text(target, ["ip", "route", "get", peer_ip])
                    exact_route = _route_uses_interface(route, iface)
                    record(role, iface + "-route", ok and exact_route,
                           route or f"expected route over {iface}")
                    ok, ping = _host_text(target, ["ping", "-I", iface, "-c", "1", "-W", "2", "-M", "do",
                                                           "-s", str(mtu - 28), peer_ip])
                    record(role, iface + "-peer", ok, "jumbo ping ok" if ok else "peer unreachable")
                    device, port = ucx_device.rsplit(":", 1)
                    mapping = f"{device} port {port} ==> {iface} (Up)"
                    record(role, iface + "-roce", roce_ok and mapping in roce,
                           roce or f"expected active {mapping}")

    hard_fail = any(ok is False for _, ok, _ in results)
    if not quiet:
        print(f"Cluster preflight: {cfg['name']} ({'fabric required' if require_fabric else 'management only'})")
        _print_results(results)
        if hard_fail and require_fabric:
            print("\nNOT READY: launch is blocked. The manager will not fall back to Wi-Fi, "
                  "Ethernet, or Tailscale for model traffic.")
        elif hard_fail:
            print("\nNOT READY: fix management/host parity failures before preparation.")
        else:
            print("\nREADY: all requested preflight gates passed.")
    return not hard_fail, results


def _sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


