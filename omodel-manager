def _tree_manifest(root, excluded=()):
    excluded = set(excluded)
    files = {}
    for parent, dirs, names in os.walk(root):
        dirs.sort()
        for name in sorted(names):
            path = os.path.join(parent, name)
            relative = os.path.relpath(path, root)
            if relative in excluded:
                continue
            files[relative] = {"sha256": _sha256_file(path), "size": os.path.getsize(path)}
    return files


def _verify_deepseek_context(target, root):
    script = '''
import hashlib, json, os, sys
root = sys.argv[1]
with open(os.path.join(root, "manifest.json")) as f:
    manifest = json.load(f)
files = {}
for parent, dirs, names in os.walk(root):
    dirs.sort()
    for name in sorted(names):
        path = os.path.join(parent, name)
        relative = os.path.relpath(path, root)
        if relative == "manifest.json":
            continue
        h = hashlib.sha256()
        with open(path, "rb") as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""):
                h.update(block)
        files[relative] = {"sha256": h.hexdigest(), "size": os.path.getsize(path)}
if files != manifest.get("files"):
    raise SystemExit("context file manifest mismatch")
base = {k: v for k, v in manifest.items()
    if k not in ("context_sha256", "built_images", "image_signatures",
                 "runtime_signatures", "model_signatures")}
digest = hashlib.sha256(json.dumps(base, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
if digest != manifest.get("context_sha256"):
    raise SystemExit("context digest mismatch")
print(digest)
'''
    result = _host_exec(target, ["python3", "-c", script, root], capture=True)
    return result.stdout.strip() if result.returncode == 0 else None


def _deepseek_runtime_context(profile, dry=False):
    if profile.get("runtime_lane") == "c8r":
        raise RuntimeError("c8r is built by its pinned full-source kit, not the cand7 builder")
    source = _clone_reviewed_runtime(profile, dry=dry)
    root = os.path.join(CLUSTER_DATA_DIR, "builds", "deepseek-v4-flash-0731")
    if dry:
        print(f"  would stage hash-verified DeepSeek build context: {root}")
        return root
    if os.uname().machine not in ("aarch64", "arm64"):
        raise RuntimeError("DeepSeek overlay extraction must run on an ARM64 control/head host")

    print(f"Pulling official vLLM base for reviewed overlay extraction: {profile['base_image']} ...")
    if _host_exec(None, ["docker", "pull", profile["base_image"]]).returncode != 0:
        raise RuntimeError("failed to pull the official DeepSeek vLLM base")
    arch = _host_exec(None, ["docker", "image", "inspect", "--format", "{{.Architecture}}",
                              profile["base_image"]], capture=True)
    if arch.returncode != 0 or arch.stdout.strip() != "arm64":
        raise RuntimeError("official DeepSeek vLLM base is not the expected ARM64 image")

    located = _host_exec(None, ["docker", "run", "--rm", "--entrypoint", "python3",
                                  profile["base_image"], "-c",
                                  "import os,vllm; print(os.path.dirname(vllm.__file__))"],
                         capture=True)
    if located.returncode != 0 or not located.stdout.strip():
        raise RuntimeError("cannot locate vLLM package in the official base")
    package_dir = located.stdout.strip().splitlines()[-1]

    if os.path.isdir(root):
        shutil.rmtree(root)
    artifacts = os.path.join(root, "artifacts")
    licenses = os.path.join(root, "licenses")
    work = os.path.join(root, ".overlay-work")
    os.makedirs(artifacts)
    os.makedirs(licenses)
    os.makedirs(work)

    b12x_name = f"b12x-{profile['b12x_revision']}.tar.gz"
    flashinfer_name = f"flashinfer-{profile['flashinfer_revision']}.tar.gz"
    _download_verified_source(
        f"https://github.com/lukealonso/b12x/archive/{profile['b12x_revision']}.tar.gz",
        os.path.join(artifacts, b12x_name), profile["b12x_archive_sha256"])
    _download_verified_source(
        f"https://github.com/flashinfer-ai/flashinfer/archive/{profile['flashinfer_revision']}.tar.gz",
        os.path.join(artifacts, flashinfer_name), profile["flashinfer_archive_sha256"])
    with open(os.path.join(artifacts, "SHA256SUMS"), "w") as f:
        f.write(f"{profile['b12x_archive_sha256']}  {b12x_name}\n")
        f.write(f"{profile['flashinfer_archive_sha256']}  {flashinfer_name}\n")

    patch_source = os.path.join(source, "patches", "vllm-026-rebase", "gx10-overlay-026.patch")
    patch = os.path.join(root, "gx10-overlay-026.patch")
    shutil.copyfile(patch_source, patch)
    if _sha256_file(patch) != profile["runtime_patch_sha256"]:
        raise RuntimeError("staged DeepSeek patch digest changed")
    shutil.copyfile(os.path.join(source, "LICENSE"), os.path.join(licenses, "LICENSE.Apache-2.0"))
    shutil.copyfile(os.path.join(source, "NOTICE"), os.path.join(licenses, "NOTICE"))
    with open(os.path.join(licenses, "B12X-PROVENANCE.txt"), "w") as f:
        f.write(profile["b12x_license_provenance"] + "\n")
        f.write(f"source: https://github.com/lukealonso/b12x/tree/{profile['b12x_revision']}\n")
        f.write(f"archive-sha256: {profile['b12x_archive_sha256']}\n")

    created = _host_exec(None, ["docker", "create", profile["base_image"]], capture=True)
    if created.returncode != 0 or not created.stdout.strip():
        raise RuntimeError("cannot create extraction container from official vLLM base")
    container_id = created.stdout.strip()
    try:
        for relative, expected in DEEPSEEK_VLLM_PREIMAGES.items():
            destination = os.path.join(work, relative)
            os.makedirs(os.path.dirname(destination), exist_ok=True)
            source_in_image = package_dir + "/" + relative[len("vllm/"):]
            copied = _host_exec(None, ["docker", "cp", f"{container_id}:{source_in_image}",
                                       destination])
            if copied.returncode != 0:
                raise RuntimeError(f"failed to extract reviewed preimage {relative}")
            actual = _sha256_file(destination)
            if actual != expected:
                raise RuntimeError(f"official base preimage mismatch for {relative}: {actual}")
    finally:
        _host_exec(None, ["docker", "rm", "-f", container_id], capture=True)

    subprocess.run(["git", "-C", work, "init", "-q"], check=True)
    subprocess.run(["git", "-C", work, "apply", "--check", patch], check=True)
    subprocess.run(["git", "-C", work, "apply", patch], check=True)
    overlay = os.path.join(root, "overlay")
    shutil.move(os.path.join(work, "vllm"), overlay)
    shutil.rmtree(work)

    dockerfile_path = os.path.join(root, "Dockerfile")
    with open(dockerfile_path, "w") as f:
        f.write(_deepseek_dockerfile(profile, package_dir))
    manifest = _deepseek_manifest_inputs(profile)
    manifest["vllm_package_dir"] = package_dir
    manifest["dockerfile_sha256"] = _sha256_file(dockerfile_path)
    manifest["files"] = _tree_manifest(root, excluded=("manifest.json",))
    canonical = json.dumps(manifest, sort_keys=True, separators=(",", ":")).encode()
    manifest["context_sha256"] = hashlib.sha256(canonical).hexdigest()
    with open(os.path.join(root, "manifest.json"), "w") as f:
        json.dump(manifest, f, indent=2); f.write("\n")
    return root


