def _deepseek_image_signature(target, image):
    image_format = "{{json .RootFS.Layers}}\n{{json .Config}}\n{{.Os}}/{{.Architecture}}"
    result = _host_exec(target, ["docker", "image", "inspect", "--format", image_format,
                                 image], capture=True)
    if result.returncode != 0:
        return None
    lines = result.stdout.splitlines()
    if len(lines) != 3:
        return None
    try:
        identity = {
            "layers": json.loads(lines[0]),
            "config": json.loads(lines[1]),
            "platform": lines[2],
        }
    except json.JSONDecodeError:
        return None
    canonical = json.dumps(identity, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(canonical).hexdigest()


def _deepseek_model_signature(target, profile):
    repo = profile["model"].replace("/", "--")
    snapshot = os.path.join(remote_home(target), ".cache", "huggingface", "hub",
                            f"models--{repo}", "snapshots", profile["revision"])
    script = '''
import hashlib, json, os, pathlib, sys
snapshot = pathlib.Path(sys.argv[1])
expected_files, expected_size, expected_shards = map(int, sys.argv[2:5])
repo = snapshot.parent.parent.resolve()
files = sorted(path for path in snapshot.rglob("*") if path.is_file())
if len(files) != expected_files:
    raise SystemExit(f"expected {expected_files} files, found {len(files)}")
shards = [path for path in files if path.name.startswith("model-") and path.suffix == ".safetensors"]
if len(shards) != expected_shards:
    raise SystemExit(f"expected {expected_shards} shards, found {len(shards)}")
aggregate = hashlib.sha256()
total = 0
for path in files:
    resolved = path.resolve()
    if os.path.commonpath((str(repo), str(resolved))) != str(repo):
        raise SystemExit(f"snapshot link escapes model repository: {path}")
    digest = hashlib.sha256()
    with open(resolved, "rb") as stream:
        for block in iter(lambda: stream.read(8 * 1024 * 1024), b""):
            digest.update(block)
    size = resolved.stat().st_size
    total += size
    aggregate.update(str(path.relative_to(snapshot)).encode())
    aggregate.update(b"\\0")
    aggregate.update(digest.digest())
if total != expected_size:
    raise SystemExit(f"expected {expected_size} bytes, found {total}")
print(json.dumps({"sha256": aggregate.hexdigest(), "files": len(files),
                  "shards": len(shards), "size": total}, sort_keys=True))
'''
    result = _host_exec(target, ["python3", "-c", script, snapshot,
                                 profile["model_file_count"], profile["model_size"],
                                 profile["model_shards"]], capture=True)
    detail = ((result.stdout or "") + ("\n" + result.stderr if result.stderr else "")).strip()
    if result.returncode != 0:
        return None, detail
    try:
        return json.loads(result.stdout), ""
    except json.JSONDecodeError:
        return None, detail


def _prepare_deepseek(cfg, profile, build=False, weights=False, dry=False):
    if profile.get("runtime_lane") == "c8r":
        context = _clone_reviewed_runtime(profile, dry=dry)
        if not dry:
            print(f"  reviewed source ready: {context}")
        if weights:
            _download_cluster_snapshot(cfg, profile, profile["download_image"], "DeepSeek", dry=dry)
        if not build:
            return
        if dry:
            print(f"  would certify resident full-source image {profile['image']} on both nodes")
            return
        _record_deepseek_runtime(cfg, profile)
        return
    context = _deepseek_runtime_context(profile, dry=dry) if build else _clone_reviewed_runtime(
        profile, dry=dry)
    if not dry:
        print(f"  reviewed source ready: {context}")
    if weights:
        _download_cluster_snapshot(cfg, profile, profile["download_image"], "DeepSeek", dry=dry)
    if not build:
        return
    if dry:
        print(f"  would build {profile['image']} with --network=none on both nodes")
        return

    _sync_cluster_files(cfg, context, "deepseek-runtime")
    head, worker = _cluster_targets(cfg)
    with open(os.path.join(context, "manifest.json")) as f:
        staged_manifest = json.load(f)
    for role, target in (("head", head), ("worker", worker)):
        remote_context = os.path.join(_cluster_state_dir(cfg["name"], target),
                                      "deepseek-runtime")
        verified = _verify_deepseek_context(target, remote_context)
        if verified != staged_manifest["context_sha256"]:
            raise RuntimeError(f"DeepSeek build context verification failed on {role}")
    remote_contexts = {}
    for role, target in (("head", head), ("worker", worker)):
        print(f"Pulling official DeepSeek base on {role} ({target or 'local'}) ...")
        if _host_exec(target, ["docker", "pull", profile["base_image"]]).returncode != 0:
            raise RuntimeError(f"official DeepSeek base pull failed on {role}")
        architecture = _host_exec(target, ["docker", "image", "inspect", "--format",
                                           "{{.Architecture}}", profile["base_image"]], capture=True)
        if architecture.returncode != 0 or architecture.stdout.strip() != "arm64":
            raise RuntimeError(f"official DeepSeek base architecture mismatch on {role}")
        remote_contexts[role] = os.path.join(_cluster_state_dir(cfg["name"], target),
                                             "deepseek-runtime")

    print(f"Building reviewed DeepSeek runtime once on head with network disabled ...")
    command = ["docker", "build", "--network=none", "--build-arg",
               f"VLLM_BASE={profile['base_image']}", "-t", profile["image"],
               remote_contexts["head"]]
    if _host_exec(head, command).returncode != 0:
        raise RuntimeError("DeepSeek runtime build failed on head")

    head_signature = _deepseek_image_signature(head, profile["image"])
    worker_signature = _deepseek_image_signature(worker, profile["image"])
    if not head_signature:
        raise RuntimeError("cannot record the head DeepSeek image signature")
    if worker_signature != head_signature:
        archive_name = "deepseek-cand7-image.tar.zst"
        head_archive = os.path.join(remote_contexts["head"], archive_name)
        worker_archive = os.path.join(remote_contexts["worker"], archive_name)
        for role, target in (("head", head), ("worker", worker)):
            if _host_exec(target, ["zstd", "--version"], capture=True).returncode != 0:
                raise RuntimeError(f"zstd is required to distribute the reviewed image to {role}")
        print("Distributing the exact head image to worker ...")
        save_script = (f"docker save {shlex.quote(profile['image'])} | "
                       f"zstd -T0 -3 -f -o {shlex.quote(head_archive)}")
        if _host_exec(head, ["bash", "-o", "pipefail", "-c", save_script]).returncode != 0:
            raise RuntimeError("failed to archive the reviewed DeepSeek image")
        try:
            if head is None:
                copied = subprocess.run(["scp"] + ssh_opts() +
                                        [head_archive, f"{worker}:{worker_archive}"], text=True)
            elif worker is None:
                copied = subprocess.run(["scp"] + ssh_opts() +
                                        [f"{head}:{head_archive}", worker_archive], text=True)
            else:
                copied = subprocess.run(["scp", "-3"] + ssh_opts() +
                                        [f"{head}:{head_archive}",
                                         f"{worker}:{worker_archive}"], text=True)
            if copied.returncode != 0:
                raise RuntimeError("failed to copy the reviewed DeepSeek image to worker")
            load_script = f"zstd -dc {shlex.quote(worker_archive)} | docker load"
            if _host_exec(worker, ["bash", "-o", "pipefail", "-c", load_script]).returncode != 0:
                raise RuntimeError("failed to load the reviewed DeepSeek image on worker")
        finally:
            _host_exec(head, ["rm", "-f", head_archive], capture=True)
            _host_exec(worker, ["rm", "-f", worker_archive], capture=True)
    else:
        print("Worker already has the head image's exact runtime layers and configuration.")

    built_images, image_signatures, runtime_signatures = {}, {}, {}
    for role, target in (("head", head), ("worker", worker)):
        inspected = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                        profile["image"]], capture=True)
        if inspected.returncode != 0:
            raise RuntimeError(f"cannot record DeepSeek runtime identity on {role}")
        signature, detail = _deepseek_runtime_signature(target, profile["image"])
        if not signature:
            raise RuntimeError(f"DeepSeek runtime smoke failed on {role}: {detail}")
        built_images[role] = inspected.stdout.strip()
        image_signatures[role] = _deepseek_image_signature(target, profile["image"])
        runtime_signatures[role] = signature

    if None in image_signatures.values() or len(set(image_signatures.values())) != 1:
        raise RuntimeError("DeepSeek runtime layers or image configuration differ between roles")
    if len(set(runtime_signatures.values())) != 1:
        raise RuntimeError("DeepSeek installed runtime contents differ between head and worker")
    model_signatures = {}
    for role, target in (("head", head), ("worker", worker)):
        print(f"Hashing exact DeepSeek snapshot on {role} ...")
        signature, detail = _deepseek_model_signature(target, profile)
        if not signature:
            raise RuntimeError(f"DeepSeek model verification failed on {role}: {detail}")
        model_signatures[role] = signature
    if len({json.dumps(value, sort_keys=True) for value in model_signatures.values()}) != 1:
        raise RuntimeError("DeepSeek model snapshots differ between head and worker")

    manifest_path = os.path.join(context, "manifest.json")
    with open(manifest_path) as f:
        manifest = json.load(f)
    manifest["built_images"] = built_images
    manifest["image_signatures"] = image_signatures
    manifest["runtime_signatures"] = runtime_signatures
    manifest["model_signatures"] = model_signatures
    with open(manifest_path, "w") as f:
        json.dump(manifest, f, indent=2); f.write("\n")
    print("DeepSeek runtime built and smoke-tested on both nodes; launch still requires fabric.")


def _deepseek_build_dir(profile):
    lane = profile.get("runtime_lane", "cand7")
    return os.path.join(CLUSTER_DATA_DIR, "builds", f"deepseek-v4-flash-0731-{lane}")


def _record_deepseek_runtime(cfg, profile):
    """Certify a c8r image built by the pinned upstream full-source kit."""
    head, worker = _cluster_targets(cfg)
    built_images, image_signatures, runtime_signatures = {}, {}, {}
    for role, target in (("head", head), ("worker", worker)):
        inspected = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                        profile["image"]], capture=True)
        if inspected.returncode != 0:
            raise RuntimeError(f"c8r image is missing on {role}; run the pinned full-source build")
        image_signature = _deepseek_image_signature(target, profile["image"])
        if image_signature != profile["image_signature"]:
            raise RuntimeError(f"c8r image content signature mismatch on {role}")
        runtime_signature, detail = _deepseek_runtime_signature(target, profile["image"])
        if not runtime_signature:
            raise RuntimeError(f"c8r runtime smoke failed on {role}: {detail}")
        built_images[role] = inspected.stdout.strip()
        image_signatures[role] = image_signature
        runtime_signatures[role] = runtime_signature
    if len(set(image_signatures.values())) != 1 or len(set(runtime_signatures.values())) != 1:
        raise RuntimeError("c8r runtime contents differ between head and worker")

    model_signatures = {}
    for role, target in (("head", head), ("worker", worker)):
        print(f"Hashing exact DeepSeek snapshot on {role} ...")
        signature, detail = _deepseek_model_signature(target, profile)
        if not signature:
            raise RuntimeError(f"DeepSeek model verification failed on {role}: {detail}")
        model_signatures[role] = signature
    if len({json.dumps(value, sort_keys=True) for value in model_signatures.values()}) != 1:
        raise RuntimeError("DeepSeek model snapshots differ between head and worker")

    root = _deepseek_build_dir(profile)
    os.makedirs(root, exist_ok=True)
    manifest = _deepseek_manifest_inputs(profile)
    manifest["built_images"] = built_images
    manifest["image_signatures"] = image_signatures
    manifest["runtime_signatures"] = runtime_signatures
    manifest["model_signatures"] = model_signatures
    with open(os.path.join(root, "manifest.json"), "w") as f:
        json.dump(manifest, f, indent=2); f.write("\n")
    print("DeepSeek c8r full-source runtime certified on both nodes; launch still requires fabric.")


def _copy_to_host(target, local, remote):
    if target is None:
        if os.path.abspath(local) != os.path.abspath(remote):
            os.makedirs(os.path.dirname(remote), exist_ok=True)
            shutil.copyfile(local, remote)
        return
    parent = os.path.dirname(remote)
    _host_exec(target, ["mkdir", "-p", parent], check=True)
    res = subprocess.run(["scp"] + ssh_opts() + [local, f"{target}:{remote}"], text=True)
    if res.returncode != 0:
        raise RuntimeError(f"failed to copy {local} to {target}:{remote}")


def _qwen_runtime_context(cfg, profile):
    root = os.path.join(_cluster_state_dir(cfg["name"]), "qwen-runtime")
    os.makedirs(root, exist_ok=True)
    entrypoint = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cluster",
                              "trtllm-mn-entrypoint.sh")
    license_path = os.path.join(os.path.dirname(entrypoint), "LICENSE.Apache-2.0")
    manifest = _qwen_expected_manifest(profile)
    shutil.copyfile(entrypoint, os.path.join(root, "trtllm-mn-entrypoint.sh"))
    shutil.copyfile(license_path, os.path.join(root, "LICENSE.Apache-2.0"))
    dockerfile = (
        "ARG BASE\n"
        "FROM ${BASE}\n"
        "LABEL org.opencontainers.image.source=\"https://github.com/NVIDIA/dgx-spark-playbooks\"\n"
        "LABEL org.opencontainers.image.revision=\"1fb66f059ee427c5a3678b3117ef73aab042b458\"\n"
        "RUN apt-get update && apt-get install -y --no-install-recommends openssh-server "
        "&& rm -rf /var/lib/apt/lists/*\n"
        "COPY trtllm-mn-entrypoint.sh /opt/otools/trtllm-mn-entrypoint.sh\n"
        "COPY LICENSE.Apache-2.0 /usr/share/doc/otools-cluster/LICENSE.Apache-2.0\n"
        "RUN chmod 0755 /opt/otools/trtllm-mn-entrypoint.sh\n"
    )
    with open(os.path.join(root, "Dockerfile"), "w") as f:
        f.write(dockerfile)
    manifest_path = _qwen_manifest_path(root, profile)
    os.makedirs(os.path.dirname(manifest_path), exist_ok=True)
    for previous_path in (manifest_path, os.path.join(root, "manifest.json")):
        try:
            with open(previous_path) as f:
                previous = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        if all(previous.get(key) == value for key, value in manifest.items()):
            manifest["built_images"] = previous.get("built_images", {})
            manifest["runtime_signatures"] = previous.get("runtime_signatures", {})
            break
    with open(manifest_path, "w") as f:
        json.dump(manifest, f, indent=2); f.write("\n")
    return root


def _sync_cluster_files(cfg, local_root, remote_leaf):
    head, worker = _cluster_targets(cfg)
    for _, target in (("head", head), ("worker", worker)):
        remote_root = os.path.join(_cluster_state_dir(cfg["name"], target), remote_leaf)
        if target is None and os.path.abspath(local_root) == os.path.abspath(remote_root):
            continue
        if target is None:
            if os.path.isdir(remote_root):
                shutil.rmtree(remote_root)
            os.makedirs(os.path.dirname(remote_root), exist_ok=True)
            shutil.copytree(local_root, remote_root)
            continue
        _host_exec(target, ["rm", "-rf", remote_root], check=True)
        _host_exec(target, ["mkdir", "-p", os.path.dirname(remote_root)], check=True)
        res = subprocess.run(["scp"] + ssh_opts() + ["-r", local_root,
                             f"{target}:{remote_root}"], text=True)
        if res.returncode != 0:
            print(f"ERROR: failed to copy cluster runtime to {target}", file=sys.stderr)
            sys.exit(res.returncode)


def _sync_cluster_key(cfg):
    head, worker = _cluster_targets(cfg)
    local = os.path.join(_cluster_state_dir(cfg["name"]), "ssh")
    for target in (head, worker):
        remote = os.path.join(_cluster_state_dir(cfg["name"], target), "ssh")
        if target is None and os.path.abspath(local) == os.path.abspath(remote):
            continue
        _host_exec(target, ["rm", "-rf", remote], check=True)
        _host_exec(target, ["mkdir", "-p", os.path.dirname(remote)], check=True)
        res = subprocess.run(["scp"] + ssh_opts() + ["-r", local,
                             f"{target}:{os.path.dirname(remote)}/"], text=True)
        if res.returncode != 0:
            print(f"ERROR: failed to copy deployment key to {target}", file=sys.stderr)
            sys.exit(res.returncode)
        _host_exec(target, ["chmod", "700", remote], check=True)
        _host_exec(target, ["chmod", "600", os.path.join(remote, "id_ed25519"),
                            os.path.join(remote, "authorized_keys")], check=True)


def _download_cluster_snapshot(cfg, profile, image, family, dry=False):
    head, worker = _cluster_targets(cfg)
    if dry:
        print(f"  would download {profile['model']} at {profile['revision']} on both nodes")
        return
    for role, target in (("head", head), ("worker", worker)):
        cache = os.path.join(remote_home(target), ".cache", "huggingface")
        _host_exec(target, ["mkdir", "-p", cache], check=True)
        print(f"Downloading official {family} snapshot on {role} ({target or 'local'}) ...")
        cmd = ["docker", "run", "--rm", "--network", "host", "--entrypoint", "hf",
               "-e", "HF_HUB_DISABLE_XET=1", "-e", "HF_HUB_DOWNLOAD_TIMEOUT=600",
               "-e", "HF_HUB_ETAG_TIMEOUT=60",
               "-v", f"{cache}:/root/.cache/huggingface"]
        token = os.path.join(remote_home(target), ".config", "otools", "hf_token")
        if _host_exec(target, ["test", "-s", token], capture=True).returncode == 0:
            cmd += ["-e", "HF_TOKEN_PATH=/run/secrets/hf_token",
                    "-v", f"{token}:/run/secrets/hf_token:ro"]
        cmd += [image, "download", profile["model"], "--revision", profile["revision"],
                "--max-workers", "4"]
        if _host_exec(target, cmd).returncode != 0:
            print(f"ERROR: model download failed on {role}; rerun to resume.", file=sys.stderr)
            sys.exit(1)
        repo = profile["model"].replace("/", "--")
        snapshot = os.path.join(cache, "hub", f"models--{repo}", "snapshots",
                                profile["revision"])
        if _host_exec(target, ["test", "-d", snapshot], capture=True).returncode != 0:
            print(f"ERROR: exact snapshot {profile['revision']} missing on {role} after download.",
                  file=sys.stderr)
            sys.exit(1)
        if family == "Qwen":
            # TRT-LLM probes the default revision before applying --revision.
            # Point that offline-only probe at the same immutable commit.
            ref = os.path.join("/root/.cache/huggingface", "hub", f"models--{repo}",
                               "refs", "main")
            script = ("import pathlib,sys; p=pathlib.Path(sys.argv[1]); "
                      "p.parent.mkdir(parents=True,exist_ok=True); "
                      "p.write_text(sys.argv[2])")
            _host_exec(target, ["docker", "run", "--rm", "--network", "none",
                                "--entrypoint", "python3", "-v",
                                f"{cache}:/root/.cache/huggingface", image,
                                "-c", script, ref, profile["revision"]], check=True)


def _prepare_qwen(cfg, profile, build=False, weights=False, dry=False):
    _prepare_cluster_key(cfg, dry=dry)
    if dry:
        print("  would stage the pinned NVIDIA entrypoint and local Docker build context")
        if build:
            print(f"  would build {profile['runtime_image']} from {profile['image']} on both nodes")
        if weights:
            _download_cluster_snapshot(cfg, profile, profile["image"], "Qwen", dry=True)
        return
    context = _qwen_runtime_context(cfg, profile)
    _sync_cluster_key(cfg)
    _sync_cluster_files(cfg, context, "qwen-runtime")
    head, worker = _cluster_targets(cfg)
    if build:
        built_images, runtime_signatures = {}, {}
        for role, target in (("head", head), ("worker", worker)):
            remote_context = os.path.join(_cluster_state_dir(cfg["name"], target),
                                          "qwen-runtime")
            print(f"Building reviewed TRT-LLM runtime on {role} ({target}) ...")
            cmd = ["docker", "build", "--pull", "--build-arg", f"BASE={profile['image']}",
                   "-t", profile["runtime_image"], remote_context]
            if _host_exec(target, cmd).returncode != 0:
                print(f"ERROR: TRT-LLM runtime build failed on {role}.", file=sys.stderr)
                sys.exit(1)
            inspected = _host_exec(target, ["docker", "image", "inspect", "--format",
                                             "{{.Id}}", profile["runtime_image"]], capture=True)
            if inspected.returncode != 0:
                print(f"ERROR: cannot record built runtime identity on {role}.", file=sys.stderr)
                sys.exit(1)
            built_images[role] = inspected.stdout.strip()
            runtime_signatures[role] = _qwen_runtime_signature(target, profile["runtime_image"])
            if not runtime_signatures[role]:
                print(f"ERROR: cannot record built runtime contents on {role}.", file=sys.stderr)
                sys.exit(1)
        manifest_path = _qwen_manifest_path(context, profile)
        with open(manifest_path) as f:
            manifest = json.load(f)
        manifest["built_images"] = built_images
        manifest["runtime_signatures"] = runtime_signatures
        with open(manifest_path, "w") as f:
            json.dump(manifest, f, indent=2); f.write("\n")
    if weights:
        image = profile["runtime_image"] if build else profile["image"]
        _download_cluster_snapshot(cfg, profile, image, "Qwen")


