def _warm_deepseek_cluster(head, profile):
    endpoint = f"http://127.0.0.1:{profile['port']}/v1/chat/completions"
    for label, timeout, payload in _deepseek_warmup_requests(profile):
        print(f"Warming DeepSeek {label} path ...")
        ok, body = _host_text(head, [
            "curl", "--fail-with-body", "-sS", "--max-time", str(timeout),
            "-H", "Content-Type: application/json", "--data-binary",
            json.dumps(payload, separators=(",", ":")), endpoint,
        ])
        if not ok:
            detail = body[-500:].replace("\n", " ")
            raise RuntimeError(f"DeepSeek {label} warmup failed: {detail}")
        if payload.get("stream"):
            if "data: [DONE]" not in body:
                raise RuntimeError(f"DeepSeek {label} warmup returned an incomplete stream")
            finish_seen = False
            for line in body.splitlines():
                if not line.startswith("data: ") or line == "data: [DONE]":
                    continue
                try:
                    event = json.loads(line[6:])
                except json.JSONDecodeError as e:
                    raise RuntimeError(f"DeepSeek {label} warmup returned invalid SSE: {e}") from e
                if event.get("error"):
                    detail = json.dumps(event["error"], separators=(",", ":"))[-500:]
                    raise RuntimeError(
                        f"DeepSeek {label} warmup returned an error event: {detail}")
                finish_seen = finish_seen or any(
                    choice.get("finish_reason") for choice in event.get("choices", []))
            if not finish_seen:
                raise RuntimeError(f"DeepSeek {label} warmup ended without a finish reason")
            continue
        try:
            response = json.loads(body)
        except json.JSONDecodeError as e:
            raise RuntimeError(f"DeepSeek {label} warmup returned invalid JSON: {e}") from e
        choices = response.get("choices")
        if not isinstance(choices, list) or not choices:
            raise RuntimeError(f"DeepSeek {label} warmup returned no choices")
        if label == "tool parser" and not choices[0].get("message", {}).get("tool_calls"):
            raise RuntimeError("DeepSeek tool parser warmup emitted no tool call")


def _launch_deepseek_cluster(profile_key, profile, cfg, dry=False, startup_timeout=900):
    head, worker = _cluster_targets(cfg)
    if not dry:
        if not cluster_preflight(cfg, require_fabric=True)[0]:
            sys.exit(1)
        _ensure_cluster_idle(cfg)
    nodes = (("worker", worker), ("head", head))
    commands = []
    for role, target in nodes:
        name, argv = build_deepseek_cluster_argv(profile_key, profile, cfg, role, target)
        commands.append((role, target, name, argv))
    if dry:
        print("--- DRY RUN: worker starts before head; live fabric preflight not performed ---")
        for role, target, _, argv in commands:
            print(f"\n# {role}")
            print(format_run(argv, target))
        return

    lane = profile.get("runtime_lane", "cand7")
    manifest_root = (_deepseek_build_dir(profile) if lane == "c8r" else
                     os.path.join(CLUSTER_DATA_DIR, "builds", "deepseek-v4-flash-0731"))
    manifest_path = os.path.join(manifest_root, "manifest.json")
    try:
        with open(manifest_path) as f:
            manifest = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        print(f"ERROR: reviewed DeepSeek build manifest unavailable: {e}", file=sys.stderr)
        sys.exit(1)
    expected = _deepseek_manifest_inputs(profile)
    if any(manifest.get(key) != value for key, value in expected.items()):
        print("ERROR: DeepSeek build manifest does not match current reviewed inputs; rebuild.",
              file=sys.stderr)
        sys.exit(1)
    if lane != "c8r":
        context_root = os.path.dirname(manifest_path)
        if _verify_deepseek_context(None, context_root) != manifest.get("context_sha256"):
            print("ERROR: staged DeepSeek build context no longer matches its manifest; rebuild.",
                  file=sys.stderr)
            sys.exit(1)
        package_dir = manifest.get("vllm_package_dir", "")
        generated_dockerfile = _deepseek_dockerfile(profile, package_dir).encode()
        if hashlib.sha256(generated_dockerfile).hexdigest() != manifest.get("dockerfile_sha256"):
            print("ERROR: DeepSeek Dockerfile generator changed since the recorded build; rebuild.",
                  file=sys.stderr)
            sys.exit(1)
    built_images = manifest.get("built_images", {})
    expected_images = manifest.get("image_signatures", {})
    expected_signatures = manifest.get("runtime_signatures", {})
    expected_models = manifest.get("model_signatures", {})
    if (set(built_images) != {"head", "worker"}
            or set(expected_images) != {"head", "worker"}
            or set(expected_signatures) != {"head", "worker"}
            or set(expected_models) != {"head", "worker"}):
        print("ERROR: DeepSeek build manifest lacks both role identities; rebuild.", file=sys.stderr)
        sys.exit(1)
    if len(set(expected_signatures.values())) != 1:
        print("ERROR: recorded DeepSeek runtime contents differ between roles; rebuild.",
              file=sys.stderr)
        sys.exit(1)
    if len(set(expected_images.values())) != 1:
        print("ERROR: recorded DeepSeek image contents differ between roles; rebuild.",
              file=sys.stderr)
        sys.exit(1)

    for role, target, _, _ in commands:
        inspected = _host_exec(target, ["docker", "image", "inspect", "--format", "{{.Id}}",
                                        profile["image"]], capture=True)
        if inspected.returncode != 0 or inspected.stdout.strip() != built_images[role]:
            print(f"ERROR: {role} DeepSeek image does not match its reviewed build ID.",
                  file=sys.stderr)
            sys.exit(1)
        if _deepseek_image_signature(target, profile["image"]) != expected_images[role]:
            print(f"ERROR: {role} DeepSeek image content signature mismatch.", file=sys.stderr)
            sys.exit(1)
        signature, detail = _deepseek_runtime_signature(target, profile["image"])
        if signature != expected_signatures[role]:
            print(f"ERROR: {role} DeepSeek runtime signature mismatch: {detail}", file=sys.stderr)
            sys.exit(1)
        model_signature, detail = _deepseek_model_signature(target, profile)
        if model_signature != expected_models[role]:
            print(f"ERROR: {role} DeepSeek model snapshot mismatch: {detail}", file=sys.stderr)
            sys.exit(1)
        runtime_cache = os.path.join(remote_home(target), ".cache", "otools",
                                     f"deepseek-v4-flash-0731-{lane}")
        _host_exec(target, ["mkdir", "-p", runtime_cache], check=True)

    for _, target, _, _ in commands:
        _drop_caches(target)
    started = []
    try:
        for role, target, name, argv in commands:
            print(f"Starting DeepSeek {role} container {name} on {target or 'local'} ...")
            result = _host_exec(target, ["docker"] + argv)
            if result.returncode != 0:
                raise RuntimeError(f"DeepSeek {role} container failed to start")
            started.append((target, name))
            time.sleep(3)
            running = _host_exec(target, ["docker", "inspect", "--format", "{{.State.Running}}",
                                          name], capture=True)
            if running.returncode != 0 or running.stdout.strip() != "true":
                raise RuntimeError(f"DeepSeek {role} container exited during rendezvous")
        deadline = time.monotonic() + startup_timeout
        while time.monotonic() < deadline:
            for role, target, name, _ in commands:
                running = _host_exec(target, ["docker", "inspect", "--format",
                                              "{{.State.Running}}", name], capture=True)
                if running.returncode != 0 or running.stdout.strip() != "true":
                    raise RuntimeError(f"DeepSeek {role} container exited during model loading")
            healthy, _ = _host_text(head, ["curl", "-fsS", "--max-time", "5",
                                                  f"http://127.0.0.1:{profile['port']}/v1/models"])
            if healthy:
                ib_ready = True
                for role, target, name, _ in commands:
                    logs = _host_exec(target, ["docker", "logs", "--since", "30m", name],
                                      capture=True)
                    body = (logs.stdout or "") + (logs.stderr or "")
                    if logs.returncode != 0 or "NET/IB" not in body:
                        ib_ready = False
                        break
                if ib_ready:
                    _warm_deepseek_cluster(head, profile)
                    break
            time.sleep(10)
        else:
            raise RuntimeError(f"DeepSeek did not become healthy on NET/IB within {startup_timeout}s")
    except (RuntimeError, subprocess.CalledProcessError, OSError, KeyboardInterrupt) as e:
        reason = "launch interrupted" if isinstance(e, KeyboardInterrupt) else str(e)
        print(f"ERROR: {reason}; rolling back DeepSeek rank containers.", file=sys.stderr)
        failures = []
        for target, name in reversed(started):
            try:
                removed = _host_exec(target, ["docker", "rm", "-f", name], capture=True)
                if removed.returncode != 0:
                    failures.append(name)
            except OSError:
                failures.append(name)
        if failures:
            print("ERROR: rollback could not remove: " + ", ".join(failures), file=sys.stderr)
        if isinstance(e, KeyboardInterrupt):
            raise
        sys.exit(1)
    print(f"READY: '{profile_key}' passed warmups across '{cfg['name']}' on NCCL NET/IB; "
          f"head API port {profile['port']}.")


