def cmd_health(args):
    need_docker()
    cfg = load_config(create=False) if os.path.exists(CONFIG_PATH) else {"models": {}}
    hostaddr = remote_host() or "127.0.0.1"
    targets = []   # (label, host, port, running)
    if args.target:
        merged = merge_model(cfg, args.target) if args.target in cfg.get("models", {}) else None
        rows = list_managed(include_all=True)
        for r in rows:
            if r.get("Names") in (args.target, container_name(args.target)):
                targets.append((r.get("Names"), hostaddr,
                                _label(r.get("Labels", ""), LABEL_PORT), True))
        if not targets and merged:
            targets.append((args.target, hostaddr, merged["port"], False))
    else:
        for r in list_managed(include_all=args.all):
            targets.append((r.get("Names"), hostaddr,
                            _label(r.get("Labels", ""), LABEL_PORT), True))
    if not targets:
        print("No running containers to health-check.")
        return
    for label, host, port, running in targets:
        if not port:
            print(f"  {label}: unknown port"); continue
        phase, detail = http_models(host, int(port))
        if phase == "ready":
            print(f"  {label:<28} :{port}  READY  {detail}")
        elif phase == "starting" and running:
            print(f"  {label:<28} :{port}  STARTING  vLLM still loading (weights+compile+warmup) "
                  "-- normal for a few min after launch; keep polling, this is NOT an error")
        elif phase == "starting":
            print(f"  {label:<28} :{port}  DOWN  nothing listening and no running container "
                  "(launch it, or it crashed -- check `logs`)")
        else:
            print(f"  {label:<28} :{port}  not ready  {detail}")


def http_models(host, port, timeout=3.0):
    """(phase, detail): 'ready' (models listed), 'starting' (nothing listening yet --
    connection refused/timeout, i.e. the server is still coming up), or 'error' (it
    answered but not with a model list)."""
    url = f"http://{host}:{port}/v1/models"
    try:
        req = urllib.request.Request(url, headers={"Authorization": "Bearer x"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", "ignore"))
        ids = [m.get("id") for m in data.get("data", []) if m.get("id")]
        return "ready", ", ".join(ids) if ids else "(no model ids)"
    except urllib.error.HTTPError as e:
        return "error", f"HTTP {e.code}"
    except (urllib.error.URLError, OSError):
        return "starting", "server not listening yet"


def _print_results(results):
    print()
    width = max(len(r[0]) for r in results)
    for name, ok, detail in results:
        mark = "[ok]  " if ok is True else ("[--]  " if ok is None else "[FAIL]")
        print(f"  {mark} {name:<{width}}  {detail}")


def _r_ok(target, cmd):
    """True if a remote command exits 0; returns (ok, stdout)."""
    res = run_remote(target, cmd, capture=True, batch=True)
    return res.returncode == 0, (res.stdout or "").strip()


def cmd_install(args):
    """Bootstrap remote prereqs AND register the host (with an optional alias) so
    `ps` and `--host` can find it. Merges into the registry -- other hosts stay."""
    raw = args.target or REMOTE
    if not raw:
        print("ERROR: install needs a target, e.g. `install user@192.0.2.101 dgx1` "
              "(user@ip and an optional alias; comma-separate several hosts if you skip the alias).",
              file=sys.stderr)
        sys.exit(1)
    if not shutil.which("ssh"):
        print("ERROR: no `ssh` client on PATH.", file=sys.stderr)
        sys.exit(1)
    hosts = [h.strip() for h in raw.split(",") if h.strip()]
    alias = (getattr(args, "alias", None) or "").strip() or None
    if alias and len(hosts) != 1:
        print("ERROR: an alias names a single host -- pass just one user@ip when you give an alias.",
              file=sys.stderr)
        sys.exit(1)
    existing = load_hosts()                      # [(alias, target)] already registered
    prior_alias = {t: a for a, t in existing}
    connected, all_ready = [], True
    for target in hosts:
        ready, ssh_ok = _setup_host(target, args.fix)
        all_ready = all_ready and ready
        if ssh_ok:
            connected.append((alias or prior_alias.get(target) or target, target))
    if connected:
        # Merge, don't overwrite: keep other registered hosts, add/replace these.
        new_targets = {t for _, t in connected}
        merged = [(a, t) for a, t in existing if t not in new_targets] + connected
        save_hosts(merged)
        print()
        print(f"-> registered {len(connected)} host(s) for `ps` / `--host` in {HOSTS_FILE}:")
        for a, t in connected:
            print(f"     {a:<12} {t}" if a != t else f"     {t}")
    sys.exit(0 if all_ready else 1)


def cmd_uninstall(args):
    """Undo `install`: drop the host from the registry and revoke the otools key
    from its authorized_keys. With --purge, also remove it from the docker group
    and stop its otools containers (best-effort). Leaves the shared local key."""
    name = args.target
    if not name:
        print("ERROR: uninstall needs an alias or user@ip, e.g. `uninstall dgx1`.", file=sys.stderr)
        sys.exit(1)
    target = resolve_host(name)
    existing = load_hosts()
    aliases = {a for a, _ in existing}
    targets = {t for _, t in existing}
    if target not in targets and name not in aliases:
        print(f"WARNING: {name!r} is not registered in {HOSTS_FILE}; "
              f"still attempting to revoke the key on {target}.")

    if shutil.which("ssh"):
        print(f"-> revoking the otools key on {target} "
              f"(authorized_keys line matching '{OTOOLS_SSH_COMMENT}') ...")
        revoke = ("sed -i '/%s/d' ~/.ssh/authorized_keys 2>/dev/null || true"
                  % OTOOLS_SSH_COMMENT)
        rc = subprocess.run(ssh_argv(target) + [revoke]).returncode
        print("   done." if rc == 0 else f"   could not reach {target}; skipped key revoke.")
        if args.purge:
            print(f"-> --purge: stopping otools containers, removing the docker group "
                  f"membership and the drop-caches sudo rule on {target} (sudo; may prompt) ...")
            purge = ("docker ps -aq --filter name=%s | xargs -r docker rm -f 2>/dev/null; "
                     "sudo gpasswd -d $USER docker 2>/dev/null || true; "
                     "sudo rm -f %s %s 2>/dev/null || true"
                     % (NAME_PREFIX, DROP_CACHES_SUDOERS, DROP_CACHES_HELPER))
            run_remote(target, purge, tty=True, batch=False)
    else:
        print("WARNING: no `ssh` client on PATH -- skipping remote key revoke.")

    remaining = [(a, t) for a, t in existing if t != target and a != name]
    save_hosts(remaining)
    print(f"-> removed {name} from {HOSTS_FILE} ({len(remaining)} host(s) remain).")
    print(f"\nNote: the shared local key {OTOOLS_SSH_KEY} was left in place "
          f"(other hosts may still use it).")
    print(f"  To remove it everywhere: rm {OTOOLS_SSH_KEY} {OTOOLS_SSH_PUB}")


def _setup_host(target, fix):
    """Check/install prerequisites for ONE host. Returns (ready, ssh_ok)."""
    print(f"Setup for {target}  "
          f"({'FIX mode -- will make changes' if fix else 'check-only; pass --fix to remediate'})")
    results = []

    # 0) HF token (local) -- required for gated models (e.g. nvidia/*). Stored at
    #    ~/.config/otools/hf_token (0600); launches forward it automatically.
    tok = hf_token()
    if not tok and fix:
        print("\nNo HF_TOKEN found. Gated models (e.g. nvidia/*) need one to download.")
        print(f"  1. Open {HF_TOKENS_URL}")
        print("  2. 'Create new token' -> Token type: Read -> name it (e.g. otools) -> Create")
        print("  3. Copy it (starts with 'hf_') and paste below.")
        try:
            entered = getpass.getpass("  Paste HF token (hidden), or Enter to skip: ").strip()
        except (EOFError, KeyboardInterrupt):
            entered = ""
        if entered:
            save_hf_token(entered)
            tok = entered
            print(f"  saved to {HF_TOKEN_FILE} (chmod 600)")
    if tok:
        src = "$HF_TOKEN" if os.environ.get("HF_TOKEN") else HF_TOKEN_FILE
        results.append(("HF token", True, f"present (from {src})"))
    else:
        results.append(("HF token", None,
                        f"not set -- only needed for gated models; --fix to add ({HF_TOKENS_URL})"))

    # 1) dedicated, clearly-named SSH key (so it's easy to find and revoke later)
    have_key = os.path.exists(OTOOLS_SSH_KEY)
    if not have_key and fix:
        os.makedirs(os.path.dirname(OTOOLS_SSH_KEY), exist_ok=True)
        print(f"-> generating a dedicated key: {OTOOLS_SSH_KEY}  (comment: {OTOOLS_SSH_COMMENT})")
        subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "", "-f", OTOOLS_SSH_KEY,
                        "-C", OTOOLS_SSH_COMMENT])
        have_key = os.path.exists(OTOOLS_SSH_KEY)
    results.append(("otools SSH key", have_key,
                    f"{OTOOLS_SSH_KEY}" if have_key
                    else f"missing; --fix to generate ({OTOOLS_SSH_KEY})"))

    # 2) keyless SSH using THAT key (ssh_opts() now pins -i once the key exists)
    ok, _ = _r_ok(target, "true") if have_key else (False, "")
    if not ok and fix and have_key:
        print("-> installing the otools key on the remote (enter the remote password once)")
        if shutil.which("ssh-copy-id"):
            subprocess.run(["ssh-copy-id", "-i", OTOOLS_SSH_PUB, target])
        else:
            pubkey = open(OTOOLS_SSH_PUB).read().strip()
            remote_cmd = ("mkdir -p ~/.ssh && chmod 700 ~/.ssh && "
                          "printf '%s\\n' " + shlex.quote(pubkey) + " >> ~/.ssh/authorized_keys && "
                          "chmod 600 ~/.ssh/authorized_keys")
            subprocess.run(ssh_argv(target) + [remote_cmd])   # interactive (password)
        ok, _ = _r_ok(target, "true")
    results.append(("keyless SSH", ok, "connected with otools key" if ok
                    else "no passwordless login; --fix to set up"))
    if not ok:
        _print_results(results)
        print("\nSSH must work before the rest -- skipping this host.")
        return False, False

    # 3) docker installed
    dok, _ = _r_ok(target, "command -v docker")
    if not dok and fix:
        print("-> installing Docker via get.docker.com (sudo; may prompt on the remote) ...")
        run_remote(target,
                   "curl -fsSL https://get.docker.com -o /tmp/get-docker.sh && sudo sh /tmp/get-docker.sh",
                   tty=True, batch=False)
        dok, _ = _r_ok(target, "command -v docker")
    ver = _r_ok(target, "docker --version")[1] if dok else ""
    results.append(("docker installed", dok, ver or "missing; --fix to install"))

    # 4) docker usable without sudo (docker group)
    nosudo, _ = (_r_ok(target, "docker info") if dok else (False, ""))
    in_grp = ("docker" in _r_ok(target, "id -nG")[1].split()) if dok else False
    if not nosudo and dok and fix:
        print("-> adding remote user to the `docker` group (sudo; prompt) ...")
        run_remote(target, "sudo usermod -aG docker $USER", tty=True, batch=False)
        in_grp = True
        detail = "added to docker group -- LOG OUT/IN (or reboot) on the remote, then re-run setup"
        results.append(("docker w/o sudo", False, detail))
    else:
        results.append(("docker w/o sudo", nosudo,
                        "ok" if nosudo else ("in group but session stale; re-login" if in_grp
                                             else "not in docker group; --fix to add")))

    # 4.5) passwordless page-cache drop -- every launch runs it (UMA guard, vLLM #35313),
    #      so install a scoped helper + NOPASSWD rule now (one sudo prompt) and it's silent
    #      forever after. Checked with `sudo -n -l` so it doesn't actually drop caches here.
    if fix:
        print("-> installing the scoped drop-caches helper + NOPASSWD sudoers rule "
              f"({DROP_CACHES_HELPER}; sudo, may prompt once) ...")
        run_remote(target, _drop_caches_install_cmd(), tty=True, batch=False)
    dc_ok, _ = _r_ok(target, "sudo -n -l %s >/dev/null 2>&1" % DROP_CACHES_HELPER)
    results.append(("drop-caches sudo", dc_ok,
                    "NOPASSWD rule active (launch drops page cache automatically)" if dc_ok
                    else "no NOPASSWD rule; --fix to add (launches warn + skip the drop otherwise)"))

    # 5) GPU: driver + container runtime (check + advise; we don't auto-install the toolkit)
    drv = _r_ok(target, "nvidia-smi -L 2>/dev/null | head -1")[1] if (nosudo or dok) else ""
    results.append(("nvidia driver", bool(drv), drv or "nvidia-smi not found on host"))
    # --gpus all can be backed EITHER by a registered "nvidia" runtime (legacy) OR by
    # CDI (Docker 25+/29 default with the toolkit). Check several signals so a working
    # CDI setup isn't a false negative.
    gpu_ok, gpu_detail = False, ""
    if nosudo:
        runtimes = _r_ok(target, "docker info --format '{{json .Runtimes}}' 2>/dev/null")[1].lower()
        has_ctk = _r_ok(target, "command -v nvidia-ctk")[0]
        has_cdi = _r_ok(target, "ls /etc/cdi/nvidia.yaml /etc/cdi/nvidia.json 2>/dev/null")[0]
        if "nvidia" in runtimes:
            gpu_ok, gpu_detail = True, "nvidia runtime registered"
        elif has_ctk:
            gpu_ok, gpu_detail = True, "nvidia-container-toolkit present (nvidia-ctk); --gpus via CDI"
        elif has_cdi:
            gpu_ok, gpu_detail = True, "CDI nvidia spec present (/etc/cdi)"
    if not gpu_ok and not gpu_detail:
        gpu_detail = ("no nvidia runtime / nvidia-ctk / CDI spec found -- install toolkit: "
                      "https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/"
                      "latest/install-guide.html")
    results.append(("docker GPU runtime", gpu_ok, gpu_detail))

    _print_results(results)
    if os.path.exists(OTOOLS_SSH_KEY):
        print(f"\nThis tool uses its own key {OTOOLS_SSH_KEY} (comment '{OTOOLS_SSH_COMMENT}').")
        print(f"  To revoke later: on the remote, delete the authorized_keys line matching "
              f"'{OTOOLS_SSH_COMMENT}'\n"
              f"    ssh {target} \"sed -i '/{OTOOLS_SSH_COMMENT}/d' ~/.ssh/authorized_keys\"\n"
              f"  and locally: rm {OTOOLS_SSH_KEY} {OTOOLS_SSH_PUB}")
    essentials = {"keyless SSH", "docker installed", "docker w/o sudo",
                  "nvidia driver", "docker GPU runtime", "drop-caches sudo"}
    ready = all(ok for name, ok, _ in results if name in essentials)
    print(f"\n{'READY: launch away.' if ready else 'NOT READY -- address the [FAIL] rows above'}"
          + ("" if fix else "  (re-run with --fix to remediate)"))
    ssh_ok = next((o for n, o, _ in results if n == "keyless SSH"), False)
    return ready, ssh_ok


def cmd_config(args):
    if args.path:
        print(CONFIG_PATH)
        return
    if args.init:
        if os.path.exists(CONFIG_PATH) and not args.force:
            print(f"{CONFIG_PATH} exists. Use --force to overwrite.", file=sys.stderr)
            sys.exit(1)
        save_config(DEFAULT_CONFIG)
        print(f"Wrote default config to {CONFIG_PATH}")
        return
    if args.edit:
        load_config()   # ensure it exists
        editor = os.environ.get("EDITOR", "nano")
        sys.exit(subprocess.run([editor, CONFIG_PATH]).returncode)
    # default: show it
    cfg = load_config()
    print(f"# {CONFIG_PATH}")
    print(json.dumps(cfg, indent=2))


def cmd_shell_init(args):
    """Append an `omm` alias for this script to the user's shell rc (idempotent)."""
    script = os.path.abspath(__file__)
    alias_line = f"alias omm='python3 {shlex.quote(script)}'"
    marker = "# omodel-manager alias (omm)"
    rc = os.path.expanduser("~/.bashrc")
    existing = open(rc).read() if os.path.exists(rc) else ""
    if marker in existing:
        print(f"Alias already installed in {rc}  (omm -> {script})")
        return
    if args.dry_run:
        print(f"Would append to {rc}:\n  {marker}\n  {alias_line}")
        return
    with open(rc, "a") as f:
        f.write(f"\n{marker}\n{alias_line}\n")
    print(f"Installed `omm` alias in {rc}.")
    print(f"  Activate now:  source {rc}   (or open a new shell)")


