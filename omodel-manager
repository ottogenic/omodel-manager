def _label(labels_str, key):
    # docker ps Labels field is "k1=v1,k2=v2"
    for part in (labels_str or "").split(","):
        if part.startswith(key + "="):
            return part[len(key) + 1:]
    return None


def _fmt_tokens(n):
    """262144 -> '256K', 1048576 -> '1M'."""
    try:
        n = int(n)
    except (TypeError, ValueError):
        return "?"
    if n % (1024 * 1024) == 0:
        return f"{n // (1024 * 1024)}M"
    if n % 1024 == 0:
        return f"{n // 1024}K"
    return str(n)


def _fmt_tokps(v):
    """Recorded decode speed (single user @ ~100k context) for the `list` table.
    A profile's `tok_s` is filled in from the benchmark (see the add-a-model skill);
    unmeasured profiles show '—'."""
    try:
        return str(int(round(float(v))))
    except (TypeError, ValueError):
        return "—"


