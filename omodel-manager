def _prog():
    return sys.argv[0]


def _cli_name():
    """Display name for suggested commands — always 'omm' so paths don't clutter output."""
    return "omm"


def _host_label(target):
    """A registered alias for this host if one exists, else the raw target -- so
    suggested commands read `--host dgx1`, not `--host user@ip`."""
    if not target:
        return target
    for alias, t in load_hosts():
        if t == target and alias != t:
            return alias
    return target


def _rsuf():
    """' --host X' (alias-preferred) if a remote is in play, else '' (for examples)."""
    return f" --host {_host_label(REMOTE)}" if REMOTE else ""


def _suggest(items, header="Next steps"):
    """items: list of (description, command-string). Prints a breadcrumb block."""
    items = [it for it in items if it]
    if not items:
        return
    print(f"\n{header}:")
    for desc, cmd in items:
        print(f"  - {desc}")
        print(f"      {cmd}")


def cmd_home(args):
    """First-run-friendly landing screen: status + suggested next steps. No docker calls."""
    cfg = load_config()
    models = cfg.get("models", {})
    sample = next(iter(sorted(models)), "<profile>")
    p, setup_done = _cli_name(), os.path.exists(OTOOLS_SSH_KEY)
    print("otools_model_manager -- manage vLLM Docker containers (local or over SSH)\n")
    print("Status:")
    print(f"  config : {CONFIG_PATH}  ({len(models)} model profile(s))")
    print(f"  host   : {REMOTE or 'local (no default host; use --host, or set defaults.remote)'}")
    print(f"  setup  : {'done -- key ' + OTOOLS_SSH_KEY if setup_done else 'not run yet'}")
    host = REMOTE or "user@host"
    items = []
    if not setup_done:
        items.append(("Bootstrap + name a host (keyless SSH, docker, HF token)",
                      f"{p} install {host} dgx1 --fix"))
    items += [
        ("List available models (context, concurrency, use-case)", f"{p} list"),
        ("Run a model", f"{p} launch {sample}{_rsuf()}"),
        ("See what's running", f"{p} ps{_rsuf()}"),
    ]
    _suggest(items, header="Suggested next steps")


def load_hosts():
    """Registered remote hosts (managed by `install`). Returns a list of
    (alias, target) tuples, order-preserving. File format: one `alias<TAB>user@host`
    per line in ~/.config/otools/hosts; a bare `user@host` line has alias == itself.
    Blank lines and #-comments are ignored."""
    out = []
    try:
        with open(HOSTS_FILE) as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):
                    continue
                parts = ln.split(None, 1)          # first whitespace splits alias from target
                if len(parts) == 2:
                    out.append((parts[0], parts[1].strip()))
                else:
                    out.append((parts[0], parts[0]))
    except OSError:
        pass
    return out


def host_targets():
    """Just the user@host targets `ps` queries (aliases dropped)."""
    return [t for _, t in load_hosts()]


def resolve_host(name):
    """Map an alias to its user@host target; pass a raw user@host / unknown through
    unchanged (SSH surfaces a clear error if it's bogus)."""
    if not name:
        return name
    for alias, target in load_hosts():
        if name == alias:
            return target
    return name


def save_hosts(pairs):
    """Overwrite the hosts file. `pairs` items are (alias, target) tuples or bare
    `user@host` strings (alias defaults to the target). Dedup by target, order-kept."""
    seen, uniq = set(), []
    for p in pairs:
        alias, target = (p, p) if isinstance(p, str) else (p[0] or p[1], p[1])
        if target and target not in seen:
            seen.add(target)
            uniq.append((alias, target))
    os.makedirs(os.path.dirname(HOSTS_FILE), exist_ok=True)
    with open(HOSTS_FILE, "w") as f:
        print("# omodel-manager remote hosts (managed by `install`).", file=f)
        print("# Format: `alias<TAB>user@host`  (or a bare `user@host`). Safe to hand-edit.", file=f)
        for alias, target in uniq:
            print(target if alias == target else "%s\t%s" % (alias, target), file=f)


def _pulling_keys(target):
    """Profile keys with a background launch still in progress on `target` -- a
    launch-<key>.log that exists but hasn't recorded a terminal marker yet. Lets
    `ps` flag a box that's mid-pull instead of showing it as free. Best-effort."""
    cmd = ('for f in "$HOME"/.config/otools/launch-*.log; do [ -e "$f" ] || continue; '
           "grep -qE 'OTOOLS_LAUNCH_OK|OTOOLS_LAUNCH_FAILED' \"$f\" || "
           '{ b=$(basename "$f" .log); echo "${b#launch-}"; }; done')
    try:
        if target:
            res = run_remote(target, cmd, capture=True, batch=True)
        else:
            res = subprocess.run(["sh", "-c", cmd], text=True, capture_output=True)
    except OSError:
        return []
    if res.returncode != 0:
        return []
    return [ln.strip() for ln in res.stdout.splitlines() if ln.strip()]


def _looks_ip(s):
    parts = s.split(".")
    return len(parts) == 4 and all(p.isdigit() for p in parts)


def host_of(name):
    """If `name` refers to a HOST -- a registered alias (from `install`), a user@host,
    or a bare IP -- return it (to be resolved as the --host target); else None. This
    lets `logs <hostname>` address the model running on that box without naming it.
    A profile key / container name is never a registered alias or an IP, so it returns
    None and falls through to the normal name lookup."""
    if not name:
        return None
    if "@" in name or _looks_ip(name):
        return name
    return name if any(name == a for a, _ in load_hosts()) else None


def _managed_on(remote):
    """(container_name, model_key) for the single managed container on `remote`, or
    exit with a clear error. Used when a command gets a host but no model name."""
    rows = list_managed(remote=remote)
    if len(rows) > 1:
        names = ", ".join(r.get("Names", "") for r in rows)
        print(f"ERROR: {len(rows)} managed containers on {remote or 'local'} ({names}). "
              f"Name the model too, e.g. `{_cli_name()} logs <model> --host <host>`.",
              file=sys.stderr)
        sys.exit(1)
    if not rows:
        print(f"ERROR: no managed container running on {remote or 'local'} "
              f"(idle, or still pulling? see `{_cli_name()} ps`).", file=sys.stderr)
        sys.exit(1)
    r = rows[0]
    return r.get("Names"), (_label(r.get("Labels", ""), LABEL_MODEL) or r.get("Names"))


def cmd_ps(args):
    p = _cli_name()
    registered = load_hosts()                       # [(alias, target)]
    alias_of = {t: a for a, t in registered}
    hlabel = lambda t: alias_of.get(t) or (t if t else "localhost")

    # Targets, and whether to also show registered hosts that have nothing running.
    # explicit --hosts > --host/--remote > registered hosts > local.
    if args.hosts:
        targets = [resolve_host(h) for h in args.hosts]
        show_idle = True
    elif REMOTE:
        targets = [REMOTE]
        show_idle = False
    elif registered:
        targets = [t for _, t in registered]
        show_idle = True
    else:
        targets = [None]
        show_idle = False

    if None in targets:
        need_docker()
    elif any(targets) and not shutil.which("ssh"):
        print("ERROR: `ssh` not found on PATH (needed for --host).", file=sys.stderr)
        sys.exit(1)

    all_rows, state, pulling = [], {}, {}
    for t in targets:
        try:
            rows = list_managed(include_all=args.all, remote=t)
        except SystemExit:
            state[t] = "unreachable"
            continue
        for r in rows:
            r["_host"] = t
        all_rows.extend(rows)
        pulling[t] = _pulling_keys(t)            # background launches still mid-pull
        state[t] = "running" if rows else ("pulling" if pulling[t] else "idle")

    if not all_rows and not show_idle and not any(pulling.values()):
        print("No running managed vLLM containers."
              + ("" if args.all else "  (try --all to include unmanaged ones)"))
        _suggest([
            ("List available models", f"{p} list"),
            ("Run a model", f"{p} launch <profile>{_rsuf()}"),
        ])
        return

    print(f"{'HOST':<16} {'NAME':<28} {'MODEL':<28} {'PORT':<6} {'STATUS'}")
    for r in all_rows:
        labels = r.get("Labels", "")
        model = _label(labels, LABEL_MODEL) or r.get("Image", "")[:28]
        port = _label(labels, LABEL_PORT) or "?"
        cname = r.get("Names", "")
        name = cname[len(NAME_PREFIX):] if cname.startswith(NAME_PREFIX) else cname
        print(f"{hlabel(r.get('_host')):<16} {name:<28} {model:<28} {str(port):<6} {r.get('Status','')}")
    for t in targets:                                # a box mid-pull isn't free -- surface it
        for key in pulling.get(t, []):
            print(f"{hlabel(t):<16} {key:<28} {'—':<28} {'—':<6} pulling image")
    if show_idle:                                    # idle/unreachable hosts so agents can pick one
        for t in targets:
            st = state.get(t)
            if st in ("idle", "unreachable"):
                label = "idle" if st == "idle" else "unreachable (ssh)"
                print(f"{hlabel(t):<16} {'—':<28} {'—':<28} {'—':<6} {label}")

    if all_rows:                                     # address the model by its host (stable, unlike an index)
        fh = all_rows[0].get("_host")
        ref = hlabel(fh) if fh else (_label(all_rows[0].get("Labels", ""), LABEL_MODEL)
                                     or all_rows[0].get("Names"))
        _suggest([
            ("View a model's logs (by host; Ctrl-C to stop)", f"{p} logs {ref} -f"),
            ("Check readiness", f"{p} health {ref}"),
            ("Stop a model", f"{p} stop {ref}"),
        ])
    else:
        idle = [hlabel(t) for t in targets if state.get(t) == "idle"]
        _suggest([
            ("Launch on a free host", f"{p} launch <profile> {idle[0] if idle else '<host>'}"),
            ("List available models", f"{p} list"),
        ])


def _label(labels_str, key):
    # docker ps Labels field is "k1=v1,k2=v2"
    for part in (labels_str or "").split(","):
        if part.startswith(key + "="):
            return part[len(key) + 1:]
    return None


def _fmt_tokens(n):
    """262144 -> '256K', 1048576 -> '1M'."""
    try:
        n = int(n)
    except (TypeError, ValueError):
        return "?"
    if n % (1024 * 1024) == 0:
        return f"{n // (1024 * 1024)}M"
    if n % 1024 == 0:
        return f"{n // 1024}K"
    return str(n)


def _fmt_tokps(v):
    """Recorded decode speed (single user @ ~100k context) for the `list` table.
    A profile's `tok_s` is filled in from the benchmark (see the add-a-model skill);
    unmeasured profiles show '—'."""
    try:
        return str(int(round(float(v))))
    except (TypeError, ValueError):
        return "—"


def cmd_models(args):
    cfg = load_config()
    models = cfg.get("models", {})
    if not models:
        print("No models defined. Edit the config or run `config --init`.")
        return

    rows = []
    for key in sorted(models):
        e = resolve_entry(cfg, key)               # apply `extends` so inherited fields show
        va = e.get("vllm_args", {})
        served = va.get("served-model-name") or e.get("model", "?")
        rows.append((
            key,
            served,
            _fmt_tokens(va.get("max-model-len") or e.get("limit", {}).get("context")),
            str(va.get("max-num-seqs", 1)),
            _fmt_tokps(e.get("tok_s")),          # decode tok/s, 1 user @ ~100k (from benchmark)
            ", ".join(e.get("usecase", [])) or "-",
        ))

    headers = ("PROFILE", "MODEL", "CONTEXT", "USERS", "Tk/s", "USE-CASE")
    w = [max(len(str(c)) for c in col) for col in zip(headers, *rows)]
    print(f"Models defined in {CONFIG_PATH}:\n")
    print("  " + "  ".join(h.ljust(w[i]) for i, h in enumerate(headers)))
    print("  " + "  ".join("-" * w[i] for i in range(len(headers))))
    for r in rows:
        print("  " + "  ".join(str(r[i]).ljust(w[i]) for i in range(len(headers))))

    p, sample, host = _cli_name(), next(iter(sorted(models))), (REMOTE or "user@host")
    _suggest([
        ("Run a model", f"{p} launch {sample}{_rsuf()}"),
        ("Run a model on a specific host", f"{p} launch {sample} --host {host}"),
        ("Run a model and watch its logs",
         f"{p} launch {sample} --host {host} && {p} logs {sample} --host {host} -f"),
    ])


def format_run(argv, target=None):
    """Human-readable, multi-line rendering of a `docker run` argv for dry-run/echo.
    Masks secret env values (tokens/keys). For DISPLAY only -- never executed."""
    secret = ("TOKEN", "SECRET", "PASSWORD", "KEY")

    def disp(t):
        if "=" in t and not t.startswith("-"):
            k, _, v = t.partition("=")
            if v and any(h in k.upper() for h in secret):
                return f"{k}={v[:3]}...(masked)"
        return t

    # Group tokens: each option starts a line, taking one following value if present;
    # bare positionals (e.g. the image) get their own line.
    lines, cur, i = [], ["docker", argv[0]], 1
    while i < len(argv):
        t = argv[i]
        if t.startswith("-"):
            lines.append(cur)
            cur = [t]
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                cur.append(argv[i + 1])
                i += 2
                continue
            i += 1
        else:
            lines.append(cur)
            cur = [t]
            i += 1
    lines.append(cur)
    rendered = " \\\n    ".join(" ".join(shlex.quote(disp(x)) for x in ln) for ln in lines)
    if target:
        return f"# on {target} over SSH ({' '.join(ssh_opts())})\n{rendered}"
    return rendered


def push_assets_remote(target, key, mounts, dry=False):
    """scp locally-cached assets to the remote box; return remote host:container mounts."""
    if not mounts:
        return mounts
    rdir = f"{remote_home(target)}/.otools/assets/{re.sub(r'[^a-zA-Z0-9_.-]', '-', key)}"
    if not dry:
        run_remote(target, f"mkdir -p {shlex.quote(rdir)}", batch=True)
    out = []
    for m in mounts:
        local, _, container = m.partition(":")
        rpath = f"{rdir}/{os.path.basename(local)}"
        if not dry:
            res = subprocess.run(["scp"] + ssh_opts() + [local, f"{target}:{rpath}"], text=True)
            if res.returncode != 0:
                print(f"ERROR: scp asset -> {target}:{rpath} failed.", file=sys.stderr)
                sys.exit(1)
        print(f"  asset: -> {target}:{rpath}")
        out.append(f"{rpath}:{container}")
    return out


def _image_present(image):
    """True if the image is already cached on the active docker host (no pull)."""
    return docker(["image", "inspect", image], capture=True).returncode == 0


def _launch_log_path(key):
    return f"~/.config/otools/launch-{key}.log"


# On UMA boxes (GB10 / DGX Spark) vLLM's cudaMemGetInfo can't see reclaimable page
# cache, so a warm cache reads as "used" -> false OOM at load, or a system freeze
# (vLLM #35313). Every launch drops the cache right before `docker run` to restore a
# clean read -- no flag, no config; it's just how launch works. `install` sets up a
# scoped NOPASSWD sudoers rule so `sudo -n` runs it unattended. `sudo -n` never
# prompts: if the rule is missing it fails fast and we warn (best-effort, never aborts
# the launch) instead of hanging on a password prompt.
DROP_CACHES_HELPER = "/usr/local/sbin/otools-drop-caches"
DROP_CACHES_SUDOERS = "/etc/sudoers.d/otools-drop-caches"
DROP_CACHES_CMD = "sudo -n " + DROP_CACHES_HELPER


def _drop_caches_install_cmd():
    """Remote shell (run once under interactive sudo by `install --fix`) that drops in
    the scoped drop-caches helper script + a NOPASSWD sudoers rule for the connecting
    user, then validates the rule with visudo. printf|tee avoids heredoc quoting."""
    script = "printf '#!/bin/sh\\nsync\\necho 3 > /proc/sys/vm/drop_caches\\n'"
    rule = ("printf '%s ALL=(root) NOPASSWD: " + DROP_CACHES_HELPER + "\\n' \"$(id -un)\"")
    return (
        f"{script} | sudo tee {DROP_CACHES_HELPER} >/dev/null "
        f"&& sudo chmod 0755 {DROP_CACHES_HELPER} "
        f"&& {rule} | sudo tee {DROP_CACHES_SUDOERS} >/dev/null "
        f"&& sudo chmod 0440 {DROP_CACHES_SUDOERS} "
        f"&& sudo visudo -cf {DROP_CACHES_SUDOERS}"
    )


def _drop_caches(target, dry=False):
    """Free the OS page cache on the target (local or remote) right before a launch."""
    where = f" on {target}" if target else " locally"
    if dry:
        print(f"    (would drop page cache{where}: {DROP_CACHES_CMD})")
        return
    print(f"Dropping page cache{where} (UMA launch guard, vLLM #35313) ...")
    if target:
        rc = run_remote(target, DROP_CACHES_CMD, batch=True).returncode
    else:
        rc = subprocess.run(["sh", "-c", DROP_CACHES_CMD]).returncode
    if rc != 0:
        print(f"  warning: drop-caches skipped (no NOPASSWD rule on {target or 'this host'}? "
              f"run `install {target or ''} --fix`); continuing.", file=sys.stderr)


def _launch_bg_command(key, image, run_argv):
    """Shell command that pulls the image, drops the page cache, starts the container
    detached, and writes a status marker to ~/.config/otools/launch-<key>.log, then
    backgrounds itself so the dispatcher returns at once. Runs on whichever host docker
    uses (local shell or the remote over SSH). The cache drop happens after the pull and
    right before `docker run`, grouped `|| true` so it can never fail the launch."""
    run_str = "docker " + " ".join(shlex.quote(a) for a in run_argv)
    steps = [
        "docker pull %s" % shlex.quote(image),
        "{ %s || true; }" % DROP_CACHES_CMD,
        run_str,
    ]
    inner = "%s && echo OTOOLS_LAUNCH_OK || echo OTOOLS_LAUNCH_FAILED" % " && ".join(steps)
    log = "$HOME/.config/otools/launch-%s.log" % key
    return ('mkdir -p "$HOME/.config/otools"; '
            "nohup sh -c %s > %s 2>&1 &" % (shlex.quote(inner), log))


def _launch_status(body):
    """Classify a background-launch log: 'none' | 'ok' | 'failed' | 'running'."""
    if not body or not body.strip():
        return "none"
    if "OTOOLS_LAUNCH_OK" in body:
        return "ok"
    if "OTOOLS_LAUNCH_FAILED" in body:
        return "failed"
    return "running"


def cmd_launch(args):
    cfg = load_config()
    merged = merge_model(cfg, args.key)
    # Per-model remote target overrides the config default (but not an explicit --host).
    global REMOTE
    if not args.remote and merged.get("remote"):
        REMOTE = resolve_host(merged["remote"])
    # Guard: hosts are registered but none was chosen -> don't silently launch local.
    if not REMOTE and not args.local:
        registered = load_hosts()
        if registered:
            names = ", ".join(a for a, _ in registered)
            print(f"ERROR: no host selected, but {len(registered)} host(s) are registered "
                  f"({names}).\n"
                  f"  Run on one:      {_cli_name()} launch {args.key} --host <alias>\n"
                  f"  Force local:     {_cli_name()} launch {args.key} --local\n"
                  f"  Find a free one: {_cli_name()} ps", file=sys.stderr)
            sys.exit(1)
    need_docker()
    # Download/verify declared assets locally, then (if remote) push them to the box.
    asset_mounts = resolve_assets(args.key, merged, do_fetch=not args.no_fetch,
                                  refresh=args.refresh, dry=args.dry_run)
    if REMOTE and asset_mounts:
        asset_mounts = push_assets_remote(REMOTE, args.key, asset_mounts, dry=args.dry_run)
    merged["volumes"] = list(merged.get("volumes", [])) + asset_mounts
    name, argv, warnings = build_run_argv(args.key, merged, foreground=args.foreground,
                                          target=REMOTE, keep=args.keep)

    # Refuse to clobber an existing container (running OR stopped) or double-bind a port.
    if not args.dry_run:
        rflag = f" --host {_host_label(REMOTE)}" if REMOTE else ""
        allc = docker(["ps", "-a", "--format", "{{.Names}}"], capture=True)
        if allc.returncode == 0 and name in allc.stdout.split():
            print(f"ERROR: container '{name}' already exists (running or stopped). "
                  f"Remove it first:\n  {sys.argv[0]} stop {args.key}{rflag}", file=sys.stderr)
            sys.exit(1)
        for r in list_managed(include_all=True):
            if not args.force and _label(r.get("Labels", ""), LABEL_PORT) == str(merged["port"]):
                print(f"ERROR: port {merged['port']} already used by '{r.get('Names')}'. "
                      f"Use --force to launch anyway.", file=sys.stderr)
                sys.exit(1)

    for w in warnings:
        print(f"  warning: {w}")

    where = f" on {REMOTE} (over SSH)" if REMOTE else " locally"
    if args.dry_run:
        print(f"--- DRY RUN: would launch '{args.key}'{where} ---")
        _drop_caches(REMOTE, dry=True)
        print(format_run(argv, REMOTE))
        return
    image = merged["image"]
    cached = _image_present(image)
    if not cached and not args.wait and not args.foreground:
        # Non-blocking launch: an uncached image pull can take minutes and time out
        # an agent's tool call. Pull + run in the background and return immediately.
        bg = _launch_bg_command(args.key, image, argv)
        loc = f"on {REMOTE}" if REMOTE else "locally"
        print(f"Image '{image}' is not cached {loc}; pulling in the background and starting "
              f"'{args.key}' when it's ready (container '{name}', port {merged['port']}).")
        if REMOTE:
            run_remote(REMOTE, bg, batch=True)
        else:
            subprocess.run(["sh", "-c", bg])
        p = _cli_name()
        _suggest([
            ("Check pull/launch progress", f"{p} pull-status {args.key}{_rsuf()}"),
            ("Watch container logs once it starts", f"{p} logs {args.key}{_rsuf()} -f"),
            ("Check readiness", f"{p} health {args.key}{_rsuf()}"),
            ("(Next time) pull inline and block", f"{p} launch {args.key}{_rsuf()} --wait"),
        ])
        return
    if not cached:
        # Blocking launch (--wait/--foreground) with an uncached image: pull inline.
        print(f"Image '{image}' is not cached{where}; pulling (can take several minutes) ...")
        if docker(["pull", image]).returncode != 0:
            print(f"ERROR: failed to pull '{image}'.", file=sys.stderr)
            sys.exit(1)

    _drop_caches(REMOTE)
    print(f"Launching '{args.key}' as container '{name}' on port {merged['port']}{where} ...")
    print(format_run(argv, REMOTE))
    res = docker(argv, tty=args.foreground)
    if res.returncode != 0:
        sys.exit(res.returncode)
    if not args.foreground:
        p = _cli_name()
        # Settle: a cached image launches in <1s -- faster than docker registers the
        # container -- so an immediate health/ps check can race and read a wrong state
        # (this is what makes agents loop). Pause a few seconds so the next check is
        # consistent, and catch a container that crashed instantly on startup.
        time.sleep(5)
        running = docker(["ps", "--format", "{{.Names}}"], capture=True)
        if running.returncode == 0 and name not in running.stdout.split():
            print(f"\nWARNING: '{name}' is NOT running ~5s after launch -- it likely crashed on "
                  f"startup. Read the log:\n  {p} logs {args.key}{_rsuf()}", file=sys.stderr)
            return
        print(f"\nStarted '{args.key}' (container '{name}'). The vLLM server inside is now "
              f"INITIALIZING -- weights + torch.compile + warmup take a few minutes.")
        print("Until it finishes, `health` reports STARTING and the port refuses connections --"
              " that is NORMAL, not an error. Poll `health` until it says READY:")
        _suggest([
            ("Poll readiness (~every 15s until READY)", f"{p} health {args.key}{_rsuf()}"),
            ("Watch startup logs (Ctrl-C to stop)", f"{p} logs {args.key}{_rsuf()} -f"),
            ("Stop this model", f"{p} stop {args.key}{_rsuf()}"),
        ])


def cmd_pull(args):
    """Pre-pull a profile's image so a later `launch` starts instantly."""
    cfg = load_config()
    merged = merge_model(cfg, args.key)
    global REMOTE
    if not args.remote and merged.get("remote"):
        REMOTE = resolve_host(merged["remote"])
    need_docker()
    image = merged["image"]
    where = f" on {REMOTE}" if REMOTE else " locally"
    if _image_present(image):
        print(f"Image '{image}' is already cached{where}.")
        return
    print(f"Pulling '{image}'{where} ...")
    sys.exit(docker(["pull", image]).returncode)


def cmd_pull_status(args):
    """Report the background launch/pull recorded in ~/.config/otools/launch-<key>.log."""
    global REMOTE
    # `pull-status <host>`: no key given but a host is set -> find what's on that box.
    if not args.key and REMOTE:
        rows = list_managed(remote=REMOTE)
        if rows:
            args.key = _label(rows[0].get("Labels", ""), LABEL_MODEL) or rows[0].get("Names")
        else:
            pk = _pulling_keys(REMOTE)
            args.key = pk[0] if pk else None
    if not args.key:
        print(f"ERROR: name a profile key, or a host that's running/pulling something "
              f"(see `{_cli_name()} ps`).", file=sys.stderr)
        sys.exit(1)
    cfg = load_config(create=False) if os.path.exists(CONFIG_PATH) else {"models": {}}
    merged = merge_model(cfg, args.key) if args.key in cfg.get("models", {}) else {}
    if not args.remote and merged.get("remote"):
        REMOTE = resolve_host(merged["remote"])
    where = f" on {REMOTE}" if REMOTE else " locally"
    log = _launch_log_path(args.key)
    if REMOTE:
        if not shutil.which("ssh"):
            print("ERROR: `ssh` not found on PATH.", file=sys.stderr)
            sys.exit(1)
        res = run_remote(REMOTE, f"cat {log} 2>/dev/null", capture=True, batch=True)
        body = res.stdout if res.returncode == 0 else ""
    else:
        try:
            body = open(os.path.expanduser(log)).read()
        except OSError:
            body = ""
    p = _cli_name()
    status = _launch_status(body)
    if status == "none":
        # No bg-pull log. If the container is already running, it was a direct (cached-image)
        # launch -- say so plainly instead of "nothing is pulling", which reads like a failure
        # and sends agents into a poll loop.
        running = any(r.get("Names") == container_name(args.key) for r in list_managed(remote=REMOTE))
        if running:
            print(f"'{args.key}': launched directly (image was cached); the container is "
                  f"running{where}. There's no pull to track -- poll `{p} health "
                  f"{args.key}{_rsuf()}` until READY.")
        else:
            print(f"No background launch in progress for '{args.key}'{where}. "
                  f"Start one with `{p} launch {args.key}{_rsuf()}`.")
        return
    lines = body.strip().splitlines()
    if status == "ok":
        print(f"'{args.key}': image pulled and container started{where}.")
        _suggest([
            ("Check readiness", f"{p} health {args.key}{_rsuf()}"),
            ("Watch logs", f"{p} logs {args.key}{_rsuf()} -f"),
        ])
    elif status == "failed":
        print(f"'{args.key}': background launch FAILED{where}. Last lines:")
        for ln in lines[-10:]:
            print(f"   {ln}")
        sys.exit(1)
    else:
        print(f"'{args.key}': still pulling/starting{where}.")
        print(f"   {lines[-1]}")
        _suggest([("Poll again", f"{p} pull-status {args.key}{_rsuf()}")])


