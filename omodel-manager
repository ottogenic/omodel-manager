def cmd_cluster_stop(args):
    cfg = getattr(args, "cluster_config", None) or cluster_config(args.name)
    cluster_name = cfg["name"]
    head, worker = _cluster_targets(cfg)
    if not args.yes:
        reply = input(f"Stop all managed ranks in cluster '{cluster_name}'? [y/N] ").strip().lower()
        if reply not in ("y", "yes"):
            print("Aborted."); return False
    stopped, failures = 0, []
    for role, target in (("head", head), ("worker", worker)):
        rows = list_managed(remote=target, include_stopped=True)
        if rows is None:
            failures.append(f"{role} unreachable")
            continue
        for row in rows:
            if _label(row.get("Labels", ""), LABEL_CLUSTER) != cluster_name:
                continue
            name = row.get("Names")
            if not name:
                continue
            if _host_exec(target, ["docker", "rm", "-f", name]).returncode == 0:
                print(f"Stopped {role}: {name}"); stopped += 1
            else:
                failures.append(f"{role} failed to stop {name}")
    print(f"Stopped {stopped} rank container(s).")
    if failures:
        print("ERROR: " + "; ".join(failures), file=sys.stderr)
        sys.exit(1)
    return True


