def load_config(path=None, create=True):
    path = path or CONFIG_PATH
    if not os.path.exists(path):
        if not create:
            print(f"No config at {path}. Run `config --init` to create one.", file=sys.stderr)
            sys.exit(1)
        save_config(DEFAULT_CONFIG, path)
        print(f"Created default config at {path}")
        return json.loads(json.dumps(DEFAULT_CONFIG))   # deep copy
    try:
        with open(path) as f:
            return json.load(f)
    except (json.JSONDecodeError, OSError) as e:
        print(f"ERROR: could not read {path}: {e}", file=sys.stderr)
        sys.exit(1)


def save_config(cfg, path=None):
    path = path or CONFIG_PATH
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")


def _deep_merge(base, over):
    """Return base with `over` layered on top. Dicts merge recursively; lists and
    scalars from `over` replace base's (absent keys inherit base)."""
    out = json.loads(json.dumps(base))   # deep copy
    for k, v in over.items():
        if k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k] = _deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def resolve_entry(cfg, key, _seen=None):
    """Resolve a model entry, applying its `extends` chain (child overrides base)."""
    models = cfg.get("models", {})
    if key not in models:
        avail = ", ".join(sorted(models)) or "(none)"
        print(f"ERROR: no model '{key}' in config. Available: {avail}", file=sys.stderr)
        sys.exit(1)
    _seen = _seen or set()
    if key in _seen:
        print(f"ERROR: circular `extends` involving '{key}'.", file=sys.stderr)
        sys.exit(1)
    _seen.add(key)
    m = models[key]
    if m.get("extends"):
        base = resolve_entry(cfg, m["extends"], _seen)
        child = {k: v for k, v in m.items() if k != "extends"}
        return _deep_merge(base, child)
    return json.loads(json.dumps(m))


def merge_model(cfg, key):
    """Resolve a model profile: apply `extends`, then merge defaults underneath."""
    d = cfg.get("defaults", {})
    m = resolve_entry(cfg, key)
    merged = {
        "image": m.get("image", d.get("image", DEFAULT_IMAGE)),
        "host": m.get("host", d.get("host", "127.0.0.1")),
        "gpus": m.get("gpus", d.get("gpus", "all")),
        "hf_cache": m.get("hf_cache", d.get("hf_cache", "~/.cache/huggingface")),
        "model": m.get("model"),
        "port": m.get("port"),
        "remote": m.get("remote", d.get("remote")),
        "docker_flags": list(d.get("docker_flags", [])) + list(m.get("docker_flags", [])),
        "volumes": list(d.get("volumes", [])) + list(m.get("volumes", [])),
        "assets": list(d.get("assets", [])) + list(m.get("assets", [])),
        "env": {**d.get("env", {}), **m.get("env", {})},
        "vllm_args": {**d.get("vllm_args", {}), **m.get("vllm_args", {})},
    }
    if not merged["model"] or not merged["port"]:
        print(f"ERROR: model '{key}' must set 'model' and 'port'.", file=sys.stderr)
        sys.exit(1)
    return merged


def container_name(key):
    safe = re.sub(r"[^a-zA-Z0-9_.-]", "-", key)
    return f"{NAME_PREFIX}{safe}"


def expand_path(p):
    """Expand a host path: ${PWD}/$PWD -> cwd, then ~ and other $VARs.
    Lets a volume spec mirror the shell's `$(pwd)` while running shell-free."""
    cwd = os.getcwd()
    p = p.replace("${PWD}", cwd).replace("$PWD", cwd)
    return os.path.expanduser(os.path.expandvars(p))


def assets_dir():
    """Where downloaded assets are cached: <config dir>/assets (kept in the repo)."""
    return os.path.join(os.path.dirname(os.path.abspath(CONFIG_PATH)), "assets")


def asset_local_path(key, url):
    fname = url.split("?")[0].rstrip("/").split("/")[-1] or "asset"
    safe_key = re.sub(r"[^a-zA-Z0-9_.-]", "-", key)
    return os.path.join(assets_dir(), safe_key, fname)


def download_file(url, dest, refresh=False):
    """Download url->dest (atomic). Sends HF_TOKEN for huggingface.co URLs."""
    if os.path.exists(dest) and not refresh:
        return True, "cached"
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    headers = {"User-Agent": "otools-model-manager"}
    tok = os.environ.get("HF_TOKEN")
    if tok and "huggingface.co" in url:
        headers["Authorization"] = f"Bearer {tok}"
    tmp = dest + ".part"
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=120) as resp, open(tmp, "wb") as f:
            shutil.copyfileobj(resp, f)
        os.replace(tmp, dest)
        return True, "downloaded"
    except (urllib.error.URLError, urllib.error.HTTPError, OSError) as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        return False, f"ERROR: {e}"


def resolve_assets(key, merged, do_fetch=True, refresh=False, dry=False):
    """Ensure each declared asset exists locally; return [host:container] mounts.
    Exits if a required asset can't be made available for a real launch."""
    mounts = []
    for a in merged.get("assets", []):
        url = a.get("url")
        container = a.get("container") or a.get("dest")
        if not url or not container:
            print("  asset: skipping malformed entry (needs 'url' and 'container')")
            continue
        local = os.path.expanduser(a.get("local") or asset_local_path(key, url))
        exists = os.path.exists(local)
        if do_fetch and not dry and (refresh or not exists):
            ok, msg = download_file(url, local, refresh=refresh)
            print(f"  asset: {os.path.basename(local)} -> {msg}")
            if not ok and not os.path.exists(local):
                print(f"ERROR: required asset could not be fetched:\n  {url}\n  {msg}",
                      file=sys.stderr)
                sys.exit(1)
        else:
            state = "present" if exists else ("will fetch on launch" if not dry else "MISSING")
            print(f"  asset: {os.path.basename(local)} -> {state}  ({local})")
        if not dry and not os.path.exists(local):
            print(f"ERROR: asset missing and not fetched (use without --no-fetch): {local}",
                  file=sys.stderr)
            sys.exit(1)
        mounts.append(f"{local}:{container}")
    return mounts


# ============================================================================
# Remote execution (SSH). REMOTE is "user@host" (or "host") or None for local.
# Every docker call funnels through docker(), so remoting is just wrapping it.
# ============================================================================
REMOTE = None
_remote_home_cache = {}

# A dedicated, clearly-named key so it's obvious where it came from and easy to
# revoke later. Comment embeds the tool + laptop hostname (visible in the remote
# authorized_keys). The tool USES this key exclusively once it exists.
OTOOLS_SSH_KEY = os.path.expanduser("~/.ssh/otools_model_manager_ed25519")
OTOOLS_SSH_PUB = OTOOLS_SSH_KEY + ".pub"
OTOOLS_SSH_COMMENT = f"otools_model_manager@{socket.gethostname()}"


def ssh_opts():
    """Common ssh/scp options. Pins our dedicated key (only once it exists) so the
    tool's access is self-contained and removable, independent of your other keys."""
    opts = ["-o", "ConnectTimeout=10"]
    if os.path.exists(OTOOLS_SSH_KEY):
        opts += ["-i", OTOOLS_SSH_KEY, "-o", "IdentitiesOnly=yes"]
    return opts


def remote_host():
    """The host part of REMOTE (for network health checks)."""
    return REMOTE.split("@")[-1] if REMOTE else None


def ssh_argv(target, batch=False, tty=False):
    a = ["ssh"]
    if batch:
        a += ["-o", "BatchMode=yes"]
    if tty:
        a += ["-tt"]
    return a + ssh_opts() + [target]


def run_remote(target, remote_cmd, capture=False, batch=True, tty=False, check=False):
    """Run a shell command string on the remote host over SSH."""
    argv = ssh_argv(target, batch=batch, tty=tty) + [remote_cmd]
    return subprocess.run(argv, text=True, capture_output=capture, check=check)


def remote_home(target):
    """Absolute $HOME on a local or remote target, cached for remote bind mounts."""
    if target is None:
        return os.path.expanduser("~")
    if target not in _remote_home_cache:
        res = run_remote(target, 'printf %s "$HOME"', capture=True, batch=True)
        home = res.stdout.strip() if res.returncode == 0 and res.stdout.strip() else ""
        if not home:
            user = target.split("@")[0] if "@" in target else "root"
            home = "/root" if user == "root" else f"/home/{user}"
        _remote_home_cache[target] = home
    return _remote_home_cache[target]


# Docker helpers
# ============================================================================

# Sentinel to distinguish "no remote passed" from "explicitly local".
_UNSET = object()


def _docker_on(target, args, capture=False):
    """Run a docker command on a specific host (local or remote)."""
    if target:
        remote_cmd = "docker " + " ".join(shlex.quote(a) for a in args)
        argv = ssh_argv(target, batch=True) + [remote_cmd]
    else:
        argv = ["docker"] + args
    return subprocess.run(argv, text=True, capture_output=capture)


def need_docker():
    if REMOTE:
        if not shutil.which("ssh"):
            print("ERROR: `ssh` not found on PATH (needed for --remote).", file=sys.stderr)
            sys.exit(1)
        res = run_remote(REMOTE, "command -v docker >/dev/null 2>&1 && echo ok",
                         capture=True, batch=True)
        if res.returncode != 0:
            print(f"ERROR: cannot reach {REMOTE} over SSH (try `install {REMOTE}`).\n"
                  f"  {res.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
        if res.stdout.strip() != "ok":
            print(f"ERROR: docker not found on {REMOTE} (run `install {REMOTE} --fix`).",
                  file=sys.stderr)
            sys.exit(1)
        return
    if not shutil.which("docker"):
        print("ERROR: `docker` not found on PATH.", file=sys.stderr)
        sys.exit(1)


def docker(args, capture=False, check=False, tty=False):
    """Run a docker command (argv list after 'docker'), locally or over SSH."""
    if REMOTE:
        remote_cmd = "docker " + " ".join(shlex.quote(a) for a in args)
        argv = ssh_argv(REMOTE, batch=True, tty=tty) + [remote_cmd]
    else:
        argv = ["docker"] + args
    return subprocess.run(argv, text=True, check=check, capture_output=capture)


def list_managed(include_all=False, remote=_UNSET, include_stopped=False):
    """Return managed containers (running by default), or all vLLM when requested.

    Return None when the host cannot be queried so callers can distinguish unreachable
    from idle. When remote is omitted, use the global REMOTE; pass None for local only.
    """
    if remote is _UNSET:
        remote = REMOTE
    fmt = "{{json .}}"
    args = ["ps"]
    if include_stopped:
        args.append("-a")
    args += ["--format", fmt]
    if not include_all:
        args += ["--filter", f"label={LABEL_MANAGER}={LABEL_VALUE}"]
    res = _docker_on(remote, args, capture=True)
    if res.returncode != 0:
        print(res.stderr.strip(), file=sys.stderr)
        return None
    rows = []
    for line in res.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if include_all and "vllm" not in (row.get("Image", "").lower()
                                           + " " + row.get("Names", "").lower()):
            # When listing everything, still focus on vllm-ish containers.
            if not str(row.get("Names", "")).startswith(NAME_PREFIX):
                continue
        rows.append(row)
    return rows


def resolve_target(target):
    """Map a config key OR raw container name/id to an actual container name.
    Lists names and matches exactly -- docker's `--filter name=^x$` is unreliable
    because container names are stored with a leading '/' which breaks the anchor."""
    name = container_name(target)
    res = docker(["ps", "-a", "--format", "{{.Names}}"], capture=True)
    if res.returncode == 0:
        names = res.stdout.split()
        if name in names:        # profile key -> otools-vllm-<key>
            return name
        if target in names:      # already a real container name
            return target
    return target                # fall back (raw id, or let docker error clearly)


