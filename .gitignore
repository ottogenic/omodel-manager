# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Downloaded model side-files (regenerated on demand by `fetch` / `launch`)
assets/

# Local tool state / overrides / secrets — do not commit
.otools/
*.local.json
*.bak
.env
hf_token
hosts
wire.json
model_manager.json

# Agent-harness scaffolding — keep the repo tool-agnostic (AGENTS.md is the
# vendor-neutral standard; per-tool instruction files don't belong in the repo)
CLAUDE.md
GEMINI.md
.claude/
.cursor/
.cursorrules
.windsurf/
.aider*
.opencode/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# NOTE: model_manager.json is a LOCAL, git-ignored sandbox (regenerate with
# `config --init`). The committed source of truth for curated profiles is
# DEFAULT_CONFIG in the omodel-manager script. Secrets live outside the repo:
# the HF token in ~/.config/otools/hf_token and the SSH key in
# ~/.ssh/otools_model_manager_ed25519 — neither is in the repo.
